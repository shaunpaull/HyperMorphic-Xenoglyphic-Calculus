def variable_term(name: str) -> Term:
    return Term(kind="var", variable=name)


def operation_term(left: Term, right: Term) -> Term:
    return Term(
        kind="op",
        left=left,
        right=right,
        depth=1 + max(left.depth, right.depth),
        size=1 + left.size + right.size,
    )


def term_code(term: Term) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return f"⋆({term_code(term.left)},{term_code(term.right)})"


def term_display(term: Term, glyph: str) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return (
        f"({term_display(term.left, glyph)} "
        f"{glyph} {term_display(term.right, glyph)})"
    )


def term_lean(
    term: Term,
    *,
    law_name: str,
    variable_map: dict[str, str] | None = None,
) -> str:
    if term.kind == "var":
        assert term.variable is not None
        if variable_map is None:
            return term.variable
        return variable_map[term.variable]

    assert term.left is not None and term.right is not None
    return (
        f"{law_name} "
        f"({term_lean(term.left, law_name=law_name, variable_map=variable_map)}) "
        f"({term_lean(term.right, law_name=law_name, variable_map=variable_map)})"
    )


def term_variables(term: Term) -> frozenset[str]:
    if term.kind == "var":
        assert term.variable is not None
        return frozenset({term.variable})

    assert term.left is not None and term.right is not None
    return term_variables(term.left) | term_variables(term.right)


def rename_term(term: Term, mapping: dict[str, str]) -> Term:
    if term.kind == "var":
        assert term.variable is not None
        return variable_term(mapping[term.variable])

    assert term.left is not None and term.right is not None
    return operation_term(
        rename_term(term.left, mapping),
        rename_term(term.right, mapping),
    )


def canonical_identity_code(lhs: Term, rhs: Term) -> str:
    candidates: list[str] = []

    for renamed_variables in permutations(IDENTITY_VARIABLES):
        mapping = dict(zip(IDENTITY_VARIABLES, renamed_variables, strict=True))
        renamed_lhs = term_code(rename_term(lhs, mapping))
        renamed_rhs = term_code(rename_term(rhs, mapping))
        left_code, right_code = sorted((renamed_lhs, renamed_rhs))
        candidates.append(f"{left_code}={right_code}")

    return min(candidates)


def seed_identity_codes() -> set[str]:
    x, y, z, w = (variable_term(name) for name in IDENTITY_VARIABLES)
    op = operation_term

    seed_pairs = (
        (op(x, y), op(y, x)),
        (op(op(x, y), z), op(x, op(y, z))),
        (op(x, x), x),
        (op(x, op(y, x)), op(op(x, y), x)),
        (op(x, op(x, y)), op(op(x, x), y)),
        (op(op(x, y), y), op(x, op(y, y))),
        (
            op(op(x, y), op(z, w)),
            op(op(x, z), op(y, w)),
        ),
        (
            op(x, op(y, z)),
            op(op(x, y), op(x, z)),
        ),
        (
            op(op(x, y), z),
            op(op(x, z), op(y, z)),
        ),
    )

    return {
        canonical_identity_code(lhs, rhs)
        for lhs, rhs in seed_pairs
    }


def generate_identity_terms(rng: random.Random) -> list[Term]:
    variables = [variable_term(name) for name in IDENTITY_VARIABLES]
    depth_one = [
        operation_term(left, right)
        for left in variables
        for right in variables
    ]

    depth_at_most_one = variables + depth_one
    depth_two = [
        operation_term(left, right)
        for left in depth_at_most_one
        for right in depth_at_most_one
        if max(left.depth, right.depth) == 1
    ]

    terms_by_code = {
        term_code(term): term
        for term in variables + depth_one + depth_two
    }
    depth_at_most_two = list(terms_by_code.values())

    while len(terms_by_code) < IDENTITY_TERM_BUDGET:
        left = rng.choice(depth_at_most_two)
        right = rng.choice(depth_at_most_two)
        if max(left.depth, right.depth) != 2:
            continue

        term = operation_term(left, right)
        terms_by_code.setdefault(term_code(term), term)

    return sorted(
        terms_by_code.values(),
        key=lambda term: (term.depth, term.size, term_code(term)),
    )


def identity_assignments() -> tuple[tuple[int, int, int, int], ...]:
    return tuple(product(range(ORDER), repeat=len(IDENTITY_VARIABLES)))


def term_vector(
    term: Term,
    table: tuple[tuple[int, ...], ...],
    assignments: tuple[tuple[int, int, int, int], ...],
    memo: dict[Term, tuple[int, ...]],
) -> tuple[int, ...]:
    cached = memo.get(term)
    if cached is not None:
        return cached

    if term.kind == "var":
        assert term.variable is not None
        index = IDENTITY_VARIABLES.index(term.variable)
        result = tuple(assignment[index] for assignment in assignments)
    else:
        assert term.left is not None and term.right is not None
        left_vector = term_vector(term.left, table, assignments, memo)
        right_vector = term_vector(term.right, table, assignments, memo)
        result = tuple(
            table[left_value][right_value]
            for left_value, right_value in zip(
                left_vector,
                right_vector,
                strict=True,
            )
        )

    memo[term] = result
    return result


def identity_model_bank(
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    target_table: tuple[tuple[int, ...], ...],
) -> list[tuple[str, tuple[tuple[int, ...], ...]]]:
    bank: list[tuple[str, tuple[tuple[int, ...], ...]]] = []
    seen: set[tuple[int, ...]] = {flatten_table(target_table)}

    def add(source: str, table: tuple[tuple[int, ...], ...]) -> None:
        flattened = flatten_table(table)
        if flattened in seen:
            return
        seen.add(flattened)
        bank.append((source, table))

    for name, table in reference_library().items():
        add(f"reference:{name}", table)

    catalogue_names = sorted(catalogues)
    per_catalogue = max(
        8,
        IDENTITY_MODEL_LIMIT // max(1, len(catalogue_names) + 2),
    )

    for name in catalogue_names:
        entries = sorted(catalogues[name])
        if len(entries) <= per_catalogue:
            selected_entries = entries
        else:
            step = len(entries) / per_catalogue
            selected_entries = [
                entries[min(int(index * step), len(entries) - 1)]
                for index in range(per_catalogue)
            ]

        for entry in selected_entries:
            add(f"catalogue:{name}", unflatten_table(entry))

    automorphism = symmetry_permutation()
    while len(bank) < IDENTITY_MODEL_LIMIT:
        add(
            "random_equivariant_holdout",
            generate_equivariant_table(rng, automorphism),
        )

    return bank[:IDENTITY_MODEL_LIMIT]


def discover_symbolic_identity(
    candidate: StructureCandidate,
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    operation_glyph: UnicodeGlyph,
) -> IdentityDiscovery:
    terms = generate_identity_terms(rng)
    assignments = identity_assignments()
    target_memo: dict[Term, tuple[int, ...]] = {}
    semantic_groups: dict[tuple[int, ...], list[Term]] = {}

    for term in terms:
        vector = term_vector(
            term,
            candidate.table,
            assignments,
            target_memo,
        )
        semantic_groups.setdefault(vector, []).append(term)

    seeded = seed_identity_codes()
    proposed: dict[str, tuple[Term, Term]] = {}

    for group in semantic_groups.values():
        if len(group) < 2:
            continue

        shortest = sorted(
            group,
            key=lambda term: (term.size, term.depth, term_code(term)),
        )[:12]

        for left_index in range(len(shortest)):
            for right_index in range(left_index + 1, len(shortest)):
                lhs = shortest[left_index]
                rhs = shortest[right_index]
                variables = term_variables(lhs) | term_variables(rhs)

                if len(variables) < 3:
                    continue
                if lhs.kind != "op" or rhs.kind != "op":
                    continue
                if max(lhs.depth, rhs.depth) < 3:
                    continue
                if min(lhs.size, rhs.size) < 5:
                    continue
                if lhs.size + rhs.size > 34:
                    continue

                code = canonical_identity_code(lhs, rhs)
                if code in seeded or code in proposed:
                    continue

                proposed[code] = (lhs, rhs)

    if not proposed:
        raise RuntimeError(
            "No non-seeded symbolic identity was discovered. "
            "Increase HXC_IDENTITY_TERM_BUDGET."
        )

    preliminary = sorted(
        proposed.items(),
        key=lambda item: (
            -len(term_variables(item[1][0]) | term_variables(item[1][1])),
            item[1][0].size + item[1][1].size,
            abs(item[1][0].size - item[1][1].size),
            item[0],
        ),
    )[:IDENTITY_PAIR_LIMIT]

    model_bank = identity_model_bank(
        catalogues,
        rng,
        candidate.table,
    )

    participating_terms = {
        term
        for _, (lhs, rhs) in preliminary
        for term in (lhs, rhs)
    }

    satisfaction_counts = [0 for _ in preliminary]
    first_countermodel: list[
        tuple[
            str,
            tuple[tuple[int, ...], ...],
            tuple[int, int, int, int],
        ] | None
    ] = [None for _ in preliminary]

    for source, table in model_bank:
        memo: dict[Term, tuple[int, ...]] = {}
        vectors = {
            term: term_vector(term, table, assignments, memo)
            for term in participating_terms
        }

        for index, (_, (lhs, rhs)) in enumerate(preliminary):
            left_vector = vectors[lhs]
            right_vector = vectors[rhs]

            if left_vector == right_vector:
                satisfaction_counts[index] += 1
                continue

            if first_countermodel[index] is None:
                witness_index = next(
                    position
                    for position, (left_value, right_value) in enumerate(
                        zip(left_vector, right_vector, strict=True)
                    )
                    if left_value != right_value
                )
                first_countermodel[index] = (
                    source,
                    table,
                    assignments[witness_index],
                )

    discoveries: list[IdentityDiscovery] = []

    for index, (code, (lhs, rhs)) in enumerate(preliminary):
        countermodel = first_countermodel[index]
        if countermodel is None:
            continue

        source, countermodel_table, witness = countermodel
        satisfied = satisfaction_counts[index]
        total = len(model_bank)
        failure_rate = 1.0 - (satisfied / total)
        variables = tuple(
            name
            for name in IDENTITY_VARIABLES
            if name in (term_variables(lhs) | term_variables(rhs))
        )

        complexity = lhs.size + rhs.size
        balance = abs(lhs.size - rhs.size)
        score = (
            18.0 * failure_rate
            + 2.5 * len(variables)
            + 0.35 * min(complexity, 30)
            - 0.25 * balance
        )

        discoveries.append(
            IdentityDiscovery(
                lhs=lhs,
                rhs=rhs,
                canonical_code=code,
                display=(
                    f"{term_display(lhs, operation_glyph.symbol)} = "
                    f"{term_display(rhs, operation_glyph.symbol)}"
                ),
                lean_lhs=term_lean(lhs, law_name="alienLaw"),
                lean_rhs=term_lean(rhs, law_name="alienLaw"),
                variables=variables,
                target_term_count=len(terms),
                candidate_pair_count=len(proposed),
                model_bank_satisfied=satisfied,
                model_bank_total=total,
                model_bank_failure_rate=failure_rate,
                countermodel_table=countermodel_table,
                countermodel_source=source,
                counterexample_assignment=witness,
                score=score,
            )
        )

    if not discoveries:
        raise RuntimeError(
            "Every discovered identity also held throughout the comparison "
            "bank. Increase the model bank or term budget."
        )

    return max(
        discoveries,
        key=lambda discovery: (
            discovery.score,
            discovery.model_bank_failure_rate,
            len(discovery.variables),
            -(discovery.lhs.size + discovery.rhs.size),
        ),
    )


# ---------------------------------------------------------------------------
# Finite operation tables and isomorphism
# ---------------------------------------------------------------------------

def operation_from_formula(function) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(function(x, y) % ORDER for y in range(ORDER))
        for x in range(ORDER)
    )


def reference_library() -> dict[str, tuple[tuple[int, ...], ...]]:
    references = {
        "left_projection": operation_from_formula(lambda x, y: x),
        "right_projection": operation_from_formula(lambda x, y: y),
        "constant_zero": operation_from_formula(lambda x, y: 0),
        "modular_addition": operation_from_formula(lambda x, y: x + y),
        "modular_multiplication": operation_from_formula(lambda x, y: x * y),
        "modular_subtraction": operation_from_formula(
            lambda x, y: x + ORDER - y
        ),
        "minimum": operation_from_formula(min),
        "maximum": operation_from_formula(max),
    }
    if ORDER & (ORDER - 1) == 0:
        references["bitwise_xor"] = operation_from_formula(lambda x, y: x ^ y)
    return references


PERMUTATIONS = tuple(permutations(range(ORDER)))


def relabel_table(
    table: tuple[tuple[int, ...], ...],
    permutation: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    inverse = [0] * ORDER
    for old, new in enumerate(permutation):
        inverse[new] = old

    return tuple(
        tuple(
            permutation[
                table[inverse[new_x]][inverse[new_y]]
            ]
            for new_y in range(ORDER)
        )
        for new_x in range(ORDER)
    )


def canonical_form(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return min(
        tuple(value for row in relabel_table(table, permutation) for value in row)
        for permutation in PERMUTATIONS
    )



def flatten_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return tuple(value for row in table for value in row)


def unflatten_table(
    values: tuple[int, ...] | list[int],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(values[row * ORDER + column] for column in range(ORDER))
        for row in range(ORDER)
    )


def transpose_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(table[column][row] for column in range(ORDER))
        for row in range(ORDER)
    )


def _iter_domain_bits(bits: int):
    while bits:
        lowest = bits & -bits
        yield lowest.bit_length() - 1
        bits -= lowest


def _singleton_domain_value(bits: int) -> int | None:
    if bits and bits & (bits - 1) == 0:
        return bits.bit_length() - 1
    return None


def enumerate_right_shelves_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled right shelf for ORDER <= 4.

    Writing R_y(x) = x*y, right self-distributivity becomes

        R_z ∘ R_y = R_{R_z(y)} ∘ R_z.

    The enumerator treats the columns as unary maps and applies finite-domain
    propagation before branching. At order 4 it returns 14,067 labelled
    shelves, which collapse to 720 isomorphism classes.
    """

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete shelf enumeration is supported only through order 4."
        )

    from itertools import product as cartesian_product

    functions = list(cartesian_product(range(ORDER), repeat=ORDER))
    function_index = {
        function: index
        for index, function in enumerate(functions)
    }
    function_count = len(functions)

    composition = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    for outer_index, outer in enumerate(functions):
        for inner_index, inner in enumerate(functions):
            composition[outer_index][inner_index] = function_index[
                tuple(outer[inner[x]] for x in range(ORDER))
            ]

    supports_right = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    supports_left = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]

    for z_function in range(function_count):
        right_groups: dict[int, int] = {}
        left_groups: dict[int, int] = {}

        for candidate_k in range(function_count):
            result = composition[candidate_k][z_function]
            right_groups[result] = (
                right_groups.get(result, 0) | (1 << candidate_k)
            )

        for candidate_y in range(function_count):
            result = composition[z_function][candidate_y]
            left_groups[result] = (
                left_groups.get(result, 0) | (1 << candidate_y)
            )

        for candidate_y in range(function_count):
            supports_right[z_function][candidate_y] = right_groups.get(
                composition[z_function][candidate_y],
                0,
            )

        for candidate_k in range(function_count):
            supports_left[z_function][candidate_k] = left_groups.get(
                composition[candidate_k][z_function],
                0,
            )

    full_domain = (1 << function_count) - 1
    solutions: list[tuple[tuple[int, ...], ...]] = []

    def propagate(domains: tuple[int, ...]) -> tuple[int, ...] | None:
        current = list(domains)
        changed = True

        while changed:
            changed = False

            for z_index, z_domain in enumerate(current):
                z_function = _singleton_domain_value(z_domain)
                if z_function is None:
                    continue

                z_map = functions[z_function]

                for y_index in range(ORDER):
                    k_index = z_map[y_index]
                    y_domain = current[y_index]
                    k_domain = current[k_index]

                    if y_index == k_index:
                        filtered = 0
                        for candidate in _iter_domain_bits(y_domain):
                            if (
                                supports_right[z_function][candidate]
                                >> candidate
                            ) & 1:
                                filtered |= 1 << candidate

                        if filtered == 0:
                            return None
                        if filtered != y_domain:
                            current[y_index] = filtered
                            changed = True
                        continue

                    filtered_y = 0
                    for candidate_y in _iter_domain_bits(y_domain):
                        if (
                            supports_right[z_function][candidate_y]
                            & k_domain
                        ):
                            filtered_y |= 1 << candidate_y

                    if filtered_y == 0:
                        return None

                    filtered_k = 0
                    for candidate_k in _iter_domain_bits(k_domain):
                        if (
                            supports_left[z_function][candidate_k]
                            & filtered_y
                        ):
                            filtered_k |= 1 << candidate_k

                    if filtered_k == 0:
                        return None

                    if filtered_y != y_domain:
                        current[y_index] = filtered_y
                        changed = True
                    if filtered_k != k_domain:
                        current[k_index] = filtered_k
                        changed = True

        return tuple(current)

    def search(domains: tuple[int, ...]) -> None:
        reduced = propagate(domains)
        if reduced is None:
            return

        assigned = [
            _singleton_domain_value(domain)
            for domain in reduced
        ]

        if all(value is not None for value in assigned):
            column_functions = [
                functions[int(value)]
                for value in assigned
            ]
            table = tuple(
                tuple(
                    column_functions[column][row]
                    for column in range(ORDER)
                )
                for row in range(ORDER)
            )
            solutions.append(table)
            return

        branch_index = min(
            (
                index
                for index, domain in enumerate(reduced)
                if _singleton_domain_value(domain) is None
            ),
            key=lambda index: reduced[index].bit_count(),
        )

        for candidate in _iter_domain_bits(reduced[branch_index]):
            branch = list(reduced)
            branch[branch_index] = 1 << candidate
            search(tuple(branch))

    search(tuple(full_domain for _ in range(ORDER)))
    return solutions


def enumerate_quasigroups_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled quasigroup table for ORDER <= 4."""

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete quasigroup enumeration is supported only through order 4."
        )

    row_permutations = tuple(permutations(range(ORDER)))
    results: list[tuple[tuple[int, ...], ...]] = []

    def search_rows(
        selected: list[tuple[int, ...]],
    ) -> None:
        if len(selected) == ORDER:
            results.append(tuple(selected))
            return

        for row in row_permutations:
            if any(
                row[column] in {
                    existing[column]
                    for existing in selected
                }
                for column in range(ORDER)
            ):
                continue
            selected.append(row)
            search_rows(selected)
            selected.pop()

    search_rows([])
    return results


def right_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len({table[x][y] for x in range(ORDER)}) == ORDER
        for y in range(ORDER)
    )


def left_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len(set(table[x])) == ORDER
        for x in range(ORDER)
    )


def right_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[table[x][y]][y] == x
        for x in range(ORDER)
        for y in range(ORDER)
    )


def left_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[x][table[x][y]] == y
        for x in range(ORDER)
        for y in range(ORDER)
    )


def catalogue_sha256(
    catalogue: set[tuple[int, ...]],
) -> str:
    payload = json.dumps(
        [list(entry) for entry in sorted(catalogue)],
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_complete_catalogues() -> tuple[
    dict[str, set[tuple[int, ...]]],
    dict[str, object],
]:
    """Build or load complete order-3/4 shelf and quasigroup catalogues."""

    reference_classes = {
        canonical_form(table)
        for table in reference_library().values()
    }

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        catalogues = {
            "core_references": reference_classes,
        }
        metadata = {
            "complete": False,
            "order": ORDER,
            "scope": (
                "Core references only. Complete shelf/quasigroup catalogue "
                "generation is limited to order <= 4."
            ),
            "counts": {
                name: len(values)
                for name, values in catalogues.items()
            },
            "hashes": {
                name: catalogue_sha256(values)
                for name, values in catalogues.items()
            },
        }
        return catalogues, metadata

    CATALOGUE_CACHE.mkdir(parents=True, exist_ok=True)
    cache_path = CATALOGUE_CACHE / (
        f"hxc_catalogues_v{CATALOGUE_VERSION}_order_{ORDER}.json"
    )

    if cache_path.exists():
        document = json.loads(cache_path.read_text(encoding="utf-8"))
        if (
            document.get("version") == CATALOGUE_VERSION
            and document.get("order") == ORDER
        ):
            catalogues = {
                name: {
                    tuple(int(value) for value in entry)
                    for entry in entries
                }
                for name, entries in document["catalogues"].items()
            }
            return catalogues, document["metadata"]

    labelled_right_shelves = enumerate_right_shelves_complete()

    right_shelves: set[tuple[int, ...]] = set()
    right_spindles: set[tuple[int, ...]] = set()
    right_racks: set[tuple[int, ...]] = set()
    right_quandles: set[tuple[int, ...]] = set()
    right_kei: set[tuple[int, ...]] = set()

    for table in labelled_right_shelves:
        canonical = canonical_form(table)
        right_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = right_translations_bijective(table)

        if idempotent:
            right_spindles.add(canonical)
        if translations_bijective:
            right_racks.add(canonical)
        if idempotent and translations_bijective:
            right_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and right_involutory(table)
        ):
            right_kei.add(canonical)

    labelled_left_shelves = [
        transpose_table(table)
        for table in labelled_right_shelves
    ]

    left_shelves: set[tuple[int, ...]] = set()
    left_spindles: set[tuple[int, ...]] = set()
    left_racks: set[tuple[int, ...]] = set()
    left_quandles: set[tuple[int, ...]] = set()
    left_kei: set[tuple[int, ...]] = set()

    for table in labelled_left_shelves:
        canonical = canonical_form(table)
        left_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = left_translations_bijective(table)

        if idempotent:
            left_spindles.add(canonical)
        if translations_bijective:
            left_racks.add(canonical)
        if idempotent and translations_bijective:
            left_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and left_involutory(table)
        ):
            left_kei.add(canonical)

    quasigroups = {
        canonical_form(table)
        for table in enumerate_quasigroups_complete()
    }

    catalogues = {
        "core_references": reference_classes,
        "right_shelves": right_shelves,
        "left_shelves": left_shelves,
        "right_spindles": right_spindles,
        "left_spindles": left_spindles,
        "right_racks": right_racks,
        "left_racks": left_racks,
        "right_quandles": right_quandles,
        "left_quandles": left_quandles,
        "right_kei": right_kei,
        "left_kei": left_kei,
        "quasigroups": quasigroups,
    }

    metadata = {
        "complete": True,
        "order": ORDER,
        "scope": (
            "Complete up-to-isomorphism catalogues generated in this run for "
            "left/right shelves, spindles, racks, quandles, kei and "
            "quasigroups on the selected carrier order."
        ),
        "labelled_right_shelves": len(labelled_right_shelves),
        "labelled_quasigroups": len(enumerate_quasigroups_complete()),
        "counts": {
            name: len(values)
            for name, values in catalogues.items()
        },
        "hashes": {
            name: catalogue_sha256(values)
            for name, values in catalogues.items()
        },
    }

    cache_document = {
        "version": CATALOGUE_VERSION,
        "order": ORDER,
        "metadata": metadata,
        "catalogues": {
            name: [
                list(entry)
                for entry in sorted(values)
            ]
            for name, values in catalogues.items()
        },
    }
    cache_path.write_text(
        json.dumps(cache_document, indent=2) + "\n",
        encoding="utf-8",
    )

    return catalogues, metadata


def symmetry_permutation() -> tuple[int, ...]:
    # A nontrivial involution. It swaps 0 and 1 and fixes all other elements.
    return tuple([1, 0] + list(range(2, ORDER)))


def generate_equivariant_table(
    rng: random.Random,
    automorphism: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    """Generate an arbitrary table that is equivariant under an involution."""

    table = [[-1 for _ in range(ORDER)] for _ in range(ORDER)]
    fixed_outputs = [
        value
        for value in range(ORDER)
        if automorphism[value] == value
    ]

    # ORDER=3 still has one fixed output; ORDER>=4 has at least two.
    if not fixed_outputs:
        raise RuntimeError("Chosen automorphism has no fixed outputs.")

    for x in range(ORDER):
        for y in range(ORDER):
            if table[x][y] != -1:
                continue

            tx = automorphism[x]
            ty = automorphism[y]

            if (tx, ty) == (x, y):
                value = rng.choice(fixed_outputs)
                table[x][y] = value
            else:
                value = rng.randrange(ORDER)
                table[x][y] = value
                table[tx][ty] = automorphism[value]

    return tuple(tuple(row) for row in table)


# ---------------------------------------------------------------------------
# Law discovery and falsification
# ---------------------------------------------------------------------------

def analyse_properties(
    table: tuple[tuple[int, ...], ...],
) -> dict[str, object]:
    elements = range(ORDER)

    left_bijective = left_translations_bijective(table)
    right_bijective = right_translations_bijective(table)

    properties: dict[str, object] = {
        "commutative": all(
            table[x][y] == table[y][x]
            for x in elements
            for y in elements
        ),
        "associative": all(
            table[table[x][y]][z] == table[x][table[y][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "idempotent": all(
            table[x][x] == x
            for x in elements
        ),
        "flexible": all(
            table[x][table[y][x]] == table[table[x][y]][x]
            for x in elements
            for y in elements
        ),
        "left_alternative": all(
            table[x][table[x][y]] == table[table[x][x]][y]
            for x in elements
            for y in elements
        ),
        "right_alternative": all(
            table[table[x][y]][y] == table[x][table[y][y]]
            for x in elements
            for y in elements
        ),
        "medial": all(
            table[table[x][y]][table[z][w]]
            == table[table[x][z]][table[y][w]]
            for x in elements
            for y in elements
            for z in elements
            for w in elements
        ),
        "left_self_distributive": all(
            table[x][table[y][z]]
            == table[table[x][y]][table[x][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "right_self_distributive": all(
            table[table[x][y]][z]
            == table[table[x][z]][table[y][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "latin": left_bijective and right_bijective,
        "left_translation_bijective": left_bijective,
        "right_translation_bijective": right_bijective,
        "left_involutory": left_involutory(table),
        "right_involutory": right_involutory(table),
        "surjective": (
            len(
                {
                    table[x][y]
                    for x in elements
                    for y in elements
                }
            )
            == ORDER
        ),
    }

    properties["left_identity"] = next(
        (
            identity
            for identity in elements
            if all(table[identity][x] == x for x in elements)
        ),
        None,
    )
    properties["right_identity"] = next(
        (
            identity
            for identity in elements
            if all(table[x][identity] == x for x in elements)
        ),
        None,
    )

    return properties


def classify_structure(
    properties: dict[str, object],
) -> tuple[str, ...]:
    classes = ["magma"]

    associative = bool(properties["associative"])
    commutative = bool(properties["commutative"])
    idempotent = bool(properties["idempotent"])
    left_sd = bool(properties["left_self_distributive"])
    right_sd = bool(properties["right_self_distributive"])
    latin = bool(properties["latin"])
    left_identity = properties["left_identity"] is not None
    right_identity = properties["right_identity"] is not None

    if associative:
        classes.append("semigroup")
    if associative and idempotent:
        classes.append("band")
    if associative and commutative and idempotent:
        classes.append("semilattice")

    if left_sd:
        classes.append("left_shelf")
    if right_sd:
        classes.append("right_shelf")
    if left_sd and right_sd:
        classes.append("bi_shelf")

    if left_sd and idempotent:
        classes.append("left_spindle")
    if right_sd and idempotent:
        classes.append("right_spindle")

    if left_sd and bool(properties["left_translation_bijective"]):
        classes.append("left_rack")
    if right_sd and bool(properties["right_translation_bijective"]):
        classes.append("right_rack")

    if (
        left_sd
        and idempotent
        and bool(properties["left_translation_bijective"])
    ):
        classes.append("left_quandle")
    if (
        right_sd
        and idempotent
        and bool(properties["right_translation_bijective"])
    ):
        classes.append("right_quandle")

    if (
        "left_quandle" in classes
        and bool(properties["left_involutory"])
    ):
        classes.append("left_kei")
    if (
        "right_quandle" in classes
        and bool(properties["right_involutory"])
    ):
        classes.append("right_kei")

    if latin:
        classes.append("quasigroup")
    if latin and left_identity and right_identity:
        classes.append("loop")
    if "loop" in classes and associative:
        classes.append("group")
    if "group" in classes and commutative:
        classes.append("abelian_group")

    if bool(properties["medial"]):
        classes.append("medial_magma")

    return tuple(classes)


def structural_metrics(
    table: tuple[tuple[int, ...], ...],
    references: dict[str, tuple[tuple[int, ...], ...]],
) -> dict[str, object]:
    row_supports = [
        len(set(row))
        for row in table
    ]
    column_supports = [
        len({table[x][y] for x in range(ORDER)})
        for y in range(ORDER)
    ]

    entropy = output_entropy(table)
    max_entropy = math.log2(ORDER)
    normalised_entropy = (
        entropy / max_entropy
        if max_entropy > 0
        else 0.0
    )

    left_projection_distance = sum(
        table[x][y] != x
        for x in range(ORDER)
        for y in range(ORDER)
    ) / (ORDER * ORDER)

    right_projection_distance = sum(
        table[x][y] != y
        for x in range(ORDER)
        for y in range(ORDER)
    ) / (ORDER * ORDER)

    unique_rows = len(set(table))
    unique_columns = len(
        {
            tuple(table[x][y] for x in range(ORDER))
            for y in range(ORDER)
        }
    )

    average_support = (
        sum(row_supports) + sum(column_supports)
    ) / (2 * ORDER * ORDER)

    nearest_reference_name = ""
    nearest_reference_distance = 1.0

    for name, reference in references.items():
        distance = min(
            sum(
                table[x][y] != transformed[x][y]
                for x in range(ORDER)
                for y in range(ORDER)
            ) / (ORDER * ORDER)
            for transformed in (
                relabel_table(reference, permutation)
                for permutation in PERMUTATIONS
            )
        )
        if distance < nearest_reference_distance:
            nearest_reference_distance = distance
            nearest_reference_name = name

    return {
        "row_supports": row_supports,
        "column_supports": column_supports,
        "minimum_row_support": min(row_supports),
        "minimum_column_support": min(column_supports),
        "constant_rows": sum(support == 1 for support in row_supports),
        "constant_columns": sum(
            support == 1
            for support in column_supports
        ),
        "unique_rows": unique_rows,
        "unique_columns": unique_columns,
        "average_support": average_support,
        "entropy_bits": entropy,
        "normalised_entropy": normalised_entropy,
        "left_projection_distance": left_projection_distance,
        "right_projection_distance": right_projection_distance,
        "minimum_projection_distance": min(
            left_projection_distance,
            right_projection_distance,
        ),
        "nearest_reference_name": nearest_reference_name,
        "nearest_reference_distance": nearest_reference_distance,
    }


def passes_nondegeneracy(
    metrics: dict[str, object],
) -> bool:
    return (
        int(metrics["constant_rows"]) == 0
        and int(metrics["constant_columns"]) == 0
        and int(metrics["minimum_row_support"]) >= 2
        and int(metrics["minimum_column_support"]) >= 2
        and int(metrics["unique_rows"]) == ORDER
        and int(metrics["unique_columns"]) == ORDER
        and float(metrics["average_support"]) >= MIN_AVERAGE_SUPPORT
        and float(metrics["normalised_entropy"]) >= MIN_NORMALISED_ENTROPY
        and float(metrics["minimum_projection_distance"])
            >= MIN_PROJECTION_DISTANCE
        and float(metrics["nearest_reference_distance"])
            >= MIN_REFERENCE_DISTANCE
    )



def law_fingerprint(properties: dict[str, object]) -> tuple[object, ...]:
    return (
        *(bool(properties[key]) for key in LAW_KEYS),
        properties["left_identity"] is not None,
        properties["right_identity"] is not None,
    )


def output_entropy(table: tuple[tuple[int, ...], ...]) -> float:
    counts = Counter(value for row in table for value in row)
    total = ORDER * ORDER
    return -sum(
        (count / total) * math.log2(count / total)
        for count in counts.values()
    )


def first_counterexample(
    table: tuple[tuple[int, ...], ...],
    law: str,
) -> tuple[int, ...] | None:
    elements = range(ORDER)

    if law == "commutative":
        for x in elements:
            for y in elements:
                if table[x][y] != table[y][x]:
                    return (x, y)

    if law == "associative":
        for x in elements:
            for y in elements:
                for z in elements:
                    if table[table[x][y]][z] != table[x][table[y][z]]:
                        return (x, y, z)

    if law == "left_alternative":
        for x in elements:
            for y in elements:
                if table[x][table[x][y]] != table[table[x][x]][y]:
                    return (x, y)

    if law == "right_alternative":
        for x in elements:
            for y in elements:
                if table[table[x][y]][y] != table[x][table[y][y]]:
                    return (x, y)

    if law == "medial":
        for x in elements:
            for y in elements:
                for z in elements:
                    for w in elements:
                        if (
                            table[table[x][y]][table[z][w]]
                            != table[table[x][z]][table[y][w]]
                        ):
                            return (x, y, z, w)

    return None


def search_novel_structure(
    rng: random.Random,
    catalogues: dict[str, set[tuple[int, ...]]],
    catalogue_metadata: dict[str, object],
) -> tuple[StructureCandidate, dict[str, object]]:
    automorphism = symmetry_permutation()
    references = reference_library()

    rejection_catalogues = {
        name: values
        for name, values in catalogues.items()
        if name != "core_references"
    }

    seen_classes: set[tuple[int, ...]] = set()
    candidates: list[StructureCandidate] = []
    rejection_counts: Counter[str] = Counter()
    fingerprint_counts: Counter[tuple[object, ...]] = Counter()

    for sample_index in range(SAMPLES):
        table = generate_equivariant_table(rng, automorphism)
        canonical = canonical_form(table)

        if canonical in seen_classes:
            rejection_counts["duplicate_isomorphism_class"] += 1
            continue
        seen_classes.add(canonical)

        memberships = tuple(
            name
            for name, catalogue in catalogues.items()
            if canonical in catalogue
        )

        if memberships:
            for membership in memberships:
                rejection_counts[f"catalogue:{membership}"] += 1
            continue

        properties = analyse_properties(table)
        classifications = classify_structure(properties)
        metrics = structural_metrics(table, references)

        if not bool(properties["surjective"]):
            rejection_counts["not_surjective"] += 1
            continue
        if bool(properties["associative"]):
            rejection_counts["associative"] += 1
            continue
        if not passes_nondegeneracy(metrics):
            rejection_counts["nondegeneracy_gate"] += 1
            continue

        interesting_count = sum(
            bool(properties[key])
            for key in INTERESTING_LAWS
        )
        if interesting_count < 1:
            rejection_counts["no_retained_special_law"] += 1
            continue

        fingerprint = law_fingerprint(properties)
        fingerprint_counts[fingerprint] += 1

        candidates.append(
            StructureCandidate(
                table=table,
                canonical=canonical,
                properties=properties,
                classifications=classifications,
                metrics=metrics,
                fingerprint=fingerprint,
                entropy=float(metrics["entropy_bits"]),
                interesting_law_count=interesting_count,
                sample_index=sample_index,
                catalogue_memberships=(),
                novelty_label=(
                    "outside_complete_generated_order_catalogues"
                    if bool(catalogue_metadata.get("complete"))
                    else "outside_partial_reference_catalogues"
                ),
            )
        )

    if not candidates:
        raise RuntimeError(
            "No candidate passed the strengthened catalogue and "
            "non-degeneracy gates. Increase HXC_SAMPLES or relax an explicit "
            "HXC_MIN_* threshold."
        )

    scored: list[StructureCandidate] = []

    for candidate in candidates:
        properties = candidate.properties
        metrics = candidate.metrics
        exploration_frequency = fingerprint_counts[candidate.fingerprint]

        # Sample frequency is reported for exploration only. It contributes
        # nothing to the mathematical-interest score.
        score = (
            3.0 * candidate.interesting_law_count
            + 8.0 * float(metrics["normalised_entropy"])
            + 10.0 * float(metrics["average_support"])
            + 6.0 * float(metrics["minimum_projection_distance"])
            + 6.0 * float(metrics["nearest_reference_distance"])
            + 1.5 * (not bool(properties["commutative"]))
            + 1.0 * (
                properties["left_identity"] is not None
                or properties["right_identity"] is not None
            )
        )

        scored.append(
            StructureCandidate(
                table=candidate.table,
                canonical=candidate.canonical,
                properties=candidate.properties,
                classifications=candidate.classifications,
                metrics=candidate.metrics,
                fingerprint=candidate.fingerprint,
                entropy=candidate.entropy,
                interesting_law_count=candidate.interesting_law_count,
                sample_index=candidate.sample_index,
                score=score,
                exploration_fingerprint_frequency=exploration_frequency,
                catalogue_memberships=candidate.catalogue_memberships,
                novelty_label=candidate.novelty_label,
            )
        )

    selected = max(
        scored,
        key=lambda candidate: (
            candidate.score,
            float(candidate.metrics["average_support"]),
            float(candidate.metrics["normalised_entropy"]),
            float(candidate.metrics["minimum_projection_distance"]),
            -candidate.sample_index,
        ),
    )

    statistics: dict[str, object] = {
        "samples_requested": SAMPLES,
        "isomorphism_classes_seen": len(seen_classes),
        "qualifying_classes": len(candidates),
        "catalogue_complete": bool(catalogue_metadata.get("complete")),
        "catalogue_scope": catalogue_metadata.get("scope"),
        "catalogue_counts": catalogue_metadata.get("counts", {}),
        "catalogue_hashes": catalogue_metadata.get("hashes", {}),
        "rejection_counts": dict(sorted(rejection_counts.items())),
        "score_uses_sample_rarity": False,
        "historical_novelty_verified": False,
    }
    return selected, statistics


