def lean_named_operation_definition(
    table: tuple[tuple[int, ...], ...],
    name: str,
) -> str:
    def row_expression(x: int) -> str:
        parts: list[str] = []
        for y in range(ORDER - 1):
            parts.append(
                f"if y.val = {y} then mkCarrier {table[x][y]} else "
            )
        parts.append(f"mkCarrier {table[x][ORDER - 1]}")
        return "".join(parts)

    lines = [
        f"def {name} (x y : Carrier) : Carrier :=",
    ]
    for x in range(ORDER - 1):
        lines.append(
            f"  if x.val = {x} then {row_expression(x)}"
        )
        lines.append("  else")
    lines.append(f"    {row_expression(ORDER - 1)}")
    return "\n".join(lines)


def lean_operation_definition(
    table: tuple[tuple[int, ...], ...],
) -> str:
    return lean_named_operation_definition(table, "alienLaw")


def lean_symmetry_definition(
    automorphism: tuple[int, ...],
) -> str:
    lines = ["def alienSymmetry (x : Carrier) : Carrier :="]
    for x in range(ORDER - 1):
        lines.append(
            f"  if x.val = {x} then mkCarrier {automorphism[x]}"
        )
        lines.append("  else")
    lines.append(f"    mkCarrier {automorphism[ORDER - 1]}")
    return "\n".join(lines)


