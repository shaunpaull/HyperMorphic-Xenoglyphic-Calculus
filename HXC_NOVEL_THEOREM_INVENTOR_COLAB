    banner("HXC AI NOVEL STRUCTURE + THEOREM INVENTOR V6")
    print(f"Order:           {ORDER}", flush=True)
    print(f"Seed:            {SEED}", flush=True)
    print(f"Samples:         {SAMPLES:,}", flush=True)
    print(f"Repository root: {ROOT}", flush=True)
    print(
        "Search universe: arbitrary finite binary-operation tables with "
        "isomorphism rejection and proof-carrying law discovery.",
        flush=True,
    )

    rng = random.Random(SEED)

    banner("PHASE 0 - BUILD FILTERED UNICODE REGISTRY")
    unicode_pool = build_unicode_glyph_pool()
    category_counts = {
        category: sum(glyph.category == category for glyph in unicode_pool)
        for category in sorted(UNICODE_SYMBOL_CATEGORIES)
    }
    print(f"Unicode database:    {unicodedata.unidata_version}", flush=True)
    print(f"Code points scanned: {sys.maxunicode + 1:,}", flush=True)
    print(f"Usable symbols:      {len(unicode_pool):,}", flush=True)
    print(f"Category counts:     {category_counts}", flush=True)

    used = set(RESERVED_GLYPHS)
    structure_glyph = select_fresh_glyph(
        unicode_pool,
        rng,
        used,
        ("So", "Sm", "Sk", "Sc"),
    )
    operation_glyph = select_fresh_glyph(
        unicode_pool,
        rng,
        used,
        ("Sm", "So", "Sk", "Sc"),
    )
    symmetry_glyph = select_fresh_glyph(
        unicode_pool,
        rng,
        used,
        ("So", "Sm", "Sk", "Sc"),
    )
    identity_glyph = select_fresh_glyph(
        unicode_pool,
        rng,
        used,
        ("Sm", "So", "Sk", "Sc"),
    )

    banner("PHASE 1 - BUILD COMPLETE SMALL-ORDER CATALOGUES")
    catalogues, catalogue_metadata = build_complete_catalogues()
    print(
        f"Catalogue completeness: {catalogue_metadata['complete']}",
        flush=True,
    )
    for name in sorted(catalogue_metadata["counts"]):
        print(
            f"{name:<22} "
            f"classes={catalogue_metadata['counts'][name]:>5} "
            f"sha256={catalogue_metadata['hashes'][name]}",
            flush=True,
        )

    banner("PHASE 2 - GENERATE, CLASSIFY, AND REJECT KNOWN CLASSES")
    candidate, statistics = search_novel_structure(
        rng,
        catalogues,
        catalogue_metadata,
    )
    print(
        f"Isomorphism classes seen: {statistics['isomorphism_classes_seen']:,}",
        flush=True,
    )
    print(
        f"Qualifying classes:       {statistics['qualifying_classes']:,}",
        flush=True,
    )

    banner("PHASE 3 - SELECT STRUCTURALLY RICH SURVIVOR")
    print(
        f"Structure: {structure_glyph.symbol} "
        f"[{structure_glyph.codepoint}; {structure_glyph.name}]",
        flush=True,
    )
    print(
        f"Operation: {operation_glyph.symbol} "
        f"[{operation_glyph.codepoint}; {operation_glyph.name}]",
        flush=True,
    )
    print(
        f"Symmetry:  {symmetry_glyph.symbol} "
        f"[{symmetry_glyph.codepoint}; {symmetry_glyph.name}]",
        flush=True,
    )
    print(f"Structural score:       {candidate.score:.6f}", flush=True)
    print(
        "Exploration frequency: "
        f"{candidate.exploration_fingerprint_frequency} "
        "(reported only; excluded from score)",
        flush=True,
    )
    print(
        "Classification:         "
        + ", ".join(candidate.classifications),
        flush=True,
    )
    print(
        "Row supports:           "
        + str(candidate.metrics["row_supports"]),
        flush=True,
    )
    print(
        "Column supports:        "
        + str(candidate.metrics["column_supports"]),
        flush=True,
    )
    print(
        "Normalised entropy:     "
        f"{candidate.metrics['normalised_entropy']:.6f}",
        flush=True,
    )
    print(
        "Projection distance:    "
        f"{candidate.metrics['minimum_projection_distance']:.6f}",
        flush=True,
    )
    print(
        "Positive laws: "
        + ", ".join(
            key
            for key in LAW_KEYS
            if bool(candidate.properties[key])
        ),
        flush=True,
    )

    banner("PHASE 4 - CONJECTURE ATTACK")
    for law in ("commutative", "associative", "left_alternative", "medial"):
        if bool(candidate.properties[law]):
            print(f"Retained: {law}", flush=True)
        else:
            witness = first_counterexample(candidate.table, law)
            print(f"Rejected: {law}; witness={witness}", flush=True)

    banner("PHASE 5 - SYNTHESISE A NON-SEEDED IDENTITY")
    identity = discover_symbolic_identity(
        candidate,
        catalogues,
        rng,
        operation_glyph,
    )
    print(
        f"Identity glyph:         {identity_glyph.symbol} "
        f"[{identity_glyph.codepoint}; {identity_glyph.name}]",
        flush=True,
    )
    print(f"Discovered identity:    {identity.display}", flush=True)
    print(
        "Comparison failures:   "
        f"{identity.model_bank_total - identity.model_bank_satisfied}/"
        f"{identity.model_bank_total}",
        flush=True,
    )
    print(
        f"Countermodel source:    {identity.countermodel_source}",
        flush=True,
    )
    print(
        f"Counterexample:         "
        f"{dict(zip(IDENTITY_VARIABLES, identity.counterexample_assignment))}",
        flush=True,
    )

    write_project(
        candidate,
        identity,
        statistics,
        unicode_pool,
        catalogues,
        structure_glyph,
        operation_glyph,
        symmetry_glyph,
        identity_glyph,
    )
    audit()

    if GENERATE_ONLY:
        banner("GENERATION-ONLY MODE COMPLETE")
        print(f"Lean source: {ROOT / 'HXCNovel.lean'}", flush=True)
        print(
            f"Report:      {ROOT / 'NOVEL_STRUCTURE_REPORT.md'}",
            flush=True,
        )
        return

    env = install_or_reuse_lean()
    build(env)

    banner("HXC V6 STRUCTURE + THEOREM: KERNEL VERIFIED")
    print(f"Formal project: {ROOT}", flush=True)
    print(f"Lean source:    {ROOT / 'HXCNovel.lean'}", flush=True)
    print(
        "Lean accepted the structure, generated identity, independent "
        "countermodel, automorphism, counterexamples, and certificates.",
        flush=True,
    )


if __name__ == "__main__":
    main()


