def source_category(label: str) -> str:
    if label.startswith("catalogue:"):
        return label
    if label.startswith("reference:"):
        return "reference"
    if label.startswith("random_"):
        return "random_holdout"
    return label.split(":", 1)[0]


def identity_model_bank(
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    target_table: tuple[tuple[int, ...], ...],
) -> list[tuple[tuple[str, ...], tuple[tuple[int, ...], ...]]]:
    records: dict[tuple[int, ...], dict[str, object]] = {}
    target_flat = flatten_table(target_table)

    def add(label: str, table: tuple[tuple[int, ...], ...]) -> None:
        flattened = flatten_table(table)
        if flattened == target_flat:
            return
        record = records.setdefault(
            flattened,
            {"table": table, "labels": set()},
        )
        labels = record["labels"]
        assert isinstance(labels, set)
        labels.add(label)

    for name, table in reference_library().items():
        add(f"reference:{name}", table)

    catalogue_names = sorted(
        name for name in catalogues
        if name != "core_references"
    )
    per_catalogue = max(
        8,
        IDENTITY_MODEL_LIMIT // max(1, len(catalogue_names) + 2),
    )

    for name in catalogue_names:
        entries = sorted(catalogues[name])
        if len(entries) <= per_catalogue:
            selected_entries = entries
        else:
            step = len(entries) / per_catalogue
            selected_entries = [
                entries[min(int(index * step), len(entries) - 1)]
                for index in range(per_catalogue)
            ]
        for entry in selected_entries:
            add(f"catalogue:{name}", unflatten_table(entry))

    automorphism = symmetry_permutation()
    random_index = 0
    while len(records) < IDENTITY_MODEL_LIMIT:
        random_index += 1
        add(
            f"random_equivariant_holdout:{random_index}",
            generate_equivariant_table(rng, automorphism),
        )

    bank = [
        (tuple(sorted(record["labels"])), record["table"])
        for record in records.values()
    ]
    rng.shuffle(bank)
    return bank[:IDENTITY_MODEL_LIMIT]


def generic_law_holds(
    table: tuple[tuple[int, ...], ...],
    law: str,
) -> bool:
    n = len(table)
    elements = range(n)
    if law == "commutative":
        return all(table[x][y] == table[y][x] for x in elements for y in elements)
    if law == "associative":
        return all(
            table[table[x][y]][z] == table[x][table[y][z]]
            for x in elements for y in elements for z in elements
        )
    if law == "idempotent":
        return all(table[x][x] == x for x in elements)
    if law == "flexible":
        return all(
            table[x][table[y][x]] == table[table[x][y]][x]
            for x in elements for y in elements
        )
    if law == "left_alternative":
        return all(
            table[x][table[x][y]] == table[table[x][x]][y]
            for x in elements for y in elements
        )
    if law == "right_alternative":
        return all(
            table[table[x][y]][y] == table[x][table[y][y]]
            for x in elements for y in elements
        )
    if law == "medial":
        return all(
            table[table[x][y]][table[z][w]] ==
            table[table[x][z]][table[y][w]]
            for x in elements for y in elements
            for z in elements for w in elements
        )
    if law == "left_self_distributive":
        return all(
            table[x][table[y][z]] == table[table[x][y]][table[x][z]]
            for x in elements for y in elements for z in elements
        )
    if law == "right_self_distributive":
        return all(
            table[table[x][y]][z] == table[table[x][z]][table[y][z]]
            for x in elements for y in elements for z in elements
        )
    if law == "latin":
        return (
            all(len(set(table[x])) == n for x in elements)
            and all(len({table[x][y] for x in elements}) == n for y in elements)
        )
    if law == "surjective":
        return len({value for row in table for value in row}) == n
    raise KeyError(f"Unsupported law: {law}")


def enumerate_small_models_satisfying(
    order: int,
    laws: tuple[str, ...],
) -> tuple[tuple[tuple[int, ...], ...], ...]:
    key = (order, laws)
    cached = SMALL_MODEL_CACHE.get(key)
    if cached is not None:
        return cached

    results: list[tuple[tuple[int, ...], ...]] = []
    for flattened in product(range(order), repeat=order * order):
        table = tuple(
            tuple(flattened[row * order + column] for column in range(order))
            for row in range(order)
        )
        if all(generic_law_holds(table, law) for law in laws):
            results.append(table)

    value = tuple(results)
    SMALL_MODEL_CACHE[key] = value
    return value


def generic_identity_assignments(order: int) -> tuple[tuple[int, int, int, int], ...]:
    return tuple(product(range(order), repeat=len(IDENTITY_VARIABLES)))


def identity_counterexample_on_table(
    lhs: Term,
    rhs: Term,
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, int, int, int] | None:
    assignments = generic_identity_assignments(len(table))
    memo: dict[Term, tuple[int, ...]] = {}
    left_vector = term_vector(lhs, table, assignments, memo)
    right_vector = term_vector(rhs, table, assignments, memo)
    for index, (left_value, right_value) in enumerate(zip(left_vector, right_vector, strict=True)):
        if left_value != right_value:
            return assignments[index]
    return None


def find_positive_law_countermodel(
    lhs: Term,
    rhs: Term,
    positive_laws: tuple[str, ...],
) -> tuple[int, tuple[tuple[int, ...], ...], tuple[int, int, int, int]] | None:
    for order in range(2, SMALL_COUNTERMODEL_MAX_ORDER + 1):
        for table in enumerate_small_models_satisfying(order, positive_laws):
            witness = identity_counterexample_on_table(lhs, rhs, table)
            if witness is not None:
                return order, table, witness
    return None



ORDER4_LAW_MODEL_CACHE: dict[
    tuple[str, ...],
    tuple[tuple[tuple[int, ...], ...], ...],
] = {}


def random_table_respecting_easy_laws(
    order: int,
    laws: tuple[str, ...],
    rng: random.Random,
) -> tuple[tuple[int, ...], ...]:
    """Generate a random table while building in cheap syntactic laws.

    This does not assume the harder laws. The finished table is still checked
    against every advertised law before it can enter the witness pool.
    """
    commutative = "commutative" in laws
    idempotent = "idempotent" in laws
    table = [[0 for _ in range(order)] for _ in range(order)]

    if commutative:
        for x in range(order):
            for y in range(x, order):
                value = x if idempotent and x == y else rng.randrange(order)
                table[x][y] = value
                table[y][x] = value
    else:
        for x in range(order):
            for y in range(order):
                table[x][y] = x if idempotent and x == y else rng.randrange(order)

    return tuple(tuple(row) for row in table)


def order4_positive_law_models(
    catalogues: dict[str, set[tuple[int, ...]]],
    positive_laws: tuple[str, ...],
) -> tuple[tuple[tuple[int, ...], ...], ...]:
    """Return all loaded order-4 catalogue/reference models sharing the laws."""
    cached = ORDER4_LAW_MODEL_CACHE.get(positive_laws)
    if cached is not None:
        return cached

    seen: set[tuple[int, ...]] = set()
    models: list[tuple[tuple[int, ...], ...]] = []

    def add(table: tuple[tuple[int, ...], ...]) -> None:
        flattened = flatten_table(table)
        if flattened in seen:
            return
        if all(generic_law_holds(table, law) for law in positive_laws):
            seen.add(flattened)
            models.append(table)

    for table in reference_library().values():
        add(table)

    for name, entries in sorted(catalogues.items()):
        if name == "core_references":
            continue
        for flattened in sorted(entries):
            add(unflatten_table(flattened))

    result = tuple(models)
    ORDER4_LAW_MODEL_CACHE[positive_laws] = result
    return result


def candidate_counterexample_from_models(
    lhs: Term,
    rhs: Term,
    models: list[tuple[int, tuple[tuple[int, ...], ...]]],
) -> tuple[int, tuple[tuple[int, ...], ...], tuple[int, int, int, int]] | None:
    for order, table in models:
        witness = identity_counterexample_on_table(lhs, rhs, table)
        if witness is not None:
            return order, table, witness
    return None


def find_positive_law_countermodel_batch(
    ranked: list[dict[str, object]],
    positive_laws: tuple[str, ...],
    catalogues: dict[str, set[tuple[int, ...]]],
    model_bank: list[tuple[tuple[str, ...], tuple[tuple[int, ...], ...]]],
    rng: random.Random,
    target_table: tuple[tuple[int, ...], ...],
) -> tuple[
    dict[str, object],
    tuple[int, tuple[tuple[int, ...], ...], tuple[int, int, int, int]],
] | None:
    """Select the highest-ranked identity with a concrete law-package model.

    V9 only searched a capped sample of order-3 models. V10 searches in tiers:

    1. every loaded order-4 catalogue/reference model sharing the laws;
    2. every law-sharing model already present in the 480-model bank;
    3. exhaustive order-2 and order-3 models by default, cached by law package;
    4. targeted random order-4 models that syntactically respect easy laws.

    Candidates are considered in score order, so the returned theorem is the
    strongest-ranked candidate for which an actual independence witness exists.
    """
    candidates = ranked[:INDEPENDENCE_CANDIDATE_LIMIT]
    target_flat = flatten_table(target_table)
    seen: set[tuple[int, ...]] = {target_flat}
    common_models: list[tuple[int, tuple[tuple[int, ...], ...]]] = []

    def add(order: int, table: tuple[tuple[int, ...], ...]) -> None:
        flattened = flatten_table(table)
        if flattened in seen:
            return
        if all(generic_law_holds(table, law) for law in positive_laws):
            seen.add(flattened)
            common_models.append((order, table))

    # The most relevant and cheapest witnesses come first.
    for table in order4_positive_law_models(catalogues, positive_laws):
        add(ORDER, table)

    for _, table in model_bank:
        add(len(table), table)

    # A countermodel in a loaded neighbouring family is already sufficient to
    # prove non-implication, so try those before enumerating all order-3 tables.
    for item in candidates:
        lhs = item["lhs"]
        rhs = item["rhs"]
        assert isinstance(lhs, Term) and isinstance(rhs, Term)
        witness = candidate_counterexample_from_models(lhs, rhs, common_models)
        if witness is not None:
            return item, witness

    # Exact finite search. Order 3 has only 3^9 = 19,683 operation tables and
    # the satisfying-model list is cached for repeated positive-law packages.
    exact_models: list[tuple[int, tuple[tuple[int, ...], ...]]] = []
    for order in range(2, SMALL_COUNTERMODEL_MAX_ORDER + 1):
        satisfying = enumerate_small_models_satisfying(order, positive_laws)
        if (
            not EXHAUSTIVE_SMALL_MODEL_SEARCH
            and order >= 3
            and len(satisfying) > SMALL_MODEL_SEARCH_LIMIT
        ):
            satisfying = satisfying[:SMALL_MODEL_SEARCH_LIMIT]
        for table in satisfying:
            add(order, table)
            exact_models.append((order, table))

    # `add` stores into common_models, including the exact additions.
    for item in candidates:
        lhs = item["lhs"]
        rhs = item["rhs"]
        assert isinstance(lhs, Term) and isinstance(rhs, Term)
        witness = candidate_counterexample_from_models(lhs, rhs, common_models)
        if witness is not None:
            return item, witness

    # Final targeted order-4 search. Build in commutativity/idempotence when
    # requested, then verify the complete package before testing identities.
    accepted_random = 0
    random_models: list[tuple[int, tuple[tuple[int, ...], ...]]] = []
    for _ in range(ORDER4_INDEPENDENCE_RANDOM_ATTEMPTS):
        table = random_table_respecting_easy_laws(ORDER, positive_laws, rng)
        flattened = flatten_table(table)
        if flattened in seen:
            continue
        if not all(generic_law_holds(table, law) for law in positive_laws):
            continue
        seen.add(flattened)
        random_models.append((ORDER, table))
        accepted_random += 1
        if accepted_random >= ORDER4_INDEPENDENCE_MODEL_LIMIT:
            break

    for item in candidates:
        lhs = item["lhs"]
        rhs = item["rhs"]
        assert isinstance(lhs, Term) and isinstance(rhs, Term)
        witness = candidate_counterexample_from_models(lhs, rhs, random_models)
        if witness is not None:
            return item, witness

    return None


def table_orbit_distance(
    first: tuple[tuple[int, ...], ...],
    second: tuple[tuple[int, ...], ...],
    include_opposite: bool = True,
) -> float:
    n = len(first)
    if n != ORDER or len(second) != ORDER:
        return 1.0
    variants = [second]
    if include_opposite:
        variants.append(transpose_table(second))
    best = ORDER * ORDER
    for variant in variants:
        for permutation in PERMUTATIONS:
            relabelled = relabel_table(variant, permutation)
            distance = sum(
                first[x][y] != relabelled[x][y]
                for x in range(ORDER) for y in range(ORDER)
            )
            best = min(best, distance)
    return best / (ORDER * ORDER)


def term_operation_count(term: Term) -> int:
    if term.kind == "var":
        return 0
    assert term.left is not None and term.right is not None
    return 1 + term_operation_count(term.left) + term_operation_count(term.right)


def alpha_identity_code(lhs: Term, rhs: Term) -> str:
    def oriented(left: Term, right: Term) -> str:
        mapping: dict[str, str] = {}
        names = "abcdefghijklmnopqrstuvwxyz"
        def encode(term: Term) -> str:
            if term.kind == "var":
                assert term.variable is not None
                if term.variable not in mapping:
                    mapping[term.variable] = names[len(mapping)]
                return mapping[term.variable]
            assert term.left is not None and term.right is not None
            return f"⋆({encode(term.left)},{encode(term.right)})"
        return f"{encode(left)}={encode(right)}"
    return min(oriented(lhs, rhs), oriented(rhs, lhs))


def tokenize_equation(text: str) -> list[str]:
    return re.findall(r"[A-Za-z][A-Za-z0-9_]*|◇|[()=]", text)


def parse_equation_text(text: str) -> tuple[Term, Term]:
    tokens = tokenize_equation(text)
    position = 0

    def parse_atom() -> Term:
        nonlocal position
        if position >= len(tokens):
            raise ValueError("Unexpected end of equation")
        token = tokens[position]
        if token == "(":
            position += 1
            result = parse_expr()
            if position >= len(tokens) or tokens[position] != ")":
                raise ValueError("Missing closing parenthesis")
            position += 1
            return result
        if token in {"◇", ")", "="}:
            raise ValueError(f"Unexpected token {token}")
        position += 1
        return variable_term(token)

    def parse_expr() -> Term:
        nonlocal position
        left = parse_atom()
        if position < len(tokens) and tokens[position] == "◇":
            position += 1
            right = parse_atom()
            return operation_term(left, right)
        return left

    lhs = parse_expr()
    if position >= len(tokens) or tokens[position] != "=":
        raise ValueError("Equation is missing equals sign")
    position += 1
    rhs = parse_expr()
    if position != len(tokens):
        raise ValueError("Unexpected trailing equation tokens")
    return lhs, rhs


def cached_download(url: str, filename: str) -> Path | None:
    NOVELTY_DATABASE_CACHE.mkdir(parents=True, exist_ok=True)
    path = NOVELTY_DATABASE_CACHE / filename
    if path.exists() and path.stat().st_size > 0:
        return path
    if not DOWNLOAD_NOVELTY_DATABASES:
        return None
    try:
        with urllib.request.urlopen(url, timeout=45) as response:
            payload = response.read()
        path.write_bytes(payload)
        return path
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        print(f"Novelty database download failed for {url}: {error}", flush=True)
        return None


def load_equation_databases() -> dict[str, dict[str, object]]:
    sources: list[tuple[str, Path | None, str]] = [
        (
            "ETP_4694_up_to_4_operations",
            cached_download(ETP_EQUATIONS_URL, "etp_equations.txt"),
            ETP_EQUATIONS_URL,
        ),
        (
            "ETP_62576_up_to_5_operations",
            cached_download(ETP_SIZE5_URL, "etp_eq_size5.txt"),
            ETP_SIZE5_URL,
        ),
    ]
    for path in EXTRA_EQUATION_FILES:
        sources.append((f"user:{path.name}", path if path.exists() else None, str(path)))

    databases: dict[str, dict[str, object]] = {}
    for name, path, source in sources:
        if path is None or not path.exists():
            databases[name] = {
                "available": False,
                "source": source,
                "codes": {},
                "equation_count": 0,
                "max_operation_count": None,
                "sha256": None,
                "parse_failures": 0,
            }
            continue

        raw = path.read_bytes()
        code_map: dict[str, dict[str, object]] = {}
        max_operations = 0
        parse_failures = 0
        for line_number, line in enumerate(raw.decode("utf-8").splitlines(), start=1):
            equation = line.strip()
            if not equation:
                continue
            try:
                lhs, rhs = parse_equation_text(equation)
            except ValueError:
                parse_failures += 1
                continue
            code = alpha_identity_code(lhs, rhs)
            operation_count = term_operation_count(lhs) + term_operation_count(rhs)
            max_operations = max(max_operations, operation_count)
            code_map.setdefault(
                code,
                {
                    "line": line_number,
                    "equation": equation,
                    "operation_count": operation_count,
                },
            )

        databases[name] = {
            "available": True,
            "source": source,
            "path": str(path),
            "codes": code_map,
            "equation_count": len(code_map),
            "max_operation_count": max_operations,
            "sha256": hashlib.sha256(raw).hexdigest(),
            "parse_failures": parse_failures,
        }
    return databases


def audit_identity_databases(
    lhs: Term,
    rhs: Term,
    databases: dict[str, dict[str, object]],
) -> tuple[str, tuple[dict[str, object], ...], tuple[dict[str, object], ...], str]:
    code = alpha_identity_code(lhs, rhs)
    operation_count = term_operation_count(lhs) + term_operation_count(rhs)
    matches: list[dict[str, object]] = []
    audit: list[dict[str, object]] = []
    comparable_available = False

    for name, database in databases.items():
        available = bool(database.get("available"))
        max_ops = database.get("max_operation_count")
        in_scope = available and isinstance(max_ops, int) and operation_count <= max_ops
        comparable_available = comparable_available or in_scope
        match = None
        if available:
            codes = database.get("codes", {})
            assert isinstance(codes, dict)
            match = codes.get(code)
        entry = {
            "database": name,
            "available": available,
            "source": database.get("source"),
            "sha256": database.get("sha256"),
            "equation_count": database.get("equation_count"),
            "max_operation_count": max_ops,
            "identity_operation_count": operation_count,
            "within_exact_scope": in_scope,
            "exact_match": match is not None,
            "match": match,
        }
        audit.append(entry)
        if match is not None:
            matches.append(entry)

    if matches:
        status = "exact_match_in_loaded_database"
    elif comparable_available:
        status = "no_exact_match_within_loaded_database_scope"
    elif any(bool(database.get("available")) for database in databases.values()):
        status = "identity_exceeds_loaded_database_size_scope"
    else:
        status = "novelty_databases_unavailable"
    return code, tuple(matches), tuple(audit), status


def audit_final_identity_against_bank(
    lhs: Term,
    rhs: Term,
    candidate: StructureCandidate,
    positive_laws: tuple[str, ...],
    model_bank: list[tuple[tuple[str, ...], tuple[tuple[int, ...], ...]]],
) -> dict[str, object]:
    assignments = identity_assignments()
    category_totals: Counter[str] = Counter()
    category_failures: Counter[str] = Counter()
    exact_source_failures: Counter[str] = Counter()
    nearest: tuple[tuple[int, float, str], tuple[tuple[int, ...], ...], tuple[int, int, int, int]] | None = None
    any_failure: tuple[str, tuple[tuple[int, ...], ...], tuple[int, int, int, int]] | None = None

    for labels, table in model_bank:
        memo: dict[Term, tuple[int, ...]] = {}
        left_vector = term_vector(lhs, table, assignments, memo)
        right_vector = term_vector(rhs, table, assignments, memo)
        witness_index = next(
            (
                index for index, (left_value, right_value) in enumerate(
                    zip(left_vector, right_vector, strict=True)
                ) if left_value != right_value
            ),
            None,
        )
        categories = {source_category(label) for label in labels}
        for category in categories:
            category_totals[category] += 1
        if witness_index is None:
            continue
        witness = assignments[witness_index]
        label = sorted(labels)[0]
        if any_failure is None:
            any_failure = (label, table, witness)
        for category in categories:
            category_failures[category] += 1
        for exact in labels:
            exact_source_failures[exact] += 1

        catalogue_labels = sorted(label for label in labels if label.startswith("catalogue:"))
        if catalogue_labels:
            shared = sum(generic_law_holds(table, law) for law in positive_laws)
            distance = table_orbit_distance(candidate.table, table, include_opposite=True)
            source = catalogue_labels[0]
            ranking = (-shared, distance, source)
            if nearest is None or ranking < nearest[0]:
                nearest = (ranking, table, witness)

    profile = {
        category: {
            "sampled": category_totals[category],
            "failed": category_failures[category],
            "satisfied": category_totals[category] - category_failures[category],
        }
        for category in sorted(category_totals)
    }

    if nearest is not None:
        ranking, table, witness = nearest
        shared = -ranking[0]
        distance = ranking[1]
        source = ranking[2]
    else:
        table = tuple()
        witness = (0, 0, 0, 0)
        shared = 0
        distance = 1.0
        source = "none"

    if any_failure is None:
        any_failure = ("none", candidate.table, (0, 0, 0, 0))

    return {
        "profile": profile,
        "exact_source_failures": dict(sorted(exact_source_failures.items())),
        "catalogue_table": table,
        "catalogue_source": source,
        "catalogue_witness": witness,
        "catalogue_distance": distance,
        "catalogue_shared_positive_laws": shared,
        "any_source": any_failure[0],
        "any_table": any_failure[1],
        "any_witness": any_failure[2],
        "has_catalogue_countermodel": nearest is not None,
    }


def discover_symbolic_identity(
    candidate: StructureCandidate,
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    operation_glyph: UnicodeGlyph,
    equation_databases: dict[str, dict[str, object]],
    excluded_identity_codes: set[str] | None = None,
) -> IdentityDiscovery:
    excluded_identity_codes = excluded_identity_codes or set()
    terms = generate_identity_terms(rng)
    assignments = identity_assignments()
    target_memo: dict[Term, tuple[int, ...]] = {}
    semantic_groups: dict[tuple[int, ...], list[Term]] = {}

    for term in terms:
        vector = term_vector(term, candidate.table, assignments, target_memo)
        semantic_groups.setdefault(vector, []).append(term)

    seeded = seed_identity_codes()
    proposed: dict[str, tuple[Term, Term]] = {}
    for group in semantic_groups.values():
        if len(group) < 2:
            continue
        shortest = sorted(group, key=lambda term: (term.size, term.depth, term_code(term)))[:12]
        for left_index in range(len(shortest)):
            for right_index in range(left_index + 1, len(shortest)):
                lhs = shortest[left_index]
                rhs = shortest[right_index]
                variables = term_variables(lhs) | term_variables(rhs)
                if len(variables) < 3 or lhs.kind != "op" or rhs.kind != "op":
                    continue
                if max(lhs.depth, rhs.depth) < 3 or min(lhs.size, rhs.size) < 5:
                    continue
                if lhs.size + rhs.size > 34:
                    continue
                code = canonical_identity_code(lhs, rhs)
                if code in seeded or code in proposed or code in excluded_identity_codes:
                    continue
                proposed[code] = (lhs, rhs)

    if not proposed:
        raise RuntimeError("No non-seeded symbolic identity was discovered.")

    preliminary = sorted(
        proposed.items(),
        key=lambda item: (
            -len(term_variables(item[1][0]) | term_variables(item[1][1])),
            item[1][0].size + item[1][1].size,
            abs(item[1][0].size - item[1][1].size),
            item[0],
        ),
    )[:IDENTITY_PAIR_LIMIT]

    model_bank = identity_model_bank(catalogues, rng, candidate.table)
    participating_terms = {term for _, pair in preliminary for term in pair}
    satisfaction_counts = [0 for _ in preliminary]
    catalogue_failure_counts = [0 for _ in preliminary]
    random_failure_counts = [0 for _ in preliminary]
    reference_failure_counts = [0 for _ in preliminary]
    catalogue_model_count = sum(
        any(label.startswith("catalogue:") for label in labels)
        for labels, _ in model_bank
    )
    random_model_count = sum(
        any(label.startswith("random_") for label in labels)
        for labels, _ in model_bank
    )
    reference_model_count = sum(
        any(label.startswith("reference:") for label in labels)
        for labels, _ in model_bank
    )

    for labels, table in model_bank:
        memo: dict[Term, tuple[int, ...]] = {}
        vectors = {term: term_vector(term, table, assignments, memo) for term in participating_terms}
        is_catalogue = any(label.startswith("catalogue:") for label in labels)
        is_random = any(label.startswith("random_") for label in labels)
        is_reference = any(label.startswith("reference:") for label in labels)
        for index, (_, (lhs, rhs)) in enumerate(preliminary):
            if vectors[lhs] == vectors[rhs]:
                satisfaction_counts[index] += 1
            else:
                catalogue_failure_counts[index] += int(is_catalogue)
                random_failure_counts[index] += int(is_random)
                reference_failure_counts[index] += int(is_reference)

    positive_laws = tuple(key for key in LAW_KEYS if bool(candidate.properties[key]))
    ranked: list[dict[str, object]] = []
    for index, (code, (lhs, rhs)) in enumerate(preliminary):
        database_code, database_matches, database_audit, database_status = audit_identity_databases(
            lhs, rhs, equation_databases
        )
        if database_matches and REJECT_EXACT_DATABASE_MATCHES:
            continue
        if REQUIRE_CATALOGUE_COUNTERMODEL and catalogue_failure_counts[index] == 0:
            continue
        total = len(model_bank)
        failure_rate = 1.0 - satisfaction_counts[index] / total
        catalogue_rate = catalogue_failure_counts[index] / max(1, catalogue_model_count)
        random_rate = random_failure_counts[index] / max(1, random_model_count)
        reference_rate = reference_failure_counts[index] / max(1, reference_model_count)
        variables = tuple(
            name for name in IDENTITY_VARIABLES
            if name in (term_variables(lhs) | term_variables(rhs))
        )
        complexity = lhs.size + rhs.size
        balance = abs(lhs.size - rhs.size)
        score = (
            12.0 * catalogue_rate
            + 5.0 * random_rate
            + 1.5 * reference_rate
            + 2.5 * len(variables)
            + 0.25 * min(complexity, 30)
            - 0.25 * balance
        )
        ranked.append({
            "lhs": lhs, "rhs": rhs, "code": code,
            "database_code": database_code,
            "database_matches": database_matches,
            "database_audit": database_audit,
            "database_status": database_status,
            "satisfied": satisfaction_counts[index],
            "failure_rate": failure_rate,
            "score": score,
            "variables": variables,
        })

    ranked.sort(key=lambda item: (-float(item["score"]), str(item["code"])))
    if not ranked:
        raise RuntimeError("No identity survived catalogue/database novelty gates.")

    batch_result = find_positive_law_countermodel_batch(
        ranked,
        positive_laws,
        catalogues,
        model_bank,
        rng,
        candidate.table,
    )
    if batch_result is not None:
        selected, independence_result = batch_result
    elif REQUIRE_IDENTITY_INDEPENDENCE:
        raise RuntimeError(
            "No identity had a countermodel satisfying all advertised positive "
            f"laws through order {SMALL_COUNTERMODEL_MAX_ORDER}."
        )
    else:
        selected = ranked[0]
        independence_result = None

    lhs = selected["lhs"]
    rhs = selected["rhs"]
    assert isinstance(lhs, Term) and isinstance(rhs, Term)
    detailed = audit_final_identity_against_bank(
        lhs, rhs, candidate, positive_laws, model_bank
    )
    if REQUIRE_CATALOGUE_COUNTERMODEL and not detailed["has_catalogue_countermodel"]:
        raise RuntimeError("Selected identity lacked a catalogue-neighbour countermodel.")

    if independence_result is None:
        positive_order = 0
        positive_table = tuple()
        positive_witness = (0, 0, 0, 0)
        independence_verified = False
    else:
        positive_order, positive_table, positive_witness = independence_result
        independence_verified = True

    if detailed["has_catalogue_countermodel"]:
        primary_table = detailed["catalogue_table"]
        primary_source = detailed["catalogue_source"]
        primary_witness = detailed["catalogue_witness"]
    else:
        primary_table = detailed["any_table"]
        primary_source = detailed["any_source"]
        primary_witness = detailed["any_witness"]

    database_status = str(selected["database_status"])
    if independence_verified and database_status == "no_exact_match_within_loaded_database_scope":
        novelty_level = "finite_independent_candidate_not_in_loaded_exact_database"
    elif independence_verified and database_status == "identity_exceeds_loaded_database_size_scope":
        novelty_level = "finite_independent_candidate_beyond_loaded_database_scope"
    elif independence_verified:
        novelty_level = "finite_independent_candidate_database_status_uncertain"
    else:
        novelty_level = "candidate_without_small_positive_law_independence_witness"

    return IdentityDiscovery(
        lhs=lhs,
        rhs=rhs,
        canonical_code=str(selected["code"]),
        database_canonical_code=str(selected["database_code"]),
        display=f"{term_display(lhs, operation_glyph.symbol)} = {term_display(rhs, operation_glyph.symbol)}",
        lean_lhs=term_lean(lhs, law_name="alienLaw"),
        lean_rhs=term_lean(rhs, law_name="alienLaw"),
        variables=tuple(selected["variables"]),
        target_term_count=len(terms),
        candidate_pair_count=len(proposed),
        model_bank_satisfied=int(selected["satisfied"]),
        model_bank_total=len(model_bank),
        model_bank_failure_rate=float(selected["failure_rate"]),
        countermodel_table=primary_table,
        countermodel_source=primary_source,
        counterexample_assignment=primary_witness,
        countermodel_category_profile=detailed["profile"],
        catalogue_countermodel_table=detailed["catalogue_table"],
        catalogue_countermodel_source=detailed["catalogue_source"],
        catalogue_counterexample_assignment=detailed["catalogue_witness"],
        catalogue_countermodel_distance=float(detailed["catalogue_distance"]),
        catalogue_countermodel_shared_positive_laws=int(detailed["catalogue_shared_positive_laws"]),
        positive_law_names=positive_laws,
        positive_law_countermodel_table=positive_table,
        positive_law_countermodel_order=positive_order,
        positive_law_counterexample_assignment=positive_witness,
        positive_law_independence_verified=independence_verified,
        database_matches=tuple(selected["database_matches"]),
        database_audit=tuple(selected["database_audit"]),
        database_match_status=database_status,
        novelty_level=novelty_level,
        score=float(selected["score"]),
    )


# ---------------------------------------------------------------------------
# Finite operation tables and isomorphism
# ---------------------------------------------------------------------------

def operation_from_formula(function) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(function(x, y) % ORDER for y in range(ORDER))
        for x in range(ORDER)
    )


def reference_library() -> dict[str, tuple[tuple[int, ...], ...]]:
    references = {
        "left_projection": operation_from_formula(lambda x, y: x),
        "right_projection": operation_from_formula(lambda x, y: y),
        "constant_zero": operation_from_formula(lambda x, y: 0),
        "modular_addition": operation_from_formula(lambda x, y: x + y),
        "modular_multiplication": operation_from_formula(lambda x, y: x * y),
        "modular_subtraction": operation_from_formula(
            lambda x, y: x + ORDER - y
        ),
        "minimum": operation_from_formula(min),
        "maximum": operation_from_formula(max),
    }
    if ORDER & (ORDER - 1) == 0:
        references["bitwise_xor"] = operation_from_formula(lambda x, y: x ^ y)
    return references


PERMUTATIONS = tuple(permutations(range(ORDER)))


def relabel_table(
    table: tuple[tuple[int, ...], ...],
    permutation: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    inverse = [0] * ORDER
    for old, new in enumerate(permutation):
        inverse[new] = old

    return tuple(
        tuple(
            permutation[
                table[inverse[new_x]][inverse[new_y]]
            ]
            for new_y in range(ORDER)
        )
        for new_x in range(ORDER)
    )


def canonical_form(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return min(
        tuple(value for row in relabel_table(table, permutation) for value in row)
        for permutation in PERMUTATIONS
    )


def canonical_form_up_to_opposite(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return min(canonical_form(table), canonical_form(transpose_table(table)))



def flatten_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return tuple(value for row in table for value in row)


def unflatten_table(
    values: tuple[int, ...] | list[int],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(values[row * ORDER + column] for column in range(ORDER))
        for row in range(ORDER)
    )


def transpose_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(table[column][row] for column in range(ORDER))
        for row in range(ORDER)
    )


def _iter_domain_bits(bits: int):
    while bits:
        lowest = bits & -bits
        yield lowest.bit_length() - 1
        bits -= lowest


def _singleton_domain_value(bits: int) -> int | None:
    if bits and bits & (bits - 1) == 0:
        return bits.bit_length() - 1
    return None


def enumerate_right_shelves_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled right shelf for ORDER <= 4.

    Writing R_y(x) = x*y, right self-distributivity becomes

        R_z ∘ R_y = R_{R_z(y)} ∘ R_z.

    The enumerator treats the columns as unary maps and applies finite-domain
    propagation before branching. At order 4 it returns 14,067 labelled
    shelves, which collapse to 720 isomorphism classes.
    """

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete shelf enumeration is supported only through order 4."
        )

    from itertools import product as cartesian_product

    functions = list(cartesian_product(range(ORDER), repeat=ORDER))
    function_index = {
        function: index
        for index, function in enumerate(functions)
    }
    function_count = len(functions)

    composition = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    for outer_index, outer in enumerate(functions):
        for inner_index, inner in enumerate(functions):
            composition[outer_index][inner_index] = function_index[
                tuple(outer[inner[x]] for x in range(ORDER))
            ]

    supports_right = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    supports_left = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]

    for z_function in range(function_count):
        right_groups: dict[int, int] = {}
        left_groups: dict[int, int] = {}

        for candidate_k in range(function_count):
            result = composition[candidate_k][z_function]
            right_groups[result] = (
                right_groups.get(result, 0) | (1 << candidate_k)
            )

        for candidate_y in range(function_count):
            result = composition[z_function][candidate_y]
            left_groups[result] = (
                left_groups.get(result, 0) | (1 << candidate_y)
            )

        for candidate_y in range(function_count):
            supports_right[z_function][candidate_y] = right_groups.get(
                composition[z_function][candidate_y],
                0,
            )

        for candidate_k in range(function_count):
            supports_left[z_function][candidate_k] = left_groups.get(
                composition[candidate_k][z_function],
                0,
            )

    full_domain = (1 << function_count) - 1
    solutions: list[tuple[tuple[int, ...], ...]] = []

    def propagate(domains: tuple[int, ...]) -> tuple[int, ...] | None:
        current = list(domains)
        changed = True

        while changed:
            changed = False

            for z_index, z_domain in enumerate(current):
                z_function = _singleton_domain_value(z_domain)
                if z_function is None:
                    continue

                z_map = functions[z_function]

                for y_index in range(ORDER):
                    k_index = z_map[y_index]
                    y_domain = current[y_index]
                    k_domain = current[k_index]

                    if y_index == k_index:
                        filtered = 0
                        for candidate in _iter_domain_bits(y_domain):
                            if (
                                supports_right[z_function][candidate]
                                >> candidate
                            ) & 1:
                                filtered |= 1 << candidate

                        if filtered == 0:
                            return None
                        if filtered != y_domain:
                            current[y_index] = filtered
                            changed = True
                        continue

                    filtered_y = 0
                    for candidate_y in _iter_domain_bits(y_domain):
                        if (
                            supports_right[z_function][candidate_y]
                            & k_domain
                        ):
                            filtered_y |= 1 << candidate_y

                    if filtered_y == 0:
                        return None

                    filtered_k = 0
                    for candidate_k in _iter_domain_bits(k_domain):
                        if (
                            supports_left[z_function][candidate_k]
                            & filtered_y
                        ):
                            filtered_k |= 1 << candidate_k

                    if filtered_k == 0:
                        return None

                    if filtered_y != y_domain:
                        current[y_index] = filtered_y
                        changed = True
                    if filtered_k != k_domain:
                        current[k_index] = filtered_k
                        changed = True

        return tuple(current)

    def search(domains: tuple[int, ...]) -> None:
        reduced = propagate(domains)
        if reduced is None:
            return

        assigned = [
            _singleton_domain_value(domain)
            for domain in reduced
        ]

        if all(value is not None for value in assigned):
            column_functions = [
                functions[int(value)]
                for value in assigned
            ]
            table = tuple(
                tuple(
                    column_functions[column][row]
                    for column in range(ORDER)
                )
                for row in range(ORDER)
            )
            solutions.append(table)
            return

        branch_index = min(
            (
                index
                for index, domain in enumerate(reduced)
                if _singleton_domain_value(domain) is None
            ),
            key=lambda index: reduced[index].bit_count(),
        )

        for candidate in _iter_domain_bits(reduced[branch_index]):
            branch = list(reduced)
            branch[branch_index] = 1 << candidate
            search(tuple(branch))

    search(tuple(full_domain for _ in range(ORDER)))
    return solutions


def enumerate_quasigroups_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled quasigroup table for ORDER <= 4."""

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete quasigroup enumeration is supported only through order 4."
        )

    row_permutations = tuple(permutations(range(ORDER)))
    results: list[tuple[tuple[int, ...], ...]] = []

    def search_rows(
        selected: list[tuple[int, ...]],
    ) -> None:
        if len(selected) == ORDER:
            results.append(tuple(selected))
            return

        for row in row_permutations:
            if any(
                row[column] in {
                    existing[column]
                    for existing in selected
                }
                for column in range(ORDER)
            ):
                continue
            selected.append(row)
            search_rows(selected)
            selected.pop()

    search_rows([])
    return results


def right_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len({table[x][y] for x in range(ORDER)}) == ORDER
        for y in range(ORDER)
    )


def left_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len(set(table[x])) == ORDER
        for x in range(ORDER)
    )


def right_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[table[x][y]][y] == x
        for x in range(ORDER)
        for y in range(ORDER)
    )


def left_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[x][table[x][y]] == y
        for x in range(ORDER)
        for y in range(ORDER)
    )


def catalogue_sha256(
    catalogue: set[tuple[int, ...]],
) -> str:
    payload = json.dumps(
        [list(entry) for entry in sorted(catalogue)],
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_complete_catalogues() -> tuple[
    dict[str, set[tuple[int, ...]]],
    dict[str, object],
]:
    """Build or load complete order-3/4 shelf and quasigroup catalogues."""

    reference_classes = {
        canonical_form(table)
        for table in reference_library().values()
    }

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        catalogues = {
            "core_references": reference_classes,
        }
        metadata = {
            "complete": False,
            "order": ORDER,
            "scope": (
                "Core references only. Complete shelf/quasigroup catalogue "
                "generation is limited to order <= 4."
            ),
            "counts": {
                name: len(values)
                for name, values in catalogues.items()
            },
            "hashes": {
                name: catalogue_sha256(values)
                for name, values in catalogues.items()
            },
        }
        return catalogues, metadata

    CATALOGUE_CACHE.mkdir(parents=True, exist_ok=True)
    cache_path = CATALOGUE_CACHE / (
        f"hxc_catalogues_v{CATALOGUE_VERSION}_order_{ORDER}.json"
    )

    if cache_path.exists():
        document = json.loads(cache_path.read_text(encoding="utf-8"))
        if (
            document.get("version") == CATALOGUE_VERSION
            and document.get("order") == ORDER
        ):
            catalogues = {
                name: {
                    tuple(int(value) for value in entry)
                    for entry in entries
                }
                for name, entries in document["catalogues"].items()
            }
            return catalogues, document["metadata"]

    labelled_right_shelves = enumerate_right_shelves_complete()

    right_shelves: set[tuple[int, ...]] = set()
    right_spindles: set[tuple[int, ...]] = set()
    right_racks: set[tuple[int, ...]] = set()
    right_quandles: set[tuple[int, ...]] = set()
    right_kei: set[tuple[int, ...]] = set()

    for table in labelled_right_shelves:
        canonical = canonical_form(table)
        right_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = right_translations_bijective(table)

        if idempotent:
            right_spindles.add(canonical)
        if translations_bijective:
            right_racks.add(canonical)
        if idempotent and translations_bijective:
            right_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and right_involutory(table)
        ):
            right_kei.add(canonical)

    labelled_left_shelves = [
        transpose_table(table)
        for table in labelled_right_shelves
    ]

    left_shelves: set[tuple[int, ...]] = set()
    left_spindles: set[tuple[int, ...]] = set()
    left_racks: set[tuple[int, ...]] = set()
    left_quandles: set[tuple[int, ...]] = set()
    left_kei: set[tuple[int, ...]] = set()

    for table in labelled_left_shelves:
        canonical = canonical_form(table)
        left_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = left_translations_bijective(table)

        if idempotent:
            left_spindles.add(canonical)
        if translations_bijective:
            left_racks.add(canonical)
        if idempotent and translations_bijective:
            left_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and left_involutory(table)
        ):
            left_kei.add(canonical)

    quasigroups = {
        canonical_form(table)
        for table in enumerate_quasigroups_complete()
    }

    catalogues = {
        "core_references": reference_classes,
        "right_shelves": right_shelves,
        "left_shelves": left_shelves,
        "right_spindles": right_spindles,
        "left_spindles": left_spindles,
        "right_racks": right_racks,
        "left_racks": left_racks,
        "right_quandles": right_quandles,
        "left_quandles": left_quandles,
        "right_kei": right_kei,
        "left_kei": left_kei,
        "quasigroups": quasigroups,
    }

    metadata = {
        "complete": True,
        "order": ORDER,
        "scope": (
            "Complete up-to-isomorphism catalogues generated in this run for "
            "left/right shelves, spindles, racks, quandles, kei and "
            "quasigroups on the selected carrier order."
        ),
        "labelled_right_shelves": len(labelled_right_shelves),
        "labelled_quasigroups": len(enumerate_quasigroups_complete()),
        "counts": {
            name: len(values)
            for name, values in catalogues.items()
        },
        "hashes": {
            name: catalogue_sha256(values)
            for name, values in catalogues.items()
        },
    }

    cache_document = {
        "version": CATALOGUE_VERSION,
        "order": ORDER,
        "metadata": metadata,
        "catalogues": {
            name: [
                list(entry)
                for entry in sorted(values)
            ]
            for name, values in catalogues.items()
        },
    }
    cache_path.write_text(
        json.dumps(cache_document, indent=2) + "\n",
        encoding="utf-8",
    )

    return catalogues, metadata


def symmetry_permutation() -> tuple[int, ...]:
    # A nontrivial involution. It swaps 0 and 1 and fixes all other elements.
    return tuple([1, 0] + list(range(2, ORDER)))


def generate_equivariant_table(
    rng: random.Random,
    automorphism: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    """Generate an arbitrary table that is equivariant under an involution."""

    table = [[-1 for _ in range(ORDER)] for _ in range(ORDER)]
    fixed_outputs = [
        value
        for value in range(ORDER)
        if automorphism[value] == value
    ]

    # ORDER=3 still has one fixed output; ORDER>=4 has at least two.
    if not fixed_outputs:
        raise RuntimeError("Chosen automorphism has no fixed outputs.")

    for x in range(ORDER):
        for y in range(ORDER):
            if table[x][y] != -1:
                continue

            tx = automorphism[x]
            ty = automorphism[y]

            if (tx, ty) == (x, y):
                value = rng.choice(fixed_outputs)
                table[x][y] = value
            else:
                value = rng.randrange(ORDER)
                table[x][y] = value
                table[tx][ty] = automorphism[value]

    return tuple(tuple(row) for row in table)


