def build_report(
    candidate: StructureCandidate,
    identity: IdentityDiscovery,
    statistics: dict[str, object],
    structure_glyph: UnicodeGlyph,
    operation_glyph: UnicodeGlyph,
    symmetry_glyph: UnicodeGlyph,
    identity_glyph: UnicodeGlyph,
) -> str:
    true_laws = [key for key in LAW_KEYS if bool(candidate.properties[key])]
    false_laws = [key for key in LAW_KEYS if not bool(candidate.properties[key])]
    header = "| " + " | ".join(map(str, range(ORDER))) + " |"
    separator = "|" + "|".join(["---"] * ORDER) + "|"
    rows = "\n".join("| " + " | ".join(map(str, row)) + " |" for row in candidate.table)
    catalogue_counts = statistics.get("catalogue_counts", {})
    catalogue_hashes = statistics.get("catalogue_hashes", {})
    catalogue_lines = "\n".join(
        f"- `{name}`: {catalogue_counts[name]:,} classes; SHA-256 `{catalogue_hashes.get(name, '')}`"
        for name in sorted(catalogue_counts)
    )
    category_lines = "\n".join(
        f"- `{category}`: sampled {values['sampled']}, failed {values['failed']}, satisfied {values['satisfied']}"
        for category, values in identity.countermodel_category_profile.items()
    )
    database_lines = "\n".join(
        f"- `{item['database']}`: available={item['available']}, in-scope={item['within_exact_scope']}, exact-match={item['exact_match']}, max-operations={item['max_operation_count']}, SHA-256=`{item['sha256']}`"
        for item in identity.database_audit
    )
    metrics = candidate.metrics
    return f"""# HXC Novelty-Audited Structure + Theorem Report

