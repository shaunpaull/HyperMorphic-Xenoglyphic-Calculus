def variable_term(name: str) -> Term:
    return Term(kind="var", variable=name)


def operation_term(left: Term, right: Term) -> Term:
    return Term(
        kind="op",
        left=left,
        right=right,
        depth=1 + max(left.depth, right.depth),
        size=1 + left.size + right.size,
    )


def term_code(term: Term) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return f"⋆({term_code(term.left)},{term_code(term.right)})"


def term_display(term: Term, glyph: str) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return (
        f"({term_display(term.left, glyph)} "
        f"{glyph} {term_display(term.right, glyph)})"
    )


def term_lean(
    term: Term,
    *,
    law_name: str,
    variable_map: dict[str, str] | None = None,
) -> str:
    if term.kind == "var":
        assert term.variable is not None
        if variable_map is None:
            return term.variable
        return variable_map[term.variable]

    assert term.left is not None and term.right is not None
    return (
        f"{law_name} "
        f"({term_lean(term.left, law_name=law_name, variable_map=variable_map)}) "
        f"({term_lean(term.right, law_name=law_name, variable_map=variable_map)})"
    )


def term_variables(term: Term) -> frozenset[str]:
    if term.kind == "var":
        assert term.variable is not None
        return frozenset({term.variable})

    assert term.left is not None and term.right is not None
    return term_variables(term.left) | term_variables(term.right)


def rename_term(term: Term, mapping: dict[str, str]) -> Term:
    if term.kind == "var":
        assert term.variable is not None
        return variable_term(mapping[term.variable])

    assert term.left is not None and term.right is not None
    return operation_term(
        rename_term(term.left, mapping),
        rename_term(term.right, mapping),
    )


def canonical_identity_code(lhs: Term, rhs: Term) -> str:
    candidates: list[str] = []

    for renamed_variables in permutations(IDENTITY_VARIABLES):
        mapping = dict(zip(IDENTITY_VARIABLES, renamed_variables, strict=True))
        renamed_lhs = term_code(rename_term(lhs, mapping))
        renamed_rhs = term_code(rename_term(rhs, mapping))
        left_code, right_code = sorted((renamed_lhs, renamed_rhs))
        candidates.append(f"{left_code}={right_code}")

    return min(candidates)


def seed_identity_codes() -> set[str]:
    x, y, z, w = (variable_term(name) for name in IDENTITY_VARIABLES)
    op = operation_term

    seed_pairs = (
        (op(x, y), op(y, x)),
        (op(op(x, y), z), op(x, op(y, z))),
        (op(x, x), x),
        (op(x, op(y, x)), op(op(x, y), x)),
        (op(x, op(x, y)), op(op(x, x), y)),
        (op(op(x, y), y), op(x, op(y, y))),
        (
            op(op(x, y), op(z, w)),
            op(op(x, z), op(y, w)),
        ),
        (
            op(x, op(y, z)),
            op(op(x, y), op(x, z)),
        ),
        (
            op(op(x, y), z),
            op(op(x, z), op(y, z)),
        ),
    )

    return {
        canonical_identity_code(lhs, rhs)
        for lhs, rhs in seed_pairs
    }


def generate_identity_terms(rng: random.Random) -> list[Term]:
    variables = [variable_term(name) for name in IDENTITY_VARIABLES]
    depth_one = [
        operation_term(left, right)
        for left in variables
        for right in variables
    ]

    depth_at_most_one = variables + depth_one
    depth_two = [
        operation_term(left, right)
        for left in depth_at_most_one
        for right in depth_at_most_one
        if max(left.depth, right.depth) == 1
    ]

    terms_by_code = {
        term_code(term): term
        for term in variables + depth_one + depth_two
    }
    depth_at_most_two = list(terms_by_code.values())

    while len(terms_by_code) < IDENTITY_TERM_BUDGET:
        left = rng.choice(depth_at_most_two)
        right = rng.choice(depth_at_most_two)
        if max(left.depth, right.depth) != 2:
            continue

        term = operation_term(left, right)
        terms_by_code.setdefault(term_code(term), term)

    return sorted(
        terms_by_code.values(),
        key=lambda term: (term.depth, term.size, term_code(term)),
    )


def identity_assignments() -> tuple[tuple[int, int, int, int], ...]:
    return tuple(product(range(ORDER), repeat=len(IDENTITY_VARIABLES)))


def term_vector(
    term: Term,
    table: tuple[tuple[int, ...], ...],
    assignments: tuple[tuple[int, int, int, int], ...],
    memo: dict[Term, tuple[int, ...]],
) -> tuple[int, ...]:
    cached = memo.get(term)
    if cached is not None:
        return cached

    if term.kind == "var":
        assert term.variable is not None
        index = IDENTITY_VARIABLES.index(term.variable)
        result = tuple(assignment[index] for assignment in assignments)
    else:
        assert term.left is not None and term.right is not None
        left_vector = term_vector(term.left, table, assignments, memo)
        right_vector = term_vector(term.right, table, assignments, memo)
        result = tuple(
            table[left_value][right_value]
            for left_value, right_value in zip(
                left_vector,
                right_vector,
                strict=True,
            )
        )

    memo[term] = result
    return result


def identity_model_bank(
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    target_table: tuple[tuple[int, ...], ...],
) -> list[tuple[str, tuple[tuple[int, ...], ...]]]:
    bank: list[tuple[str, tuple[tuple[int, ...], ...]]] = []
    seen: set[tuple[int, ...]] = {flatten_table(target_table)}

    def add(source: str, table: tuple[tuple[int, ...], ...]) -> None:
        flattened = flatten_table(table)
        if flattened in seen:
            return
        seen.add(flattened)
        bank.append((source, table))

    for name, table in reference_library().items():
        add(f"reference:{name}", table)

    catalogue_names = sorted(catalogues)
    per_catalogue = max(
        8,
        IDENTITY_MODEL_LIMIT // max(1, len(catalogue_names) + 2),
    )

    for name in catalogue_names:
        entries = sorted(catalogues[name])
        if len(entries) <= per_catalogue:
            selected_entries = entries
        else:
            step = len(entries) / per_catalogue
            selected_entries = [
                entries[min(int(index * step), len(entries) - 1)]
                for index in range(per_catalogue)
            ]

        for entry in selected_entries:
            add(f"catalogue:{name}", unflatten_table(entry))

    automorphism = symmetry_permutation()
    while len(bank) < IDENTITY_MODEL_LIMIT:
        add(
            "random_equivariant_holdout",
            generate_equivariant_table(rng, automorphism),
        )

    return bank[:IDENTITY_MODEL_LIMIT]


def discover_symbolic_identity(
    candidate: StructureCandidate,
    catalogues: dict[str, set[tuple[int, ...]]],
    rng: random.Random,
    operation_glyph: UnicodeGlyph,
    excluded_identity_codes: set[str] | None = None,
) -> IdentityDiscovery:
    excluded_identity_codes = excluded_identity_codes or set()
    terms = generate_identity_terms(rng)
    assignments = identity_assignments()
    target_memo: dict[Term, tuple[int, ...]] = {}
    semantic_groups: dict[tuple[int, ...], list[Term]] = {}

    for term in terms:
        vector = term_vector(
            term,
            candidate.table,
            assignments,
            target_memo,
        )
        semantic_groups.setdefault(vector, []).append(term)

    seeded = seed_identity_codes()
    proposed: dict[str, tuple[Term, Term]] = {}

    for group in semantic_groups.values():
        if len(group) < 2:
            continue

        shortest = sorted(
            group,
            key=lambda term: (term.size, term.depth, term_code(term)),
        )[:12]

        for left_index in range(len(shortest)):
            for right_index in range(left_index + 1, len(shortest)):
                lhs = shortest[left_index]
                rhs = shortest[right_index]
                variables = term_variables(lhs) | term_variables(rhs)

                if len(variables) < 3:
                    continue
                if lhs.kind != "op" or rhs.kind != "op":
                    continue
                if max(lhs.depth, rhs.depth) < 3:
                    continue
                if min(lhs.size, rhs.size) < 5:
                    continue
                if lhs.size + rhs.size > 34:
                    continue

                code = canonical_identity_code(lhs, rhs)
                if (
                    code in seeded
                    or code in proposed
                    or code in excluded_identity_codes
                ):
                    continue

                proposed[code] = (lhs, rhs)

    if not proposed:
        raise RuntimeError(
            "No non-seeded symbolic identity was discovered. "
            "Increase HXC_IDENTITY_TERM_BUDGET."
        )

    preliminary = sorted(
        proposed.items(),
        key=lambda item: (
            -len(term_variables(item[1][0]) | term_variables(item[1][1])),
            item[1][0].size + item[1][1].size,
            abs(item[1][0].size - item[1][1].size),
            item[0],
        ),
    )[:IDENTITY_PAIR_LIMIT]

    model_bank = identity_model_bank(
        catalogues,
        rng,
        candidate.table,
    )

    participating_terms = {
        term
        for _, (lhs, rhs) in preliminary
        for term in (lhs, rhs)
    }

    satisfaction_counts = [0 for _ in preliminary]
    first_countermodel: list[
        tuple[
            str,
            tuple[tuple[int, ...], ...],
            tuple[int, int, int, int],
        ] | None
    ] = [None for _ in preliminary]

    for source, table in model_bank:
        memo: dict[Term, tuple[int, ...]] = {}
        vectors = {
            term: term_vector(term, table, assignments, memo)
            for term in participating_terms
        }

        for index, (_, (lhs, rhs)) in enumerate(preliminary):
            left_vector = vectors[lhs]
            right_vector = vectors[rhs]

            if left_vector == right_vector:
                satisfaction_counts[index] += 1
                continue

            if first_countermodel[index] is None:
                witness_index = next(
                    position
                    for position, (left_value, right_value) in enumerate(
                        zip(left_vector, right_vector, strict=True)
                    )
                    if left_value != right_value
                )
                first_countermodel[index] = (
                    source,
                    table,
                    assignments[witness_index],
                )

    discoveries: list[IdentityDiscovery] = []

    for index, (code, (lhs, rhs)) in enumerate(preliminary):
        countermodel = first_countermodel[index]
        if countermodel is None:
            continue

        source, countermodel_table, witness = countermodel
        satisfied = satisfaction_counts[index]
        total = len(model_bank)
        failure_rate = 1.0 - (satisfied / total)
        variables = tuple(
            name
            for name in IDENTITY_VARIABLES
            if name in (term_variables(lhs) | term_variables(rhs))
        )

        complexity = lhs.size + rhs.size
        balance = abs(lhs.size - rhs.size)
        score = (
            18.0 * failure_rate
            + 2.5 * len(variables)
            + 0.35 * min(complexity, 30)
            - 0.25 * balance
        )

        discoveries.append(
            IdentityDiscovery(
                lhs=lhs,
                rhs=rhs,
                canonical_code=code,
                display=(
                    f"{term_display(lhs, operation_glyph.symbol)} = "
                    f"{term_display(rhs, operation_glyph.symbol)}"
                ),
                lean_lhs=term_lean(lhs, law_name="alienLaw"),
                lean_rhs=term_lean(rhs, law_name="alienLaw"),
                variables=variables,
                target_term_count=len(terms),
                candidate_pair_count=len(proposed),
                model_bank_satisfied=satisfied,
                model_bank_total=total,
                model_bank_failure_rate=failure_rate,
                countermodel_table=countermodel_table,
                countermodel_source=source,
                counterexample_assignment=witness,
                score=score,
            )
        )

    if not discoveries:
        raise RuntimeError(
            "Every discovered identity also held throughout the comparison "
            "bank. Increase the model bank or term budget."
        )

    return max(
        discoveries,
        key=lambda discovery: (
            discovery.score,
            discovery.model_bank_failure_rate,
            len(discovery.variables),
            -(discovery.lhs.size + discovery.rhs.size),
        ),
    )


