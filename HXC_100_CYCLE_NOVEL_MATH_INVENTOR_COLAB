                audit()

                status = "generated"
                if not GENERATE_ONLY and VERIFY_EACH_CYCLE:
                    assert lean_env is not None
                    build(lean_env)
                    status = "verified"

                glyph_map = {
                    "structure": structure_glyph,
                    "operation": operation_glyph,
                    "symmetry": symmetry_glyph,
                    "identity": identity_glyph,
                }
                proof_output = print_cycle_math_and_proofs(
                    cycle_number,
                    candidate,
                    identity,
                    glyph_map,
                    ROOT,
