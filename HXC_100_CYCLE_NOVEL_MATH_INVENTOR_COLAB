def cycle_directory(cycle_number: int) -> Path:
    return RUN_ROOT / f"cycle_{cycle_number:03d}"


def cycle_status_path(cycle_number: int) -> Path:
    return cycle_directory(cycle_number) / "cycle_status.json"


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def load_existing_run_state() -> tuple[
    set[int],
    set[str],
    set[tuple[int, ...]],
    set[str],
    list[dict[str, object]],
    list[dict[str, object]],
]:
    completed_cycles: set[int] = set()
    used_symbols = set(RESERVED_GLYPHS)
    used_canonical: set[tuple[int, ...]] = set()
    used_identity_codes: set[str] = set()
    summaries: list[dict[str, object]] = []
    assignments: list[dict[str, object]] = []

    if not RESUME_RUN or not RUN_ROOT.exists():
        return (
            completed_cycles,
            used_symbols,
            used_canonical,
            used_identity_codes,
            summaries,
            assignments,
        )

    for cycle_path in sorted(RUN_ROOT.glob("cycle_[0-9][0-9][0-9]")):
        status_path = cycle_path / "cycle_status.json"
        record_path = cycle_path / "novel_structure.json"
        if not status_path.exists() or not record_path.exists():
            continue

        try:
            status = json.loads(status_path.read_text(encoding="utf-8"))
            record = json.loads(record_path.read_text(encoding="utf-8"))
        except Exception:
            continue

        if status.get("status") not in {"verified", "generated"}:
            continue

        cycle_number = int(status["cycle"])
        completed_cycles.add(cycle_number)

        canonical = tuple(
            int(value)
            for value in record["candidate"]["canonical_form"]
        )
        used_canonical.add(canonical)
        used_identity_codes.add(
            str(record["discovered_identity"]["canonical_code"])
        )

        for role, glyph in record["glyphs"].items():
            symbol = str(glyph["symbol"])
            used_symbols.add(symbol)
            assignments.append(
                {
                    "cycle": cycle_number,
                    "role": role,
                    **glyph,
                }
            )

        summaries.append(
            {
                "cycle": cycle_number,
                "seed": record["seed"],
                "status": status["status"],
                "glyphs": record["glyphs"],
                "classifications": record["candidate"]["classifications"],
                "positive_laws": [
                    key
                    for key, value in record["candidate"]["properties"].items()
                    if key in LAW_KEYS and bool(value)
                ],
                "operation_table": record["candidate"]["table"],
                "identity": record["discovered_identity"],
                "cycle_directory": str(cycle_path),
            }
        )

    return (
        completed_cycles,
        used_symbols,
        used_canonical,
        used_identity_codes,
        summaries,
        assignments,
    )


def write_shared_assets(
    unicode_pool: list[UnicodeGlyph],
    catalogues: dict[str, set[tuple[int, ...]]],
    catalogue_metadata: dict[str, object],
    assignments: list[dict[str, object]],
) -> None:
    shared = RUN_ROOT / "shared"
    shared.mkdir(parents=True, exist_ok=True)

    assignment_map = {
        item["symbol"]: {
            "cycle": item["cycle"],
            "role": item["role"],
        }
        for item in assignments
    }

    unicode_registry = {
        "unicode_database_version": unicodedata.unidata_version,
        "code_points_scanned": sys.maxunicode + 1,
        "accepted_symbols": len(unicode_pool),
        "assignments": assignments,
        "glyphs": [
            {
                **asdict(glyph),
                "assigned": glyph.symbol in assignment_map,
                "assignment": assignment_map.get(glyph.symbol),
            }
            for glyph in unicode_pool
        ],
    }
    write_json(shared / "unicode_glyph_registry.json", unicode_registry)

    manifest = {
        "order": ORDER,
        "complete": catalogue_metadata.get("complete"),
        "scope": catalogue_metadata.get("scope"),
        "counts": catalogue_metadata.get("counts"),
        "hashes": catalogue_metadata.get("hashes"),
        "historical_novelty_verified": False,
    }
    write_json(shared / "catalogue_manifest.json", manifest)

    catalogue_root = shared / "catalogues"
    catalogue_root.mkdir(parents=True, exist_ok=True)
    for name, catalogue in catalogues.items():
        write_json(
            catalogue_root / f"{name}_order_{ORDER}.json",
            {
                "name": name,
                "order": ORDER,
                "count": len(catalogue),
                "sha256": catalogue_sha256(catalogue),
                "canonical_tables": [
                    list(entry)
                    for entry in sorted(catalogue)
                ],
            },
        )


def extract_lean_declaration(source: str, name: str) -> str:
    lines = source.splitlines()
    start_index = None
    declaration_pattern = re.compile(
        rf"^(?:theorem|def|structure)\s+{re.escape(name)}\b"
    )
    next_declaration = re.compile(
        r"^(?:theorem|def|structure|inductive|abbrev|#check|#eval|end\s)"
    )

    for index, line in enumerate(lines):
        if declaration_pattern.match(line):
            start_index = index
            break

    if start_index is None:
        return f"-- declaration `{name}` not found"

    end_index = len(lines)
    for index in range(start_index + 1, len(lines)):
        if next_declaration.match(lines[index]):
            end_index = index
            break

    return "\n".join(lines[start_index:end_index]).rstrip()


def print_cycle_math_and_proofs(
    cycle_number: int,
    candidate: StructureCandidate,
    identity: IdentityDiscovery,
    glyphs: dict[str, UnicodeGlyph],
    cycle_root: Path,
) -> str:
    lines: list[str] = []

    lines.append("=" * 104)
    lines.append(f"CYCLE {cycle_number:03d} — UNICODE + MATHEMATICS + LEAN PROOFS")
    lines.append("=" * 104)

    for role in ("structure", "operation", "symmetry", "identity"):
        glyph = glyphs[role]
        lines.append(
            f"{role.upper():<10} {glyph.symbol}  "
            f"{glyph.codepoint}  {glyph.name}  [{glyph.category}]"
        )

    lines.append("")
    lines.append("OPERATION TABLE")
    for row in candidate.table:
        lines.append("  " + " ".join(str(value) for value in row))

    positive_laws = [
        key
        for key in LAW_KEYS
        if bool(candidate.properties[key])
    ]
    lines.append("")
    lines.append("POSITIVE LAWS")
    lines.append("  " + ", ".join(positive_laws))
    lines.append("")
    lines.append("DISCOVERED IDENTITY")
    lines.append(f"  {identity.display}")
    lines.append(
        "  comparison failures: "
        f"{identity.model_bank_total - identity.model_bank_satisfied}/"
        f"{identity.model_bank_total}"
    )
    lines.append(f"  countermodel: {identity.countermodel_source}")
    lines.append(
        "  assignment: "
        + str(
            dict(
                zip(
                    IDENTITY_VARIABLES,
                    identity.counterexample_assignment,
                    strict=True,
                )
            )
        )
    )

    lean_source = (cycle_root / "HXCNovel.lean").read_text(encoding="utf-8")
    proof_names = (
        "every_row_depends_on_right_argument",
        "every_column_depends_on_left_argument",
        "alien_not_left_shelf",
        "alien_not_right_shelf",
        "alien_not_quasigroup",
        "discovered_identity_not_in_seed_library",
        "discovered_symbolic_identity",
        "discovered_identity_has_countermodel",
        "alien_not_isomorphic_to_modular_addition",
        "alien_not_isomorphic_to_modular_multiplication",
        "identityDiscoveryCertificate",
        "noveltyCertificate",
    )

    lines.append("")
    lines.append("LEAN PROOF OUTPUT")
    if PRINT_FULL_LEAN:
        lines.append(lean_source)
    else:
        for proof_name in proof_names:
            lines.append("")
            lines.append(extract_lean_declaration(lean_source, proof_name))

    output = "\n".join(lines) + "\n"
    if PRINT_PROOFS:
        print(output, flush=True)

    return output


