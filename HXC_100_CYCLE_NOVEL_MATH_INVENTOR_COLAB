def package_run_results() -> Path:
    archive_path = RUN_ROOT.parent / f"{RUN_ROOT.name}.zip"
    if archive_path.exists():
        archive_path.unlink()

    with zipfile.ZipFile(
        archive_path,
        "w",
        compression=zipfile.ZIP_DEFLATED,
    ) as archive:
        for path in sorted(RUN_ROOT.rglob("*")):
            if path.is_file():
                archive.write(path, path.relative_to(RUN_ROOT.parent))

    return archive_path


def summary_from_record(
    cycle_number: int,
    status: str,
    cycle_root: Path,
) -> dict[str, object]:
    record = json.loads(
        (cycle_root / "novel_structure.json").read_text(encoding="utf-8")
    )
    return {
        "cycle": cycle_number,
        "seed": record["seed"],
        "status": status,
        "glyphs": record["glyphs"],
        "classifications": record["candidate"]["classifications"],
        "positive_laws": [
            key
            for key, value in record["candidate"]["properties"].items()
            if key in LAW_KEYS and bool(value)
        ],
        "operation_table": record["candidate"]["table"],
        "identity": record["discovered_identity"],
        "cycle_directory": str(cycle_root),
    }


def main() -> None:
    global ROOT, SEED

    banner("HXC 100-CYCLE NOVEL STRUCTURE + THEOREM INVENTOR V7")
    print(f"Cycles requested:       {CYCLES}", flush=True)
    print(f"Order:                  {ORDER}", flush=True)
    print(f"Base seed:              {BASE_SEED}", flush=True)
    print(f"Samples per cycle:      {SAMPLES:,}", flush=True)
    print(f"Identity terms/cycle:   {IDENTITY_TERM_BUDGET:,}", flush=True)
    print(f"Comparison models:      {IDENTITY_MODEL_LIMIT:,}", flush=True)
    print(f"Verify every cycle:     {VERIFY_EACH_CYCLE and not GENERATE_ONLY}", flush=True)
    print(f"Resume enabled:         {RESUME_RUN}", flush=True)
    print(f"Run root:               {RUN_ROOT}", flush=True)

    if RUN_ROOT.exists() and not RESUME_RUN:
        shutil.rmtree(RUN_ROOT)
    RUN_ROOT.mkdir(parents=True, exist_ok=True)

    (
        completed_cycles,
        used_symbols,
        used_canonical,
        used_identity_codes,
        summaries,
        assignments,
    ) = load_existing_run_state()

    banner("SHARED PHASE A — FILTERED UNICODE REGISTRY")
    unicode_pool = build_unicode_glyph_pool()
    category_counts = {
        category: sum(glyph.category == category for glyph in unicode_pool)
        for category in sorted(UNICODE_SYMBOL_CATEGORIES)
    }
    print(f"Unicode database:       {unicodedata.unidata_version}", flush=True)
    print(f"Code points scanned:    {sys.maxunicode + 1:,}", flush=True)
    print(f"Usable symbols:         {len(unicode_pool):,}", flush=True)
    print(f"Category counts:        {category_counts}", flush=True)

    banner("SHARED PHASE B — COMPLETE SMALL-ORDER CATALOGUES")
    catalogues, catalogue_metadata = build_complete_catalogues()
    print(
        f"Catalogue completeness: {catalogue_metadata['complete']}",
        flush=True,
    )
    for name in sorted(catalogue_metadata["counts"]):
        print(
            f"{name:<22} "
            f"classes={catalogue_metadata['counts'][name]:>5} "
            f"sha256={catalogue_metadata['hashes'][name]}",
            flush=True,
        )

    write_shared_assets(
        unicode_pool,
        catalogues,
        catalogue_metadata,
        assignments,
    )

    lean_env = None
    if not GENERATE_ONLY and VERIFY_EACH_CYCLE:
        banner("SHARED PHASE C — INSTALL OR REUSE LEAN")
        lean_env = install_or_reuse_lean()

    proof_outputs: list[str] = []
    failures: list[dict[str, object]] = []

    # Reload proof outputs for resumed cycles so the aggregate remains complete.
    for cycle_number in sorted(completed_cycles):
        proof_path = cycle_directory(cycle_number) / "LEAN_PROOF_OUTPUT.txt"
        if proof_path.exists():
            proof_outputs.append(proof_path.read_text(encoding="utf-8"))

    for cycle_number in range(1, CYCLES + 1):
        if cycle_number in completed_cycles:
            banner(f"CYCLE {cycle_number:03d}/{CYCLES:03d} — RESUMED/SKIPPED")
            print(
                f"Existing successful output: {cycle_directory(cycle_number)}",
                flush=True,
            )
            continue

        success = False
        last_error = ""

        for attempt in range(1, MAX_CYCLE_RETRIES + 1):
            cycle_seed = (
                BASE_SEED
                + cycle_number
                - 1
                + (attempt - 1) * CYCLE_SEED_STRIDE
            )
            SEED = cycle_seed
            ROOT = cycle_directory(cycle_number)

            if ROOT.exists():
                shutil.rmtree(ROOT)

            trial_used_symbols = set(used_symbols)
            rng = random.Random(cycle_seed)

            banner(
                f"CYCLE {cycle_number:03d}/{CYCLES:03d} "
                f"— ATTEMPT {attempt}/{MAX_CYCLE_RETRIES} "
                f"— SEED {cycle_seed}"
            )

            try:
                structure_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("So", "Sm", "Sk", "Sc"),
                )
                operation_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("Sm", "So", "Sk", "Sc"),
                )
                symmetry_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("So", "Sm", "Sk", "Sc"),
                )
                identity_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("Sm", "So", "Sk", "Sc"),
                )

                candidate, statistics = search_novel_structure(
                    rng,
                    catalogues,
                    catalogue_metadata,
                    excluded_canonical=used_canonical,
                )

                identity = discover_symbolic_identity(
                    candidate,
                    catalogues,
                    rng,
                    operation_glyph,
                    excluded_identity_codes=used_identity_codes,
                )

                print(
                    f"Unicode: {structure_glyph.symbol} "
                    f"{operation_glyph.symbol} {symmetry_glyph.symbol} "
                    f"{identity_glyph.symbol}",
                    flush=True,
                )
                print(
                    "Glyph metadata:",
                    flush=True,
                )
                for role, glyph in (
                    ("structure", structure_glyph),
                    ("operation", operation_glyph),
                    ("symmetry", symmetry_glyph),
                    ("identity", identity_glyph),
                ):
                    print(
                        f"  {role:<10} {glyph.symbol} "
                        f"{glyph.codepoint} {glyph.name} "
                        f"[{glyph.category}]",
                        flush=True,
                    )

                print("Operation table:", flush=True)
                for row in candidate.table:
                    print("  " + " ".join(map(str, row)), flush=True)

                print(
                    "Positive laws: "
                    + ", ".join(
                        key
                        for key in LAW_KEYS
                        if bool(candidate.properties[key])
                    ),
                    flush=True,
                )
                print(f"Discovered identity: {identity.display}", flush=True)
                print(
                    "Comparison failures: "
                    f"{identity.model_bank_total - identity.model_bank_satisfied}/"
                    f"{identity.model_bank_total}",
                    flush=True,
                )
                print(
                    f"Countermodel: {identity.countermodel_source}",
                    flush=True,
                )

                write_project(
                    candidate,
                    identity,
                    statistics,
                    unicode_pool,
                    catalogues,
                    structure_glyph,
                    operation_glyph,
                    symmetry_glyph,
                    identity_glyph,
                    include_shared_assets=False,
                )
                audit()

                status = "generated"
                if not GENERATE_ONLY and VERIFY_EACH_CYCLE:
                    assert lean_env is not None
                    build(lean_env)
                    status = "verified"

                glyph_map = {
                    "structure": structure_glyph,
                    "operation": operation_glyph,
                    "symmetry": symmetry_glyph,
                    "identity": identity_glyph,
                }
                proof_output = print_cycle_math_and_proofs(
                    cycle_number,
                    candidate,
                    identity,
                    glyph_map,
                    ROOT,
                )
                (ROOT / "LEAN_PROOF_OUTPUT.txt").write_text(
                    proof_output,
                    encoding="utf-8",
                )

                cycle_status = {
                    "cycle": cycle_number,
                    "attempt": attempt,
                    "seed": cycle_seed,
                    "status": status,
                    "verified": status == "verified",
                    "structure_canonical_sha256": hashlib.sha256(
                        json.dumps(
                            list(candidate.canonical),
                            separators=(",", ":"),
                        ).encode("utf-8")
                    ).hexdigest(),
                    "identity_code": identity.canonical_code,
                    "identity_code_sha256": hashlib.sha256(
                        identity.canonical_code.encode("utf-8")
                    ).hexdigest(),
                    "historical_novelty_verified": False,
                }
                write_json(ROOT / "cycle_status.json", cycle_status)

                used_symbols = trial_used_symbols
                used_canonical.add(candidate.canonical)
                used_identity_codes.add(identity.canonical_code)
                completed_cycles.add(cycle_number)
                proof_outputs.append(proof_output)

                for role, glyph in glyph_map.items():
                    assignments.append(
                        {
                            "cycle": cycle_number,
                            "role": role,
                            **asdict(glyph),
                        }
                    )

                summary = summary_from_record(
                    cycle_number,
                    status,
                    ROOT,
                )
                summaries = [
                    item
                    for item in summaries
                    if int(item["cycle"]) != cycle_number
                ]
                summaries.append(summary)

                write_shared_assets(
                    unicode_pool,
                    catalogues,
                    catalogue_metadata,
                    assignments,
                )
                update_aggregate_outputs(
                    summaries,
                    proof_outputs,
                    failures,
                    catalogue_metadata,
                )

                banner(
                    f"CYCLE {cycle_number:03d}/{CYCLES:03d} "
                    f"— {status.upper()}"
                )
                print(
                    f"Saved: {ROOT}",
                    flush=True,
                )
                success = True
                break

            except Exception as error:
                last_error = f"{type(error).__name__}: {error}"
                banner(
                    f"CYCLE {cycle_number:03d} ATTEMPT {attempt} FAILED"
                )
                print(last_error, flush=True)
                write_json(
                    ROOT / "cycle_status.json",
                    {
                        "cycle": cycle_number,
                        "attempt": attempt,
                        "seed": cycle_seed,
                        "status": "failed_attempt",
                        "error": last_error,
                    },
                )

        if not success:
            failure = {
                "cycle": cycle_number,
                "status": "failed",
                "attempts": MAX_CYCLE_RETRIES,
                "last_error": last_error,
            }
            failures.append(failure)
            update_aggregate_outputs(
                summaries,
                proof_outputs,
                failures,
