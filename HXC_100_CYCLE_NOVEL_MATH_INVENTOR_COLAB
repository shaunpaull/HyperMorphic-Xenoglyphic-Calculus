        )
    else:
        blocks.append(
            """theorem alien_has_no_left_identity :
    ¬ ∃ identity : Carrier, ∀ x : Carrier, alienLaw identity x = x := by
  decide
"""
        )

    if right_identity is not None:
        blocks.append(
            f"""def alienRightIdentity : Carrier := mkCarrier {right_identity}

theorem alien_right_identity :
    ∀ x : Carrier, alienLaw x alienRightIdentity = x := by
  decide
"""
        )
    else:
        blocks.append(
            """theorem alien_has_no_right_identity :
    ¬ ∃ identity : Carrier, ∀ x : Carrier, alienLaw x identity = x := by
  decide
"""
        )

    return "\n".join(blocks)


def lean_counterexample_theorems(
    table: tuple[tuple[int, ...], ...],
    properties: dict[str, object],
) -> str:
    blocks: list[str] = []

    if not bool(properties["commutative"]):
        witness = first_counterexample(table, "commutative")
        assert witness is not None
        x, y = witness
        blocks.append(
            f"""theorem rejected_commutativity :
    alienLaw (mkCarrier {x}) (mkCarrier {y}) ≠
    alienLaw (mkCarrier {y}) (mkCarrier {x}) := by
  decide
"""
        )

    if not bool(properties["associative"]):
        witness = first_counterexample(table, "associative")
        assert witness is not None
        x, y, z = witness
        blocks.append(
            f"""theorem rejected_associativity :
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {y}))
      (mkCarrier {z}) ≠
    alienLaw
      (mkCarrier {x})
      (alienLaw (mkCarrier {y}) (mkCarrier {z})) := by
  decide
"""
        )

    if not bool(properties["left_alternative"]):
        witness = first_counterexample(table, "left_alternative")
        if witness is not None:
            x, y = witness
            blocks.append(
                f"""theorem rejected_left_alternative :
    alienLaw
      (mkCarrier {x})
      (alienLaw (mkCarrier {x}) (mkCarrier {y})) ≠
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {x}))
      (mkCarrier {y}) := by
  decide
"""
            )

    if not bool(properties["medial"]):
        witness = first_counterexample(table, "medial")
        if witness is not None:
            x, y, z, w = witness
            blocks.append(
                f"""theorem rejected_mediality :
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {y}))
      (alienLaw (mkCarrier {z}) (mkCarrier {w})) ≠
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {z}))
      (alienLaw (mkCarrier {y}) (mkCarrier {w})) := by
  decide
"""
            )

    return "\n".join(blocks)


def reference_definitions() -> str:
    return """def leftProjection (x _ : Carrier) : Carrier := x
def rightProjection (_ y : Carrier) : Carrier := y
def constantZero (_ _ : Carrier) : Carrier := mkCarrier 0
def modularAddition (x y : Carrier) : Carrier := mkCarrier (x.val + y.val)
def modularMultiplication (x y : Carrier) : Carrier := mkCarrier (x.val * y.val)
def modularSubtraction (x y : Carrier) : Carrier :=
  mkCarrier (x.val + order - y.val)
def minimumLaw (x y : Carrier) : Carrier := mkCarrier (min x.val y.val)
def maximumLaw (x y : Carrier) : Carrier := mkCarrier (max x.val y.val)
"""



def lean_relabeling_universe() -> str:
    """Generate every carrier permutation as an explicit Lean constructor.

    This avoids asking Lean to synthesize decidability for an existential over
    arbitrary functions. The resulting checker ranges over exactly ORDER!
    generated relabellings.
    """

    permutations_list = list(PERMUTATIONS)
    constructor_names = [f"p{index}" for index in range(len(permutations_list))]

    inductive_lines = [
        "inductive Relabeling where",
        *[f"  | {name}" for name in constructor_names],
        "deriving DecidableEq, Repr",
        "",
    ]

    def carrier_expression(permutation: tuple[int, ...]) -> str:
        pieces: list[str] = []
        for source_value in range(ORDER - 1):
            pieces.append(
                f"if x.val = {source_value} then "
                f"mkCarrier {permutation[source_value]} else "
            )
        pieces.append(f"mkCarrier {permutation[ORDER - 1]}")
        return "".join(pieces)

    apply_lines = [
        "def applyRelabeling : Relabeling → Carrier → Carrier",
    ]
    for name, permutation in zip(
        constructor_names,
        permutations_list,
        strict=True,
    ):
        apply_lines.append(
            f"  | .{name}, x => {carrier_expression(permutation)}"
        )
    apply_lines.append("")

    registry_items = ", ".join(f".{name}" for name in constructor_names)
    registry_lines = [
        "def allRelabelings : List Relabeling :=",
        f"  [{registry_items}]",
        "",
        "def relabelingInjective (relabel : Relabeling) : Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          if applyRelabeling relabel (mkCarrier x) ==",
        "              applyRelabeling relabel (mkCarrier y) then",
        "            x == y",
        "          else",
        "            true))",
        "",
        "theorem relabeling_registry_size :",
        f"    allRelabelings.length = {len(permutations_list)} := by",
        "  decide",
        "",
        "theorem relabeling_registry_nodup :",
        "    allRelabelings.Nodup := by",
        "  decide",
        "",
        "theorem every_registered_relabeling_is_injective :",
        "    allRelabelings.all relabelingInjective = true := by",
        "  decide",
        "",
        "def preservesOperation",
        "    (relabel : Relabeling)",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          applyRelabeling relabel",
        "              (first (mkCarrier x) (mkCarrier y)) ==",
        "            second",
        "              (applyRelabeling relabel (mkCarrier x))",
        "              (applyRelabeling relabel (mkCarrier y))))",
        "",
        "def isomorphicBool",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  allRelabelings.any",
        "    (fun relabel => preservesOperation relabel first second)",
        "",
        "/--",
        "Finite isomorphism over the explicitly generated complete permutation",
        "registry. The Python generator emits every permutation of the carrier;",
        "Lean verifies the registry size, absence of duplicates, injectivity of",
        "every entry, and every operation-preservation check.",
        "-/",
        "def IsIsomorphic",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Prop :=",
        "  isomorphicBool first second = true",
        "",
    ]

    return "\n".join(inductive_lines + apply_lines + registry_lines)



def lean_operation_for_custom_carrier(
    table: tuple[tuple[int, ...], ...],
    name: str,
    carrier_name: str,
    maker_name: str,
) -> str:
    order = len(table)
    def row_expression(x: int) -> str:
        parts: list[str] = []
        for y in range(order - 1):
            parts.append(
                f"if y.val = {y} then {maker_name} {table[x][y]} else "
            )
        parts.append(f"{maker_name} {table[x][order - 1]}")
        return "".join(parts)
    lines = [f"def {name} (x y : {carrier_name}) : {carrier_name} :="]
    for x in range(order - 1):
        lines.append(f"  if x.val = {x} then {row_expression(x)}")
        lines.append("  else")
    lines.append(f"    {row_expression(order - 1)}")
    return "\n".join(lines)


def positive_law_package_expression(laws: tuple[str, ...]) -> str:
    formulas = {
        "commutative": "∀ x y, law x y = law y x",
        "associative": "∀ x y z, law (law x y) z = law x (law y z)",
        "idempotent": "∀ x, law x x = x",
        "flexible": "∀ x y, law x (law y x) = law (law x y) x",
        "left_alternative": "∀ x y, law x (law x y) = law (law x x) y",
        "right_alternative": "∀ x y, law (law x y) y = law x (law y y)",
        "medial": "∀ x y z w, law (law x y) (law z w) = law (law x z) (law y w)",
        "left_self_distributive": "∀ x y z, law x (law y z) = law (law x y) (law x z)",
        "right_self_distributive": "∀ x y z, law (law x y) z = law (law x z) (law y z)",
        "surjective": "∀ target, ∃ x y, law x y = target",
    }
    selected = [f"({formulas[law]})" for law in laws if law in formulas]
    return " ∧\n  ".join(selected) if selected else "True"


def lean_positive_law_component_proofs(laws: tuple[str, ...]) -> tuple[str, str]:
    """Emit one direct finite theorem per advertised law.

    Lean can decide each concrete finite law directly, but it may not unfold a
    user-defined conjunction package while synthesising a Decidable instance.
    We therefore prove each component separately and assemble the conjunction
    explicitly, avoiding `decide` on `PositiveLawPackage ...` itself.
    """

    statements = {
        "commutative": """theorem positive_countermodel_commutative :
    ∀ x y : PositiveCounterCarrier,
      positiveLawCounterLaw x y = positiveLawCounterLaw y x := by
  decide
""",
        "associative": """theorem positive_countermodel_associative :
    ∀ x y z : PositiveCounterCarrier,
      positiveLawCounterLaw (positiveLawCounterLaw x y) z =
      positiveLawCounterLaw x (positiveLawCounterLaw y z) := by
  decide
""",
        "idempotent": """theorem positive_countermodel_idempotent :
    ∀ x : PositiveCounterCarrier,
      positiveLawCounterLaw x x = x := by
  decide
""",
        "flexible": """theorem positive_countermodel_flexible :
    ∀ x y : PositiveCounterCarrier,
      positiveLawCounterLaw x (positiveLawCounterLaw y x) =
      positiveLawCounterLaw (positiveLawCounterLaw x y) x := by
  decide
""",
        "left_alternative": """theorem positive_countermodel_left_alternative :
    ∀ x y : PositiveCounterCarrier,
      positiveLawCounterLaw x (positiveLawCounterLaw x y) =
      positiveLawCounterLaw (positiveLawCounterLaw x x) y := by
  decide
""",
        "right_alternative": """theorem positive_countermodel_right_alternative :
    ∀ x y : PositiveCounterCarrier,
      positiveLawCounterLaw (positiveLawCounterLaw x y) y =
      positiveLawCounterLaw x (positiveLawCounterLaw y y) := by
  decide
""",
        "medial": """theorem positive_countermodel_medial :
    ∀ x y z w : PositiveCounterCarrier,
      positiveLawCounterLaw
        (positiveLawCounterLaw x y)
        (positiveLawCounterLaw z w) =
      positiveLawCounterLaw
        (positiveLawCounterLaw x z)
        (positiveLawCounterLaw y w) := by
  decide
""",
        "left_self_distributive": """theorem positive_countermodel_left_self_distributive :
    ∀ x y z : PositiveCounterCarrier,
      positiveLawCounterLaw x (positiveLawCounterLaw y z) =
      positiveLawCounterLaw
        (positiveLawCounterLaw x y)
        (positiveLawCounterLaw x z) := by
  decide
""",
        "right_self_distributive": """theorem positive_countermodel_right_self_distributive :
    ∀ x y z : PositiveCounterCarrier,
      positiveLawCounterLaw (positiveLawCounterLaw x y) z =
      positiveLawCounterLaw
        (positiveLawCounterLaw x z)
        (positiveLawCounterLaw y z) := by
  decide
""",
        "surjective": """theorem positive_countermodel_surjective :
    ∀ target : PositiveCounterCarrier,
      ∃ x y : PositiveCounterCarrier,
        positiveLawCounterLaw x y = target := by
  decide
""",
    }

    selected = [law for law in laws if law in statements]
    theorem_blocks = "\n".join(statements[law] for law in selected)
    theorem_names = [f"positive_countermodel_{law}" for law in selected]

    if not theorem_names:
        package_term = "True.intro"
    else:
        package_term = theorem_names[-1]
        for theorem_name in reversed(theorem_names[:-1]):
            package_term = f"⟨{theorem_name}, {package_term}⟩"

    package_proof = f"""theorem positive_countermodel_satisfies_all_advertised_laws :
    PositiveLawPackage positiveLawCounterLaw := by
  unfold PositiveLawPackage
  exact {package_term}
"""
    return theorem_blocks, package_proof


def term_ladr(term: Term) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable
    assert term.left is not None and term.right is not None
    return f"f({term_ladr(term.left)},{term_ladr(term.right)})"


def prover9_input(identity: IdentityDiscovery) -> str:
    law_lines = {
        "commutative": "all x all y (f(x,y) = f(y,x)).",
        "associative": "all x all y all z (f(f(x,y),z) = f(x,f(y,z))).",
        "idempotent": "all x (f(x,x) = x).",
        "flexible": "all x all y (f(x,f(y,x)) = f(f(x,y),x)).",
        "left_alternative": "all x all y (f(x,f(x,y)) = f(f(x,x),y)).",
        "right_alternative": "all x all y (f(f(x,y),y) = f(x,f(y,y))).",
        "medial": "all x all y all z all w (f(f(x,y),f(z,w)) = f(f(x,z),f(y,w))).",
        "left_self_distributive": "all x all y all z (f(x,f(y,z)) = f(f(x,y),f(x,z))).",
        "right_self_distributive": "all x all y all z (f(f(x,y),z) = f(f(x,z),f(y,z))).",
    }
    assumptions = [law_lines[law] for law in identity.positive_law_names if law in law_lines]
    goal = f"{term_ladr(identity.lhs)} = {term_ladr(identity.rhs)}."
    return "\n".join([
        "% HXC generated implication problem",
        "formulas(assumptions).",
        *assumptions,
        "end_of_list.",
        "formulas(goals).",
        goal,
        "end_of_list.",
        "",
    ])


def lean_discovered_identity_block(
    identity: IdentityDiscovery,
    identity_glyph: UnicodeGlyph,
) -> str:
    countermodel_definition = lean_named_operation_definition(
        identity.countermodel_table,
        "identityCounterLaw",
    )
    witness_map = {
        variable: f"mkCarrier {value}"
        for variable, value in zip(
            IDENTITY_VARIABLES,
            identity.counterexample_assignment,
            strict=True,
        )
    }
    counter_lhs = term_lean(identity.lhs, law_name="identityCounterLaw", variable_map=witness_map)
    counter_rhs = term_lean(identity.rhs, law_name="identityCounterLaw", variable_map=witness_map)

    positive_order = identity.positive_law_countermodel_order
    positive_carrier = "PositiveCounterCarrier"
    positive_maker = "mkPositiveCounter"
    positive_definition = lean_operation_for_custom_carrier(
        identity.positive_law_countermodel_table,
        "positiveLawCounterLaw",
        positive_carrier,
        positive_maker,
    )
    positive_witness_map = {
        variable: f"{positive_maker} {value}"
        for variable, value in zip(
            IDENTITY_VARIABLES,
            identity.positive_law_counterexample_assignment,
            strict=True,
        )
    }
    positive_lhs = term_lean(identity.lhs, law_name="positiveLawCounterLaw", variable_map=positive_witness_map)
    positive_rhs = term_lean(identity.rhs, law_name="positiveLawCounterLaw", variable_map=positive_witness_map)
    positive_package = positive_law_package_expression(identity.positive_law_names)
    positive_component_theorems, positive_package_theorem = (
        lean_positive_law_component_proofs(identity.positive_law_names)
    )

    seed_codes = sorted(seed_identity_codes())
    variable_binders = " ".join(identity.variables)
    return f"""/-!
## Machine-synthesised novelty-audited identity

Identity glyph:
* `{identity_glyph.symbol}` ({identity_glyph.codepoint},
  {identity_glyph.name}, category {identity_glyph.category})

The identity has a sampled catalogue-neighbour countermodel and a separate
small finite countermodel satisfying every advertised positive law.
-/

