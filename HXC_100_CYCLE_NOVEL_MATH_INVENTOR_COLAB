                operation_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("Sm", "So", "Sk", "Sc"),
                )
                symmetry_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("So", "Sm", "Sk", "Sc"),
                )
                identity_glyph = select_fresh_glyph(
                    unicode_pool,
                    rng,
                    trial_used_symbols,
                    ("Sm", "So", "Sk", "Sc"),
                )

                candidate, statistics = search_novel_structure(
                    rng,
                    catalogues,
                    catalogue_metadata,
                    excluded_canonical_up_to_opposite=used_canonical,
                )

                identity = None
                identity_errors: list[str] = []
                for identity_round in range(
                    1,
                    IDENTITY_SEARCH_ROUNDS_PER_STRUCTURE + 1,
                ):
                    identity_seed = (
                        cycle_seed
                        + identity_round * IDENTITY_ROUND_SEED_STRIDE
                    )
                    identity_rng = random.Random(identity_seed)
                    try:
                        identity = discover_symbolic_identity(
                            candidate,
                            catalogues,
                            identity_rng,
                            operation_glyph,
                            equation_databases,
                            excluded_identity_codes=used_identity_codes,
                        )
                        if identity_round > 1:
                            print(
                                "Identity search succeeded on round "
                                f"{identity_round}/"
                                f"{IDENTITY_SEARCH_ROUNDS_PER_STRUCTURE}.",
                                flush=True,
                            )
                        break
                    except RuntimeError as identity_error:
                        message = str(identity_error)
                        identity_errors.append(message)
                        if (
                            "No identity" not in message
                            and "lacked a catalogue-neighbour" not in message
                        ):
                            raise
                        print(
                            "Identity search round "
                            f"{identity_round}/"
                            f"{IDENTITY_SEARCH_ROUNDS_PER_STRUCTURE} rejected: "
                            f"{message}",
                            flush=True,
                        )

                if identity is None:
                    raise RuntimeError(
                        "Identity search exhausted all rounds for this "
                        "structure. Last result: "
                        + (identity_errors[-1] if identity_errors else "unknown")
                    )

                print(
                    f"Unicode: {structure_glyph.symbol} "
                    f"{operation_glyph.symbol} {symmetry_glyph.symbol} "
