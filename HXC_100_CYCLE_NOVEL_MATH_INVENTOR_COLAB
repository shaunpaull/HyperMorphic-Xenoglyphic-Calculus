  {symmetry_glyph.name}, category {symmetry_glyph.category})

Discovered theorem:
* `{identity_glyph.symbol}` ({identity_glyph.codepoint},
  {identity_glyph.name}, category {identity_glyph.category})

The table was selected from arbitrary finite operation tables after:

* isomorphism-class deduplication;
* complete generated shelf/quandle/quasigroup catalogue rejection;
* two-argument non-degeneracy and entropy gates;
* structural-interest scoring with sample rarity excluded;
* counterexample search;
* nontrivial automorphism enforcement.

The formal novelty claims below are relative to the stated reference library.
-/

def order : Nat := {ORDER}

theorem order_positive :
    0 < order := by
  decide

abbrev Carrier := Fin order

def mkCarrier (value : Nat) : Carrier :=
  ⟨value % order, Nat.mod_lt _ order_positive⟩

{operation_definition}

{symmetry_definition}

