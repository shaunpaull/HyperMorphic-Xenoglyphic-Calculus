def variable_term(name: str) -> Term:
    return Term(kind="var", variable=name)


def operation_term(left: Term, right: Term) -> Term:
    return Term(
        kind="op",
        left=left,
        right=right,
        depth=1 + max(left.depth, right.depth),
        size=1 + left.size + right.size,
    )


def term_code(term: Term) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return f"⋆({term_code(term.left)},{term_code(term.right)})"


def term_display(term: Term, glyph: str) -> str:
    if term.kind == "var":
        assert term.variable is not None
        return term.variable

    assert term.left is not None and term.right is not None
    return (
        f"({term_display(term.left, glyph)} "
        f"{glyph} {term_display(term.right, glyph)})"
    )


def term_lean(
    term: Term,
    *,
    law_name: str,
    variable_map: dict[str, str] | None = None,
) -> str:
    if term.kind == "var":
        assert term.variable is not None
        if variable_map is None:
            return term.variable
        return variable_map[term.variable]

    assert term.left is not None and term.right is not None
    return (
        f"{law_name} "
        f"({term_lean(term.left, law_name=law_name, variable_map=variable_map)}) "
        f"({term_lean(term.right, law_name=law_name, variable_map=variable_map)})"
    )


def term_variables(term: Term) -> frozenset[str]:
    if term.kind == "var":
        assert term.variable is not None
        return frozenset({term.variable})

    assert term.left is not None and term.right is not None
    return term_variables(term.left) | term_variables(term.right)


def rename_term(term: Term, mapping: dict[str, str]) -> Term:
    if term.kind == "var":
        assert term.variable is not None
        return variable_term(mapping[term.variable])

    assert term.left is not None and term.right is not None
    return operation_term(
        rename_term(term.left, mapping),
        rename_term(term.right, mapping),
    )


def canonical_identity_code(lhs: Term, rhs: Term) -> str:
    candidates: list[str] = []

    for renamed_variables in permutations(IDENTITY_VARIABLES):
        mapping = dict(zip(IDENTITY_VARIABLES, renamed_variables, strict=True))
        renamed_lhs = term_code(rename_term(lhs, mapping))
        renamed_rhs = term_code(rename_term(rhs, mapping))
        left_code, right_code = sorted((renamed_lhs, renamed_rhs))
        candidates.append(f"{left_code}={right_code}")

    return min(candidates)


def seed_identity_codes() -> set[str]:
    x, y, z, w = (variable_term(name) for name in IDENTITY_VARIABLES)
    op = operation_term

    seed_pairs = (
        (op(x, y), op(y, x)),
        (op(op(x, y), z), op(x, op(y, z))),
        (op(x, x), x),
        (op(x, op(y, x)), op(op(x, y), x)),
        (op(x, op(x, y)), op(op(x, x), y)),
        (op(op(x, y), y), op(x, op(y, y))),
        (
            op(op(x, y), op(z, w)),
            op(op(x, z), op(y, w)),
        ),
        (
            op(x, op(y, z)),
            op(op(x, y), op(x, z)),
        ),
        (
            op(op(x, y), z),
            op(op(x, z), op(y, z)),
        ),
    )

    return {
        canonical_identity_code(lhs, rhs)
        for lhs, rhs in seed_pairs
    }


def generate_identity_terms(rng: random.Random) -> list[Term]:
    variables = [variable_term(name) for name in IDENTITY_VARIABLES]
    depth_one = [
        operation_term(left, right)
        for left in variables
        for right in variables
    ]

    depth_at_most_one = variables + depth_one
    depth_two = [
        operation_term(left, right)
        for left in depth_at_most_one
        for right in depth_at_most_one
        if max(left.depth, right.depth) == 1
    ]

    terms_by_code = {
        term_code(term): term
        for term in variables + depth_one + depth_two
    }
    depth_at_most_two = list(terms_by_code.values())

    while len(terms_by_code) < IDENTITY_TERM_BUDGET:
        left = rng.choice(depth_at_most_two)
        right = rng.choice(depth_at_most_two)
        if max(left.depth, right.depth) != 2:
            continue

        term = operation_term(left, right)
        terms_by_code.setdefault(term_code(term), term)

    return sorted(
        terms_by_code.values(),
        key=lambda term: (term.depth, term.size, term_code(term)),
    )


def identity_assignments() -> tuple[tuple[int, int, int, int], ...]:
    return tuple(product(range(ORDER), repeat=len(IDENTITY_VARIABLES)))


def term_vector(
    term: Term,
    table: tuple[tuple[int, ...], ...],
    assignments: tuple[tuple[int, int, int, int], ...],
    memo: dict[Term, tuple[int, ...]],
) -> tuple[int, ...]:
    cached = memo.get(term)
    if cached is not None:
        return cached

    if term.kind == "var":
        assert term.variable is not None
        index = IDENTITY_VARIABLES.index(term.variable)
        result = tuple(assignment[index] for assignment in assignments)
    else:
        assert term.left is not None and term.right is not None
        left_vector = term_vector(term.left, table, assignments, memo)
        right_vector = term_vector(term.right, table, assignments, memo)
        result = tuple(
            table[left_value][right_value]
            for left_value, right_value in zip(
                left_vector,
                right_vector,
                strict=True,
            )
        )

    memo[term] = result
    return result


