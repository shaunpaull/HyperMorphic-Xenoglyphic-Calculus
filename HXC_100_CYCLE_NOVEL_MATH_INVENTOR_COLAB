def audit() -> None:
    source = (ROOT / "HXCNovel.lean").read_text(encoding="utf-8")
    patterns = (
        re.compile(r"\bsorry\b"),
        re.compile(r"\badmit\b"),
        re.compile(r"^\s*axiom\b", re.MULTILINE),
        re.compile(r"\bunsafe\b"),
    )
    violations = []
    for pattern in patterns:
        match = pattern.search(source)
        if match is not None:
            violations.append(match.group(0))

    if violations:
        raise RuntimeError(
            "Proof-placeholder audit failed: " + ", ".join(violations)
        )

    # Lean block comments may be nested. Scan the source exactly as a small
    # delimiter stack so malformed generated documentation cannot reach Lake.
    comment_stack: list[tuple[int, int]] = []
    index = 0
    line = 1
    column = 1

    while index < len(source) - 1:
        pair = source[index:index + 2]

        if pair == "/-":
            comment_stack.append((line, column))
            index += 2
            column += 2
            continue

        if pair == "-/":
            if not comment_stack:
                raise RuntimeError(
                    f"Lean comment audit failed: unmatched `-/` at "
                    f"line {line}, column {column}."
                )
            comment_stack.pop()
            index += 2
            column += 2
            continue

        if source[index] == "\n":
            line += 1
            column = 1
        else:
            column += 1
        index += 1

    if comment_stack:
        locations = ", ".join(
            f"line {open_line}, column {open_column}"
            for open_line, open_column in comment_stack
        )
        raise RuntimeError(
            "Lean comment audit failed: unterminated block comment opened at "
            + locations
        )

    if "-*/" in source or "/*-" in source:
        raise RuntimeError(
            "Lean comment audit failed: C-style hybrid comment delimiter found."
        )

    forbidden_whole_package_decide = (
        "theorem positive_countermodel_satisfies_all_advertised_laws :\n"
        "    PositiveLawPackage positiveLawCounterLaw := by\n"
        "  decide"
    )
    if forbidden_whole_package_decide in source:
        raise RuntimeError(
            "Lean source audit failed: whole-package Decidable regression found."
        )

    banner("SOURCE AUDIT: PASSED")
    print(
        "No proof placeholders, local axioms, unsafe declarations, or "
        "unbalanced Lean comments detected.",
        flush=True,
    )


