def lean_relabeling_universe() -> str:
    """Generate every carrier permutation as an explicit Lean constructor.

    This avoids asking Lean to synthesize decidability for an existential over
    arbitrary functions. The resulting checker ranges over exactly ORDER!
    generated relabellings.
    """

    permutations_list = list(PERMUTATIONS)
    constructor_names = [f"p{index}" for index in range(len(permutations_list))]

    inductive_lines = [
        "inductive Relabeling where",
        *[f"  | {name}" for name in constructor_names],
        "deriving DecidableEq, Repr",
        "",
    ]

    def carrier_expression(permutation: tuple[int, ...]) -> str:
        pieces: list[str] = []
        for source_value in range(ORDER - 1):
            pieces.append(
                f"if x.val = {source_value} then "
                f"mkCarrier {permutation[source_value]} else "
            )
        pieces.append(f"mkCarrier {permutation[ORDER - 1]}")
        return "".join(pieces)

    apply_lines = [
        "def applyRelabeling : Relabeling → Carrier → Carrier",
    ]
    for name, permutation in zip(
        constructor_names,
        permutations_list,
        strict=True,
    ):
        apply_lines.append(
            f"  | .{name}, x => {carrier_expression(permutation)}"
        )
    apply_lines.append("")

    registry_items = ", ".join(f".{name}" for name in constructor_names)
    registry_lines = [
        "def allRelabelings : List Relabeling :=",
        f"  [{registry_items}]",
        "",
        "def relabelingInjective (relabel : Relabeling) : Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          if applyRelabeling relabel (mkCarrier x) ==",
        "              applyRelabeling relabel (mkCarrier y) then",
        "            x == y",
        "          else",
        "            true))",
        "",
        "theorem relabeling_registry_size :",
        f"    allRelabelings.length = {len(permutations_list)} := by",
        "  decide",
        "",
        "theorem relabeling_registry_nodup :",
        "    allRelabelings.Nodup := by",
        "  decide",
        "",
        "theorem every_registered_relabeling_is_injective :",
        "    allRelabelings.all relabelingInjective = true := by",
        "  decide",
        "",
        "def preservesOperation",
        "    (relabel : Relabeling)",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          applyRelabeling relabel",
        "              (first (mkCarrier x) (mkCarrier y)) ==",
        "            second",
        "              (applyRelabeling relabel (mkCarrier x))",
        "              (applyRelabeling relabel (mkCarrier y))))",
        "",
        "def isomorphicBool",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  allRelabelings.any",
        "    (fun relabel => preservesOperation relabel first second)",
        "",
        "/--",
        "Finite isomorphism over the explicitly generated complete permutation",
        "registry. The Python generator emits every permutation of the carrier;",
        "Lean verifies the registry size, absence of duplicates, injectivity of",
        "every entry, and every operation-preservation check.",
        "-/",
        "def IsIsomorphic",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Prop :=",
        "  isomorphicBool first second = true",
        "",
    ]

    return "\n".join(inductive_lines + apply_lines + registry_lines)



def lean_discovered_identity_block(
    identity: IdentityDiscovery,
    identity_glyph: UnicodeGlyph,
) -> str:
    countermodel_definition = lean_named_operation_definition(
        identity.countermodel_table,
        "identityCounterLaw",
    )

    witness_map = {
        variable: f"mkCarrier {value}"
        for variable, value in zip(
            IDENTITY_VARIABLES,
            identity.counterexample_assignment,
            strict=True,
        )
    }

    counter_lhs = term_lean(
        identity.lhs,
        law_name="identityCounterLaw",
        variable_map=witness_map,
    )
    counter_rhs = term_lean(
        identity.rhs,
        law_name="identityCounterLaw",
        variable_map=witness_map,
    )

    seed_codes = sorted(seed_identity_codes())
    variable_binders = " ".join(identity.variables)

    return f"""/-!
## Machine-synthesised identity

Identity glyph:
* `{identity_glyph.symbol}` ({identity_glyph.codepoint},
  {identity_glyph.name}, category {identity_glyph.category})

The identity was generated from a term grammar, removed if equivalent to a
seed law under variable renaming, and retained only after a separate finite
countermodel was found.
-/

def discoveredIdentityCode : String :=
  {json.dumps(identity.canonical_code)}

def seedIdentityCodes : List String :=
  {json.dumps(seed_codes)}

theorem discovered_identity_not_in_seed_library :
    discoveredIdentityCode ∉ seedIdentityCodes := by
  decide

theorem discovered_symbolic_identity :
    ∀ {variable_binders} : Carrier,
      {identity.lean_lhs} =
      {identity.lean_rhs} := by
  decide

{countermodel_definition}

theorem discovered_identity_has_countermodel :
    {counter_lhs} ≠
    {counter_rhs} := by
  decide

structure IdentityDiscoveryCertificate where
  identityGlyph : String
  canonicalCode : String
  displayText : String
  notInSeedLibrary :
    canonicalCode ∉ seedIdentityCodes
  holdsOnInventedStructure :
    ∀ {variable_binders} : Carrier,
      {identity.lean_lhs} =
      {identity.lean_rhs}
  failsOnIndependentCountermodel :
    {counter_lhs} ≠
    {counter_rhs}
  comparisonModelsSatisfied : Nat
  comparisonModelsTotal : Nat
  historicalNoveltyVerified : Bool

def identityDiscoveryCertificate :
    IdentityDiscoveryCertificate where
  identityGlyph := "{identity_glyph.symbol}"
  canonicalCode := discoveredIdentityCode
  displayText := {json.dumps(identity.display)}
  notInSeedLibrary := discovered_identity_not_in_seed_library
  holdsOnInventedStructure := discovered_symbolic_identity
  failsOnIndependentCountermodel :=
    discovered_identity_has_countermodel
  comparisonModelsSatisfied := {identity.model_bank_satisfied}
  comparisonModelsTotal := {identity.model_bank_total}
  historicalNoveltyVerified := false
"""



def nonisomorphism_theorems() -> str:
    references = (
        ("left_projection", "leftProjection"),
        ("right_projection", "rightProjection"),
        ("constant_zero", "constantZero"),
        ("modular_addition", "modularAddition"),
        ("modular_multiplication", "modularMultiplication"),
        ("modular_subtraction", "modularSubtraction"),
        ("minimum", "minimumLaw"),
        ("maximum", "maximumLaw"),
    )

    blocks = []
    for theorem_suffix, lean_name in references:
        blocks.append(
            f"""theorem alien_not_isomorphic_to_{theorem_suffix} :
    ¬ IsIsomorphic alienLaw {lean_name} := by
  change isomorphicBool alienLaw {lean_name} ≠ true
  decide
"""
        )
    return "\n".join(blocks)


def make_lean_source(
    candidate: StructureCandidate,
    identity: IdentityDiscovery,
    structure_glyph: UnicodeGlyph,
    operation_glyph: UnicodeGlyph,
    symmetry_glyph: UnicodeGlyph,
    identity_glyph: UnicodeGlyph,
) -> str:
    operation_definition = lean_operation_definition(candidate.table)
    automorphism = symmetry_permutation()
    symmetry_definition = lean_symmetry_definition(automorphism)
    true_laws = lean_true_law_theorems(candidate.properties)
    nondegeneracy_laws = lean_nondegeneracy_theorems()
    classification_predicates = lean_classification_predicates(candidate.table)
    identity_laws = lean_identity_theorems(candidate.properties)
    counterexamples = lean_counterexample_theorems(
        candidate.table,
        candidate.properties,
    )
    references = reference_definitions()
    relabeling_universe = lean_relabeling_universe()
    noniso = nonisomorphism_theorems()
    identity_block = lean_discovered_identity_block(
        identity,
        identity_glyph,
    )

    true_law_names = [
        key
        for key in LAW_KEYS
        if bool(candidate.properties[key])
    ]
    catalogue_scope = candidate.novelty_label
    catalogue_manifest_hash = hashlib.sha256(
        json.dumps(
            {
                "classifications": candidate.classifications,
                "metrics": candidate.metrics,
                "catalogue_memberships": candidate.catalogue_memberships,
            },
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()

    return f"""import Std

