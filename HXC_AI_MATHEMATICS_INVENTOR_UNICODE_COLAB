"""


def write_project(
    law: BinaryDiscovery,
    symmetry: UnaryDiscovery,
    witness: tuple[int, int],
    unicode_pool: list[UnicodeGlyph],
) -> None:
    if ROOT.exists():
        shutil.rmtree(ROOT)
    ROOT.mkdir(parents=True)

    source = lean_source(law, symmetry, witness)
    report = build_report(law, symmetry, witness)

    lakefile = """name = "hxc-ai-math-inventor"
version = "1.1.0"
defaultTargets = ["HXCAI"]

[[lean_lib]]
name = "HXCAI"
"""

    assigned_symbols = {law.glyph, symmetry.glyph}
    unicode_registry = {
        "unicode_database_version": unicodedata.unidata_version,
        "code_points_scanned": sys.maxunicode + 1,
        "accepted_symbols": len(unicode_pool),
        "filters": {
            "categories": sorted(UNICODE_SYMBOL_CATEGORIES),
            "printable_only": True,
            "combining_marks_excluded": True,
            "invisible_and_directional_controls_excluded": True,
            "unassigned_code_points_excluded": True,
        },
        "glyphs": [
            {
                "symbol": glyph.symbol,
                "codepoint": glyph.codepoint,
                "name": glyph.name,
                "category": glyph.category,
                "assigned": glyph.symbol in assigned_symbols,
                "role": (
                    "binary"
                    if glyph.symbol == law.glyph
                    else "unary"
                    if glyph.symbol == symmetry.glyph
                    else None
                ),
            }
            for glyph in unicode_pool
        ],
    }

    files = {
        "HXCAI.lean": source,
        "StdPreflight.lean": (
            'import Std\n\n'
            'def main : IO Unit :=\n'
            '  IO.println "Std preflight: PASSED"\n'
        ),
        "lakefile.toml": lakefile,
        "lean-toolchain": TOOLCHAIN + "\n",
        "INVENTION_REPORT.md": report,
        "unicode_glyph_registry.json": json.dumps(
            unicode_registry,
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        "invention.json": json.dumps(
            {
                "modulus": MODULUS,
                "seed": SEED,
                "unicode_registry": {
                    "unicode_database_version": unicodedata.unidata_version,
                    "code_points_scanned": sys.maxunicode + 1,
                    "accepted_symbols": len(unicode_pool),
                },
                "binary": {
                    "glyph": law.glyph,
                    "glyph_codepoint": law.glyph_codepoint,
                    "glyph_name": law.glyph_name,
                    "glyph_category": law.glyph_category,
                    "a": law.a,
                    "b": law.b,
                    "c": law.c,
                    "identity": law.identity,
                    "table": law.table,
                },
                "unary": {
                    "glyph": symmetry.glyph,
                    "glyph_codepoint": symmetry.glyph_codepoint,
                    "glyph_name": symmetry.glyph_name,
                    "glyph_category": symmetry.glyph_category,
                    "a": symmetry.a,
                    "b": symmetry.b,
                    "fixed_points": symmetry.fixed_points,
                    "table": symmetry.table,
                },
                "rejected_idempotence_witness": {
                    "input": witness[0],
                    "result": witness[1],
                },
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
    }

    banner("HXC AI-GENERATED PROJECT")
    for relative, content in files.items():
        path = ROOT / relative
        path.write_text(content, encoding="utf-8")
        raw = content.encode("utf-8")
        print(
            f"{relative:<24} bytes={len(raw):>7} "
            f"lines={content.count(chr(10)):>4} "
            f"sha256={hashlib.sha256(raw).hexdigest()}",
            flush=True,
        )


def audit() -> None:
    source = (ROOT / "HXCAI.lean").read_text(encoding="utf-8")
    forbidden = [
        re.compile(r"\bsorry\b"),
        re.compile(r"\badmit\b"),
        re.compile(r"^\s*axiom\b", re.MULTILINE),
        re.compile(r"\bunsafe\b"),
    ]
    violations = []
    for pattern in forbidden:
        match = pattern.search(source)
        if match is not None:
            violations.append(match.group(0))

    if violations:
        raise RuntimeError(
            "Proof-placeholder audit failed: " + ", ".join(violations)
        )

    banner("PROOF-PLACEHOLDER AUDIT: PASSED")
    print(
        "No `sorry`, `admit`, local `axiom`, or `unsafe` declarations detected.",
        flush=True,
    )


def lean_environment() -> dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = (
        str(Path.home() / ".elan" / "bin")
        + os.pathsep
        + env.get("PATH", "")
    )
    env["PYTHONUTF8"] = "1"
    return env


def install_or_reuse_lean() -> dict[str, str]:
    env = lean_environment()

    run(["apt-get", "update", "-qq"], env=env)
    run(
        [
            "apt-get",
            "install",
            "-y",
            "-qq",
            "ca-certificates",
            "curl",
            "git",
            "zstd",
        ],
        env=env,
    )

    if shutil.which("elan", path=env["PATH"]) is None:
        installer = Path("/tmp/elan-init.sh")
        run(
            [
                "curl",
                "-sSf",
                "https://elan.lean-lang.org/elan-init.sh",
                "-o",
                str(installer),
            ],
            env=env,
        )
        run(
            ["sh", str(installer), "-y", "--default-toolchain", "none"],
            env=env,
        )

    run(["elan", "--version"], env=env)
    run(
        ["elan", "toolchain", "install", TOOLCHAIN],
        env=env,
        accepted_failure_text=("already installed", "is already installed"),
    )

    env["ELAN_TOOLCHAIN"] = TOOLCHAIN
    run(["elan", "toolchain", "list"], env=env)
    run(["lean", "--version"], env=env)
    run(["lake", "--version"], env=env)
    return env


def build(env: dict[str, str]) -> None:
    stale = ROOT / ".lake"
    if stale.exists():
        shutil.rmtree(stale)

    run(
        ["lean", "--run", "StdPreflight.lean"],
        cwd=ROOT,
        env=env,
    )
    run(["lake", "env", "lean", "HXCAI.lean"], cwd=ROOT, env=env)
    run(["lake", "build"], cwd=ROOT, env=env)


