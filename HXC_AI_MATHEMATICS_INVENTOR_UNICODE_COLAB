    "HXC_LEAN_TOOLCHAIN",
    "leanprover/lean4:v4.33.0-rc1",
)
MODULUS = int(os.environ.get("HXC_MODULUS", "8"))
SEED = int(os.environ.get("HXC_SEED", "2026"))
