#!/usr/bin/env python3
"""HXC Lean 4: single-file, plug-and-play Google Colab runner v2.

Paste this entire script into one Colab cell and run it.

It ignores Jupyter/Colab command-line arguments, reconstructs the complete
Lean source from Base64, installs or reuses Lean idempotently, audits the source, prints complete
compiler diagnostics, and runs both direct elaboration and `lake build`.
"""

from __future__ import annotations

import base64
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

TOOLCHAIN = os.environ.get(
    "HXC_LEAN_TOOLCHAIN",
    "leanprover/lean4:v4.33.0-rc1",
)
ROOT = Path("/content/HXCLean")
FILES_B64 = {
    "HXC.lean": "",
    "lakefile.toml": "bmFtZSA9ICJoeGMtZm9ybWFsIgp2ZXJzaW9uID0gIjAuMi4wIgpkZWZhdWx0VGFyZ2V0cyA9IFsiSFhDIl0KCltbbGVhbl9saWJdXQpuYW1lID0gIkhYQyIK",
    "lean-toolchain": "bGVhbnByb3Zlci9sZWFuNDp2NC4zMy4wLXJjMQo=",
}

FORBIDDEN = (
    re.compile(r"\bsorry\b"),
    re.compile(r"\badmit\b"),
    re.compile(r"^\s*axiom\b", re.MULTILINE),
    re.compile(r"\bunsafe\b"),
)


def banner(text: str) -> None:
    print("\n" + "=" * 92, flush=True)
    print(text, flush=True)
    print("=" * 92, flush=True)


def run(
    command: list[str],
    *,
    cwd: Path | None = None,
    env=None,
    accepted_failure_text: tuple[str, ...] = (),
) -> str:
    """Run a command, print all output, and return that output.

    Some Elan releases return exit code 1 for harmless idempotent states such
    as "toolchain is already installed". Those outcomes are accepted only when
    their exact diagnostic text is explicitly listed.
    """

    banner("$ " + " ".join(command))
    completed = subprocess.run(
        command,
        cwd=None if cwd is None else str(cwd),
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    output = completed.stdout or ""
    if output:
        print(output, end="" if output.endswith("\n") else "\n")

    if completed.returncode != 0:
        lowered = output.lower()
        accepted = any(marker.lower() in lowered for marker in accepted_failure_text)
        if not accepted:
            raise RuntimeError(
                f"Command failed with exit code {completed.returncode}: "
                + " ".join(command)
            )
        print(
            "Recognised harmless idempotent Elan result; continuing.",
            flush=True,
        )

    return output


def reconstruct() -> None:
    if ROOT.exists():
        shutil.rmtree(ROOT)
    ROOT.mkdir(parents=True)

    banner("HXC LEAN BASE64 RECONSTRUCTION")
    for relative, payload in FILES_B64.items():
        path = ROOT / relative
        raw = base64.b64decode(payload.encode("ascii"), validate=True)

        if relative == "lean-toolchain":
            raw = (TOOLCHAIN + "\n").encode("utf-8")

        path.write_bytes(raw)
        digest = hashlib.sha256(raw).hexdigest()
        lines = raw.count(b"\n")
        print(
            f"{relative:<20} bytes={len(raw):>6} "
            f"lines={lines:>4} sha256={digest}",
            flush=True,
        )


def audit() -> None:
    source = (ROOT / "HXC.lean").read_text(encoding="utf-8")
    violations = []
    for pattern in FORBIDDEN:
        match = pattern.search(source)
        if match:
            violations.append(match.group(0))

    if violations:
        raise RuntimeError(
            "Proof-placeholder audit failed: " + ", ".join(violations)
        )

    banner("PROOF-PLACEHOLDER AUDIT: PASSED")
    print(
        "No `sorry`, `admit`, local `axiom`, or `unsafe` declarations detected.",
        flush=True,
    )


def environment() -> dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = str(Path.home() / ".elan" / "bin") + os.pathsep + env.get("PATH", "")
    env["PYTHONUTF8"] = "1"
    return env


def install() -> dict[str, str]:
    """Install prerequisites and select the requested Lean toolchain safely."""

    env = environment()

    run(["apt-get", "update", "-qq"], env=env)
    run(
        [
            "apt-get",
            "install",
            "-y",
            "-qq",
            "ca-certificates",
            "curl",
            "git",
            "zstd",
        ],
        env=env,
    )

    if shutil.which("elan", path=env["PATH"]) is None:
        installer = Path("/tmp/elan-init.sh")
        run(
            [
                "curl",
                "-sSf",
                "https://elan.lean-lang.org/elan-init.sh",
                "-o",
                str(installer),
            ],
            env=env,
        )
        run(
            ["sh", str(installer), "-y", "--default-toolchain", "none"],
            env=env,
        )

    run(["elan", "--version"], env=env)

    # Elan 4.2.3 may report an already-installed toolchain with exit code 1.
    # Accept only that explicit idempotent diagnostic; all other failures stop.
    run(
        ["elan", "toolchain", "install", TOOLCHAIN],
        env=env,
        accepted_failure_text=(
            "is already installed",
            "already installed",
        ),
    )

    # Avoid changing the notebook's global Elan default. Every subsequent Lean
    # and Lake command is pinned through this environment variable.
    env["ELAN_TOOLCHAIN"] = TOOLCHAIN

    run(["elan", "toolchain", "list"], env=env)
    run(["lean", "--version"], env=env)
    run(["lake", "--version"], env=env)
    return env


def build(env: dict[str, str]) -> None:
    stale = ROOT / ".lake"
    if stale.exists():
        shutil.rmtree(stale)

    # First elaborate the exact source directly. This produces the clearest
    # source-position diagnostics if a theorem fails.
    run(["lake", "env", "lean", "HXC.lean"], cwd=ROOT, env=env)

    # Then verify the repository package target itself.
    run(["lake", "build"], cwd=ROOT, env=env)


def main() -> None:
    # Deliberately do not parse sys.argv. Colab injects `-f kernel.json`.
    banner("HXC LEAN 4 - ONE-FLOW GOOGLE COLAB BUILD V2")
    print(f"Repository root: {ROOT}", flush=True)
    print(f"Toolchain:       {TOOLCHAIN}", flush=True)

    reconstruct()
    audit()
    env = install()
    build(env)

    banner("HXC LEAN BUILD: PASSED")
    print(f"Formal project: {ROOT}", flush=True)
    print(f"Lean source:    {ROOT / 'HXC.lean'}", flush=True)
    print("All definitions and proofs were accepted by the Lean kernel.", flush=True)


if __name__ == "__main__":
    main()
