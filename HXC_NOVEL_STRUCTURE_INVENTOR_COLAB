    catalogues: dict[str, set[tuple[int, ...]]],
    structure_glyph: UnicodeGlyph,
    operation_glyph: UnicodeGlyph,
    symmetry_glyph: UnicodeGlyph,
) -> None:
    if ROOT.exists():
        shutil.rmtree(ROOT)
    ROOT.mkdir(parents=True)

    lean = make_lean_source(
        candidate,
        structure_glyph,
        operation_glyph,
        symmetry_glyph,
    )
    report = build_report(
        candidate,
        statistics,
        structure_glyph,
        operation_glyph,
        symmetry_glyph,
    )

    lakefile = """name = "hxc-novel-structure-inventor"
version = "4.0.0"
defaultTargets = ["HXCNovel"]

[[lean_lib]]
name = "HXCNovel"
roots = ["HXCNovel"]
"""

    assigned = {
        structure_glyph.symbol: "structure",
