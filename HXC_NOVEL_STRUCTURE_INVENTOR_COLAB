def banner(text: str) -> None:
    print("\n" + "=" * 104, flush=True)
    print(text, flush=True)
    print("=" * 104, flush=True)


def run(
    command: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    accepted_failure_text: tuple[str, ...] = (),
) -> str:
    banner("$ " + " ".join(command))
    completed = subprocess.run(
        command,
        cwd=None if cwd is None else str(cwd),
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    output = completed.stdout or ""
    if output:
        print(output, end="" if output.endswith("\n") else "\n")

    if completed.returncode != 0:
        lowered = output.lower()
        accepted = any(marker.lower() in lowered for marker in accepted_failure_text)
        if not accepted:
            raise RuntimeError(
                f"Command failed with exit code {completed.returncode}: "
                + " ".join(command)
            )
        print("Recognised harmless idempotent result; continuing.", flush=True)

    return output


# ---------------------------------------------------------------------------
# Unicode glyph registry
# ---------------------------------------------------------------------------

def usable_unicode_symbol(character: str) -> bool:
    if len(character) != 1:
        return False
    if not character.isprintable() or character.isspace():
        return False
    if character in {'"', "'", "`", "\\"}:
        return False
    if unicodedata.combining(character) != 0:
        return False

    category = unicodedata.category(character)
    if category not in UNICODE_SYMBOL_CATEGORIES:
        return False
    if unicodedata.bidirectional(character) in BANNED_BIDI_CLASSES:
        return False

    try:
        name = unicodedata.name(character)
    except ValueError:
        return False

    if any(part in name.upper() for part in BANNED_UNICODE_NAME_PARTS):
        return False

    try:
        character.encode("utf-8", errors="strict")
    except UnicodeEncodeError:
        return False

    return True


def build_unicode_glyph_pool() -> list[UnicodeGlyph]:
    pool: list[UnicodeGlyph] = []
    for codepoint in range(sys.maxunicode + 1):
        symbol = chr(codepoint)
        if not usable_unicode_symbol(symbol):
            continue
        pool.append(
            UnicodeGlyph(
                symbol=symbol,
                codepoint=f"U+{codepoint:04X}",
                name=unicodedata.name(symbol),
                category=unicodedata.category(symbol),
            )
        )
    return pool


def select_fresh_glyph(
    pool: list[UnicodeGlyph],
    rng: random.Random,
    used: set[str],
    category_order: tuple[str, ...],
) -> UnicodeGlyph:
    for category in category_order:
        options = [
            glyph
            for glyph in pool
            if glyph.category == category
            and glyph.symbol not in used
            and glyph.symbol not in RESERVED_GLYPHS
        ]
        if options:
            selected = rng.choice(options)
            used.add(selected.symbol)
            return selected
    raise RuntimeError("Filtered Unicode glyph registry exhausted.")


# ---------------------------------------------------------------------------
# Finite operation tables and isomorphism
# ---------------------------------------------------------------------------

def operation_from_formula(function) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(function(x, y) % ORDER for y in range(ORDER))
        for x in range(ORDER)
    )


def reference_library() -> dict[str, tuple[tuple[int, ...], ...]]:
    references = {
        "left_projection": operation_from_formula(lambda x, y: x),
        "right_projection": operation_from_formula(lambda x, y: y),
        "constant_zero": operation_from_formula(lambda x, y: 0),
        "modular_addition": operation_from_formula(lambda x, y: x + y),
        "modular_multiplication": operation_from_formula(lambda x, y: x * y),
        "modular_subtraction": operation_from_formula(
            lambda x, y: x + ORDER - y
        ),
        "minimum": operation_from_formula(min),
        "maximum": operation_from_formula(max),
    }
    if ORDER & (ORDER - 1) == 0:
        references["bitwise_xor"] = operation_from_formula(lambda x, y: x ^ y)
    return references


PERMUTATIONS = tuple(permutations(range(ORDER)))


def relabel_table(
    table: tuple[tuple[int, ...], ...],
    permutation: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    inverse = [0] * ORDER
    for old, new in enumerate(permutation):
        inverse[new] = old

    return tuple(
        tuple(
            permutation[
                table[inverse[new_x]][inverse[new_y]]
            ]
            for new_y in range(ORDER)
        )
        for new_x in range(ORDER)
    )


def canonical_form(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return min(
        tuple(value for row in relabel_table(table, permutation) for value in row)
        for permutation in PERMUTATIONS
    )


def symmetry_permutation() -> tuple[int, ...]:
    # A nontrivial involution. It swaps 0 and 1 and fixes all other elements.
    return tuple([1, 0] + list(range(2, ORDER)))


def generate_equivariant_table(
    rng: random.Random,
    automorphism: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    """Generate an arbitrary table that is equivariant under an involution."""

    table = [[-1 for _ in range(ORDER)] for _ in range(ORDER)]
    fixed_outputs = [
        value
        for value in range(ORDER)
        if automorphism[value] == value
    ]

    # ORDER=3 still has one fixed output; ORDER>=4 has at least two.
    if not fixed_outputs:
        raise RuntimeError("Chosen automorphism has no fixed outputs.")

    for x in range(ORDER):
        for y in range(ORDER):
            if table[x][y] != -1:
                continue

            tx = automorphism[x]
            ty = automorphism[y]

            if (tx, ty) == (x, y):
                value = rng.choice(fixed_outputs)
                table[x][y] = value
            else:
                value = rng.randrange(ORDER)
                table[x][y] = value
                table[tx][ty] = automorphism[value]

    return tuple(tuple(row) for row in table)


# ---------------------------------------------------------------------------
# Law discovery and falsification
# ---------------------------------------------------------------------------

def analyse_properties(
    table: tuple[tuple[int, ...], ...],
) -> dict[str, object]:
    elements = range(ORDER)

    properties: dict[str, object] = {
        "commutative": all(
            table[x][y] == table[y][x]
            for x in elements
            for y in elements
        ),
        "associative": all(
            table[table[x][y]][z] == table[x][table[y][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "idempotent": all(
            table[x][x] == x
            for x in elements
        ),
        "flexible": all(
            table[x][table[y][x]] == table[table[x][y]][x]
            for x in elements
            for y in elements
        ),
        "left_alternative": all(
            table[x][table[x][y]] == table[table[x][x]][y]
            for x in elements
            for y in elements
        ),
        "right_alternative": all(
            table[table[x][y]][y] == table[x][table[y][y]]
            for x in elements
            for y in elements
        ),
        "medial": all(
            table[table[x][y]][table[z][w]]
            == table[table[x][z]][table[y][w]]
            for x in elements
            for y in elements
            for z in elements
            for w in elements
        ),
        "left_self_distributive": all(
            table[x][table[y][z]]
            == table[table[x][y]][table[x][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "right_self_distributive": all(
            table[table[x][y]][z]
            == table[table[x][z]][table[y][z]]
            for x in elements
            for y in elements
            for z in elements
        ),
        "latin": (
            all(
                len({table[x][y] for y in elements}) == ORDER
                for x in elements
            )
            and all(
                len({table[x][y] for x in elements}) == ORDER
                for y in elements
            )
        ),
        "surjective": (
            len(
                {
                    table[x][y]
                    for x in elements
                    for y in elements
                }
            )
            == ORDER
        ),
    }

    properties["left_identity"] = next(
        (
            identity
            for identity in elements
            if all(table[identity][x] == x for x in elements)
        ),
        None,
    )
    properties["right_identity"] = next(
        (
            identity
            for identity in elements
            if all(table[x][identity] == x for x in elements)
        ),
        None,
    )

    return properties


def law_fingerprint(properties: dict[str, object]) -> tuple[object, ...]:
    return (
        *(bool(properties[key]) for key in LAW_KEYS),
        properties["left_identity"] is not None,
        properties["right_identity"] is not None,
    )


def output_entropy(table: tuple[tuple[int, ...], ...]) -> float:
    counts = Counter(value for row in table for value in row)
    total = ORDER * ORDER
    return -sum(
        (count / total) * math.log2(count / total)
        for count in counts.values()
    )


def first_counterexample(
    table: tuple[tuple[int, ...], ...],
    law: str,
) -> tuple[int, ...] | None:
    elements = range(ORDER)

    if law == "commutative":
        for x in elements:
            for y in elements:
                if table[x][y] != table[y][x]:
                    return (x, y)

    if law == "associative":
        for x in elements:
            for y in elements:
                for z in elements:
                    if table[table[x][y]][z] != table[x][table[y][z]]:
                        return (x, y, z)

    if law == "left_alternative":
        for x in elements:
            for y in elements:
                if table[x][table[x][y]] != table[table[x][x]][y]:
                    return (x, y)

    if law == "right_alternative":
        for x in elements:
            for y in elements:
                if table[table[x][y]][y] != table[x][table[y][y]]:
                    return (x, y)

    if law == "medial":
        for x in elements:
            for y in elements:
                for z in elements:
                    for w in elements:
                        if (
                            table[table[x][y]][table[z][w]]
                            != table[table[x][z]][table[y][w]]
                        ):
                            return (x, y, z, w)

    return None


def search_novel_structure(
    rng: random.Random,
) -> tuple[StructureCandidate, dict[str, int]]:
    automorphism = symmetry_permutation()
    references = reference_library()
    reference_canonical = {
        name: canonical_form(table)
        for name, table in references.items()
    }
    reference_classes = set(reference_canonical.values())

    seen_classes: set[tuple[int, ...]] = set()
    candidates: list[StructureCandidate] = []

    for sample_index in range(SAMPLES):
        table = generate_equivariant_table(rng, automorphism)
        canonical = canonical_form(table)

        if canonical in seen_classes:
            continue
        seen_classes.add(canonical)

        if canonical in reference_classes:
            continue

        properties = analyse_properties(table)
        interesting_count = sum(
            bool(properties[key])
            for key in INTERESTING_LAWS
        )

        if not bool(properties["surjective"]):
            continue
        if bool(properties["associative"]):
            continue
        if interesting_count < 2:
            continue

        candidates.append(
            StructureCandidate(
                table=table,
                canonical=canonical,
                properties=properties,
                fingerprint=law_fingerprint(properties),
                entropy=output_entropy(table),
                interesting_law_count=interesting_count,
                sample_index=sample_index,
            )
        )

    if not candidates:
        raise RuntimeError(
            "No qualifying structure found. Increase HXC_SAMPLES or change HXC_SEED."
        )

    frequencies = Counter(candidate.fingerprint for candidate in candidates)
    scored: list[StructureCandidate] = []

    for candidate in candidates:
        properties = candidate.properties
        frequency = frequencies[candidate.fingerprint]
        one_sided_identity = (
            (properties["left_identity"] is None)
            != (properties["right_identity"] is None)
        )

        score = (
            4.0 * candidate.interesting_law_count
            + 2.0 * candidate.entropy
            + 3.0 * (not bool(properties["commutative"]))
            + 2.0 * one_sided_identity
            + 5.0 / frequency
        )

        scored.append(
            StructureCandidate(
                table=candidate.table,
                canonical=candidate.canonical,
                properties=candidate.properties,
                fingerprint=candidate.fingerprint,
                entropy=candidate.entropy,
                interesting_law_count=candidate.interesting_law_count,
                sample_index=candidate.sample_index,
                score=score,
                fingerprint_frequency=frequency,
            )
        )

    selected = max(
        scored,
        key=lambda candidate: (
            candidate.score,
            candidate.interesting_law_count,
            candidate.entropy,
            -candidate.sample_index,
        ),
    )

    statistics = {
        "samples_requested": SAMPLES,
        "isomorphism_classes_seen": len(seen_classes),
        "qualifying_classes": len(candidates),
        "reference_classes": len(reference_classes),
    }
    return selected, statistics


