"""



def lean_identity_theorems(properties: dict[str, object]) -> str:
    blocks: list[str] = []

    left_identity = properties["left_identity"]
    right_identity = properties["right_identity"]

    if left_identity is not None:
        blocks.append(
            f"""def alienLeftIdentity : Carrier := mkCarrier {left_identity}

theorem alien_left_identity :
    ∀ x : Carrier, alienLaw alienLeftIdentity x = x := by
  decide
"""
        )
    else:
        blocks.append(
            """theorem alien_has_no_left_identity :
    ¬ ∃ identity : Carrier, ∀ x : Carrier, alienLaw identity x = x := by
  decide
"""
        )

    if right_identity is not None:
        blocks.append(
            f"""def alienRightIdentity : Carrier := mkCarrier {right_identity}

theorem alien_right_identity :
    ∀ x : Carrier, alienLaw x alienRightIdentity = x := by
  decide
"""
        )
    else:
        blocks.append(
            """theorem alien_has_no_right_identity :
    ¬ ∃ identity : Carrier, ∀ x : Carrier, alienLaw x identity = x := by
  decide
"""
        )

    return "\n".join(blocks)


def lean_counterexample_theorems(
    table: tuple[tuple[int, ...], ...],
    properties: dict[str, object],
) -> str:
    blocks: list[str] = []

    if not bool(properties["commutative"]):
        witness = first_counterexample(table, "commutative")
        assert witness is not None
        x, y = witness
        blocks.append(
            f"""theorem rejected_commutativity :
    alienLaw (mkCarrier {x}) (mkCarrier {y}) ≠
    alienLaw (mkCarrier {y}) (mkCarrier {x}) := by
  decide
"""
        )

    if not bool(properties["associative"]):
        witness = first_counterexample(table, "associative")
        assert witness is not None
        x, y, z = witness
        blocks.append(
            f"""theorem rejected_associativity :
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {y}))
      (mkCarrier {z}) ≠
    alienLaw
      (mkCarrier {x})
      (alienLaw (mkCarrier {y}) (mkCarrier {z})) := by
  decide
"""
        )

    if not bool(properties["left_alternative"]):
        witness = first_counterexample(table, "left_alternative")
        if witness is not None:
            x, y = witness
            blocks.append(
                f"""theorem rejected_left_alternative :
    alienLaw
      (mkCarrier {x})
      (alienLaw (mkCarrier {x}) (mkCarrier {y})) ≠
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {x}))
      (mkCarrier {y}) := by
  decide
"""
            )

    if not bool(properties["medial"]):
        witness = first_counterexample(table, "medial")
        if witness is not None:
            x, y, z, w = witness
            blocks.append(
                f"""theorem rejected_mediality :
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {y}))
      (alienLaw (mkCarrier {z}) (mkCarrier {w})) ≠
    alienLaw
      (alienLaw (mkCarrier {x}) (mkCarrier {z}))
      (alienLaw (mkCarrier {y}) (mkCarrier {w})) := by
  decide
"""
            )

    return "\n".join(blocks)


def reference_definitions() -> str:
    return """def leftProjection (x _ : Carrier) : Carrier := x
def rightProjection (_ y : Carrier) : Carrier := y
def constantZero (_ _ : Carrier) : Carrier := mkCarrier 0
def modularAddition (x y : Carrier) : Carrier := mkCarrier (x.val + y.val)
def modularMultiplication (x y : Carrier) : Carrier := mkCarrier (x.val * y.val)
def modularSubtraction (x y : Carrier) : Carrier :=
  mkCarrier (x.val + order - y.val)
def minimumLaw (x y : Carrier) : Carrier := mkCarrier (min x.val y.val)
def maximumLaw (x y : Carrier) : Carrier := mkCarrier (max x.val y.val)
"""



def lean_relabeling_universe() -> str:
    """Generate every carrier permutation as an explicit Lean constructor.

    This avoids asking Lean to synthesize decidability for an existential over
    arbitrary functions. The resulting checker ranges over exactly ORDER!
    generated relabellings.
    """

    permutations_list = list(PERMUTATIONS)
    constructor_names = [f"p{index}" for index in range(len(permutations_list))]

    inductive_lines = [
        "inductive Relabeling where",
        *[f"  | {name}" for name in constructor_names],
        "deriving DecidableEq, Repr",
        "",
    ]

    def carrier_expression(permutation: tuple[int, ...]) -> str:
        pieces: list[str] = []
        for source_value in range(ORDER - 1):
            pieces.append(
                f"if x.val = {source_value} then "
                f"mkCarrier {permutation[source_value]} else "
            )
        pieces.append(f"mkCarrier {permutation[ORDER - 1]}")
        return "".join(pieces)

    apply_lines = [
        "def applyRelabeling : Relabeling → Carrier → Carrier",
    ]
    for name, permutation in zip(
        constructor_names,
        permutations_list,
        strict=True,
    ):
        apply_lines.append(
            f"  | .{name}, x => {carrier_expression(permutation)}"
        )
    apply_lines.append("")

    registry_items = ", ".join(f".{name}" for name in constructor_names)
    registry_lines = [
        "def allRelabelings : List Relabeling :=",
        f"  [{registry_items}]",
        "",
        "def relabelingInjective (relabel : Relabeling) : Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          if applyRelabeling relabel (mkCarrier x) ==",
        "              applyRelabeling relabel (mkCarrier y) then",
        "            x == y",
        "          else",
        "            true))",
        "",
        "theorem relabeling_registry_size :",
        f"    allRelabelings.length = {len(permutations_list)} := by",
        "  decide",
        "",
        "theorem relabeling_registry_nodup :",
        "    allRelabelings.Nodup := by",
        "  decide",
        "",
        "theorem every_registered_relabeling_is_injective :",
        "    allRelabelings.all relabelingInjective = true := by",
        "  decide",
        "",
        "def preservesOperation",
        "    (relabel : Relabeling)",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  (List.range order).all",
        "    (fun x =>",
        "      (List.range order).all",
        "        (fun y =>",
        "          applyRelabeling relabel",
        "              (first (mkCarrier x) (mkCarrier y)) ==",
        "            second",
        "              (applyRelabeling relabel (mkCarrier x))",
        "              (applyRelabeling relabel (mkCarrier y))))",
        "",
        "def isomorphicBool",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Bool :=",
        "  allRelabelings.any",
        "    (fun relabel => preservesOperation relabel first second)",
        "",
        "/--",
        "Finite isomorphism over the explicitly generated complete permutation",
        "registry. The Python generator emits every permutation of the carrier;",
        "Lean verifies the registry size, absence of duplicates, injectivity of",
        "every entry, and every operation-preservation check.",
        "-/",
        "def IsIsomorphic",
        "    (first second : Carrier → Carrier → Carrier) :",
        "    Prop :=",
        "  isomorphicBool first second = true",
        "",
    ]

    return "\n".join(inductive_lines + apply_lines + registry_lines)


def nonisomorphism_theorems() -> str:
    references = (
        ("left_projection", "leftProjection"),
        ("right_projection", "rightProjection"),
        ("constant_zero", "constantZero"),
        ("modular_addition", "modularAddition"),
        ("modular_multiplication", "modularMultiplication"),
        ("modular_subtraction", "modularSubtraction"),
        ("minimum", "minimumLaw"),
        ("maximum", "maximumLaw"),
    )

    blocks = []
    for theorem_suffix, lean_name in references:
        blocks.append(
            f"""theorem alien_not_isomorphic_to_{theorem_suffix} :
    ¬ IsIsomorphic alienLaw {lean_name} := by
  change isomorphicBool alienLaw {lean_name} ≠ true
  decide
"""
        )
    return "\n".join(blocks)


def make_lean_source(
    candidate: StructureCandidate,
    structure_glyph: UnicodeGlyph,
    operation_glyph: UnicodeGlyph,
    symmetry_glyph: UnicodeGlyph,
) -> str:
    operation_definition = lean_operation_definition(candidate.table)
    automorphism = symmetry_permutation()
    symmetry_definition = lean_symmetry_definition(automorphism)
    true_laws = lean_true_law_theorems(candidate.properties)
    nondegeneracy_laws = lean_nondegeneracy_theorems()
    classification_predicates = lean_classification_predicates(candidate.table)
    identity_laws = lean_identity_theorems(candidate.properties)
    counterexamples = lean_counterexample_theorems(
        candidate.table,
        candidate.properties,
    )
    references = reference_definitions()
    relabeling_universe = lean_relabeling_universe()
    noniso = nonisomorphism_theorems()

    true_law_names = [
        key
        for key in LAW_KEYS
        if bool(candidate.properties[key])
    ]
    catalogue_scope = candidate.novelty_label
    catalogue_manifest_hash = hashlib.sha256(
        json.dumps(
            {
                "classifications": candidate.classifications,
                "metrics": candidate.metrics,
                "catalogue_memberships": candidate.catalogue_memberships,
            },
            sort_keys=True,
            separators=(",", ":"),
        ).encode("utf-8")
    ).hexdigest()

    return f"""import Std

namespace HXCNovel

/-!
# HXC AI-Generated Novel Finite Structure

Structure sigil:
* `{structure_glyph.symbol}` ({structure_glyph.codepoint},
  {structure_glyph.name}, category {structure_glyph.category})

Binary operation:
* `{operation_glyph.symbol}` ({operation_glyph.codepoint},
  {operation_glyph.name}, category {operation_glyph.category})

Automorphism:
* `{symmetry_glyph.symbol}` ({symmetry_glyph.codepoint},
  {symmetry_glyph.name}, category {symmetry_glyph.category})

The table was selected from arbitrary finite operation tables after:

* isomorphism-class deduplication;
* complete generated shelf/quandle/quasigroup catalogue rejection;
* two-argument non-degeneracy and entropy gates;
* structural-interest scoring with sample rarity excluded;
* counterexample search;
* nontrivial automorphism enforcement.

The formal novelty claims below are relative to the stated reference library.
-/

def order : Nat := {ORDER}

theorem order_positive :
    0 < order := by
  decide

abbrev Carrier := Fin order

def mkCarrier (value : Nat) : Carrier :=
  ⟨value % order, Nat.mod_lt _ order_positive⟩

{operation_definition}

{symmetry_definition}

/-! ## Discovered positive laws -/

{true_laws}

{identity_laws}

/-! ## Non-degeneracy certificates -/

{nondegeneracy_laws}

/-! ## Variety classification and exclusion -/

{classification_predicates}

/-! ## Nontrivial symmetry -/

theorem symmetry_is_involution :
    ∀ x : Carrier, alienSymmetry (alienSymmetry x) = x := by
  decide

theorem symmetry_is_automorphism :
    ∀ x y : Carrier,
      alienSymmetry (alienLaw x y) =
      alienLaw (alienSymmetry x) (alienSymmetry y) := by
  decide

theorem symmetry_is_nontrivial :
    alienSymmetry (mkCarrier 0) ≠ mkCarrier 0 := by
  decide

/-! ## Falsified conjectures retained as counterexamples -/

{counterexamples}

/-! ## Reference-library non-isomorphism certificates -/

{references}

{relabeling_universe}

{noniso}

/-! ## Proof-carrying structure certificate -/

structure NovelStructureCertificate where
  structureGlyph : String
  operationGlyph : String
  symmetryGlyph : String
  law : Carrier → Carrier → Carrier
  symmetry : Carrier → Carrier
  positiveLawNames : List String
  symmetryInvolution :
    ∀ x, symmetry (symmetry x) = x
  symmetryAutomorphism :
    ∀ x y, symmetry (law x y) = law (symmetry x) (symmetry y)
  symmetryNontrivial :
    symmetry (mkCarrier 0) ≠ mkCarrier 0
