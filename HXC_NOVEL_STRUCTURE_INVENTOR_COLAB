def operation_from_formula(function) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(function(x, y) % ORDER for y in range(ORDER))
        for x in range(ORDER)
    )


def reference_library() -> dict[str, tuple[tuple[int, ...], ...]]:
    references = {
        "left_projection": operation_from_formula(lambda x, y: x),
        "right_projection": operation_from_formula(lambda x, y: y),
        "constant_zero": operation_from_formula(lambda x, y: 0),
        "modular_addition": operation_from_formula(lambda x, y: x + y),
        "modular_multiplication": operation_from_formula(lambda x, y: x * y),
        "modular_subtraction": operation_from_formula(
            lambda x, y: x + ORDER - y
        ),
        "minimum": operation_from_formula(min),
        "maximum": operation_from_formula(max),
    }
    if ORDER & (ORDER - 1) == 0:
        references["bitwise_xor"] = operation_from_formula(lambda x, y: x ^ y)
    return references


PERMUTATIONS = tuple(permutations(range(ORDER)))


def relabel_table(
    table: tuple[tuple[int, ...], ...],
    permutation: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    inverse = [0] * ORDER
    for old, new in enumerate(permutation):
        inverse[new] = old

    return tuple(
        tuple(
            permutation[
                table[inverse[new_x]][inverse[new_y]]
            ]
            for new_y in range(ORDER)
        )
        for new_x in range(ORDER)
    )


def canonical_form(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return min(
        tuple(value for row in relabel_table(table, permutation) for value in row)
        for permutation in PERMUTATIONS
    )



def flatten_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[int, ...]:
    return tuple(value for row in table for value in row)


def unflatten_table(
    values: tuple[int, ...] | list[int],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(values[row * ORDER + column] for column in range(ORDER))
        for row in range(ORDER)
    )


def transpose_table(
    table: tuple[tuple[int, ...], ...],
) -> tuple[tuple[int, ...], ...]:
    return tuple(
        tuple(table[column][row] for column in range(ORDER))
        for row in range(ORDER)
    )


def _iter_domain_bits(bits: int):
    while bits:
        lowest = bits & -bits
        yield lowest.bit_length() - 1
        bits -= lowest


def _singleton_domain_value(bits: int) -> int | None:
    if bits and bits & (bits - 1) == 0:
        return bits.bit_length() - 1
    return None


def enumerate_right_shelves_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled right shelf for ORDER <= 4.

    Writing R_y(x) = x*y, right self-distributivity becomes

        R_z ∘ R_y = R_{R_z(y)} ∘ R_z.

    The enumerator treats the columns as unary maps and applies finite-domain
    propagation before branching. At order 4 it returns 14,067 labelled
    shelves, which collapse to 720 isomorphism classes.
    """

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete shelf enumeration is supported only through order 4."
        )

    from itertools import product as cartesian_product

    functions = list(cartesian_product(range(ORDER), repeat=ORDER))
    function_index = {
        function: index
        for index, function in enumerate(functions)
    }
    function_count = len(functions)

    composition = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    for outer_index, outer in enumerate(functions):
        for inner_index, inner in enumerate(functions):
            composition[outer_index][inner_index] = function_index[
                tuple(outer[inner[x]] for x in range(ORDER))
            ]

    supports_right = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]
    supports_left = [
        [0 for _ in range(function_count)]
        for _ in range(function_count)
    ]

    for z_function in range(function_count):
        right_groups: dict[int, int] = {}
        left_groups: dict[int, int] = {}

        for candidate_k in range(function_count):
            result = composition[candidate_k][z_function]
            right_groups[result] = (
                right_groups.get(result, 0) | (1 << candidate_k)
            )

        for candidate_y in range(function_count):
            result = composition[z_function][candidate_y]
            left_groups[result] = (
                left_groups.get(result, 0) | (1 << candidate_y)
            )

        for candidate_y in range(function_count):
            supports_right[z_function][candidate_y] = right_groups.get(
                composition[z_function][candidate_y],
                0,
            )

        for candidate_k in range(function_count):
            supports_left[z_function][candidate_k] = left_groups.get(
                composition[candidate_k][z_function],
                0,
            )

    full_domain = (1 << function_count) - 1
    solutions: list[tuple[tuple[int, ...], ...]] = []

    def propagate(domains: tuple[int, ...]) -> tuple[int, ...] | None:
        current = list(domains)
        changed = True

        while changed:
            changed = False

            for z_index, z_domain in enumerate(current):
                z_function = _singleton_domain_value(z_domain)
                if z_function is None:
                    continue

                z_map = functions[z_function]

                for y_index in range(ORDER):
                    k_index = z_map[y_index]
                    y_domain = current[y_index]
                    k_domain = current[k_index]

                    if y_index == k_index:
                        filtered = 0
                        for candidate in _iter_domain_bits(y_domain):
                            if (
                                supports_right[z_function][candidate]
                                >> candidate
                            ) & 1:
                                filtered |= 1 << candidate

                        if filtered == 0:
                            return None
                        if filtered != y_domain:
                            current[y_index] = filtered
                            changed = True
                        continue

                    filtered_y = 0
                    for candidate_y in _iter_domain_bits(y_domain):
                        if (
                            supports_right[z_function][candidate_y]
                            & k_domain
                        ):
                            filtered_y |= 1 << candidate_y

                    if filtered_y == 0:
                        return None

                    filtered_k = 0
                    for candidate_k in _iter_domain_bits(k_domain):
                        if (
                            supports_left[z_function][candidate_k]
                            & filtered_y
                        ):
                            filtered_k |= 1 << candidate_k

                    if filtered_k == 0:
                        return None

                    if filtered_y != y_domain:
                        current[y_index] = filtered_y
                        changed = True
                    if filtered_k != k_domain:
                        current[k_index] = filtered_k
                        changed = True

        return tuple(current)

    def search(domains: tuple[int, ...]) -> None:
        reduced = propagate(domains)
        if reduced is None:
            return

        assigned = [
            _singleton_domain_value(domain)
            for domain in reduced
        ]

        if all(value is not None for value in assigned):
            column_functions = [
                functions[int(value)]
                for value in assigned
            ]
            table = tuple(
                tuple(
                    column_functions[column][row]
                    for column in range(ORDER)
                )
                for row in range(ORDER)
            )
            solutions.append(table)
            return

        branch_index = min(
            (
                index
                for index, domain in enumerate(reduced)
                if _singleton_domain_value(domain) is None
            ),
            key=lambda index: reduced[index].bit_count(),
        )

        for candidate in _iter_domain_bits(reduced[branch_index]):
            branch = list(reduced)
            branch[branch_index] = 1 << candidate
            search(tuple(branch))

    search(tuple(full_domain for _ in range(ORDER)))
    return solutions


def enumerate_quasigroups_complete() -> list[tuple[tuple[int, ...], ...]]:
    """Enumerate every labelled quasigroup table for ORDER <= 4."""

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        raise RuntimeError(
            "Complete quasigroup enumeration is supported only through order 4."
        )

    row_permutations = tuple(permutations(range(ORDER)))
    results: list[tuple[tuple[int, ...], ...]] = []

    def search_rows(
        selected: list[tuple[int, ...]],
    ) -> None:
        if len(selected) == ORDER:
            results.append(tuple(selected))
            return

        for row in row_permutations:
            if any(
                row[column] in {
                    existing[column]
                    for existing in selected
                }
                for column in range(ORDER)
            ):
                continue
            selected.append(row)
            search_rows(selected)
            selected.pop()

    search_rows([])
    return results


def right_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len({table[x][y] for x in range(ORDER)}) == ORDER
        for y in range(ORDER)
    )


def left_translations_bijective(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        len(set(table[x])) == ORDER
        for x in range(ORDER)
    )


def right_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[table[x][y]][y] == x
        for x in range(ORDER)
        for y in range(ORDER)
    )


def left_involutory(
    table: tuple[tuple[int, ...], ...],
) -> bool:
    return all(
        table[x][table[x][y]] == y
        for x in range(ORDER)
        for y in range(ORDER)
    )


def catalogue_sha256(
    catalogue: set[tuple[int, ...]],
) -> str:
    payload = json.dumps(
        [list(entry) for entry in sorted(catalogue)],
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def build_complete_catalogues() -> tuple[
    dict[str, set[tuple[int, ...]]],
    dict[str, object],
]:
    """Build or load complete order-3/4 shelf and quasigroup catalogues."""

    reference_classes = {
        canonical_form(table)
        for table in reference_library().values()
    }

    if ORDER > COMPLETE_CATALOGUE_MAX_ORDER:
        catalogues = {
            "core_references": reference_classes,
        }
        metadata = {
            "complete": False,
            "order": ORDER,
            "scope": (
                "Core references only. Complete shelf/quasigroup catalogue "
                "generation is limited to order <= 4."
            ),
            "counts": {
                name: len(values)
                for name, values in catalogues.items()
            },
            "hashes": {
                name: catalogue_sha256(values)
                for name, values in catalogues.items()
            },
        }
        return catalogues, metadata

    CATALOGUE_CACHE.mkdir(parents=True, exist_ok=True)
    cache_path = CATALOGUE_CACHE / (
        f"hxc_catalogues_v{CATALOGUE_VERSION}_order_{ORDER}.json"
    )

    if cache_path.exists():
        document = json.loads(cache_path.read_text(encoding="utf-8"))
        if (
            document.get("version") == CATALOGUE_VERSION
            and document.get("order") == ORDER
        ):
            catalogues = {
                name: {
                    tuple(int(value) for value in entry)
                    for entry in entries
                }
                for name, entries in document["catalogues"].items()
            }
            return catalogues, document["metadata"]

    labelled_right_shelves = enumerate_right_shelves_complete()

    right_shelves: set[tuple[int, ...]] = set()
    right_spindles: set[tuple[int, ...]] = set()
    right_racks: set[tuple[int, ...]] = set()
    right_quandles: set[tuple[int, ...]] = set()
    right_kei: set[tuple[int, ...]] = set()

    for table in labelled_right_shelves:
        canonical = canonical_form(table)
        right_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = right_translations_bijective(table)

        if idempotent:
            right_spindles.add(canonical)
        if translations_bijective:
            right_racks.add(canonical)
        if idempotent and translations_bijective:
            right_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and right_involutory(table)
        ):
            right_kei.add(canonical)

    labelled_left_shelves = [
        transpose_table(table)
        for table in labelled_right_shelves
    ]

    left_shelves: set[tuple[int, ...]] = set()
    left_spindles: set[tuple[int, ...]] = set()
    left_racks: set[tuple[int, ...]] = set()
    left_quandles: set[tuple[int, ...]] = set()
    left_kei: set[tuple[int, ...]] = set()

    for table in labelled_left_shelves:
        canonical = canonical_form(table)
        left_shelves.add(canonical)

        idempotent = all(
            table[x][x] == x
            for x in range(ORDER)
        )
        translations_bijective = left_translations_bijective(table)

        if idempotent:
            left_spindles.add(canonical)
        if translations_bijective:
            left_racks.add(canonical)
        if idempotent and translations_bijective:
            left_quandles.add(canonical)
        if (
            idempotent
            and translations_bijective
            and left_involutory(table)
        ):
            left_kei.add(canonical)

    quasigroups = {
        canonical_form(table)
        for table in enumerate_quasigroups_complete()
    }

    catalogues = {
        "core_references": reference_classes,
        "right_shelves": right_shelves,
        "left_shelves": left_shelves,
        "right_spindles": right_spindles,
        "left_spindles": left_spindles,
        "right_racks": right_racks,
        "left_racks": left_racks,
        "right_quandles": right_quandles,
        "left_quandles": left_quandles,
        "right_kei": right_kei,
        "left_kei": left_kei,
        "quasigroups": quasigroups,
    }

    metadata = {
        "complete": True,
        "order": ORDER,
        "scope": (
            "Complete up-to-isomorphism catalogues generated in this run for "
            "left/right shelves, spindles, racks, quandles, kei and "
            "quasigroups on the selected carrier order."
        ),
        "labelled_right_shelves": len(labelled_right_shelves),
        "labelled_quasigroups": len(enumerate_quasigroups_complete()),
        "counts": {
            name: len(values)
            for name, values in catalogues.items()
        },
        "hashes": {
            name: catalogue_sha256(values)
            for name, values in catalogues.items()
        },
    }

    cache_document = {
        "version": CATALOGUE_VERSION,
        "order": ORDER,
        "metadata": metadata,
        "catalogues": {
            name: [
                list(entry)
                for entry in sorted(values)
            ]
            for name, values in catalogues.items()
        },
    }
    cache_path.write_text(
        json.dumps(cache_document, indent=2) + "\n",
        encoding="utf-8",
    )

    return catalogues, metadata


def symmetry_permutation() -> tuple[int, ...]:
    # A nontrivial involution. It swaps 0 and 1 and fixes all other elements.
    return tuple([1, 0] + list(range(2, ORDER)))


def generate_equivariant_table(
    rng: random.Random,
    automorphism: tuple[int, ...],
) -> tuple[tuple[int, ...], ...]:
    """Generate an arbitrary table that is equivariant under an involution."""

    table = [[-1 for _ in range(ORDER)] for _ in range(ORDER)]
    fixed_outputs = [
        value
        for value in range(ORDER)
        if automorphism[value] == value
    ]

    # ORDER=3 still has one fixed output; ORDER>=4 has at least two.
    if not fixed_outputs:
        raise RuntimeError("Chosen automorphism has no fixed outputs.")

    for x in range(ORDER):
        for y in range(ORDER):
            if table[x][y] != -1:
                continue

            tx = automorphism[x]
            ty = automorphism[y]

            if (tx, ty) == (x, y):
                value = rng.choice(fixed_outputs)
                table[x][y] = value
            else:
                value = rng.randrange(ORDER)
                table[x][y] = value
                table[tx][ty] = automorphism[value]

    return tuple(tuple(row) for row in table)


