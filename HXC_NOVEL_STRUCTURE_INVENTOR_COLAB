  notModularAddition :
    ¬ IsIsomorphic law modularAddition
  notModularMultiplication :
    ¬ IsIsomorphic law modularMultiplication
  notModularSubtraction :
    ¬ IsIsomorphic law modularSubtraction
  notMinimum :
