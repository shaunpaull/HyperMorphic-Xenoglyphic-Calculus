                ],
            },
            ensure_ascii=False,
            indent=2,
        ) + "\n"

    banner("HXC STRENGTHENED STRUCTURE PROJECT")
    for relative, content in files.items():
        path = ROOT / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        raw = content.encode("utf-8")
        print(
            f"{relative:<30} bytes={len(raw):>9} "
            f"lines={content.count(chr(10)):>5} "
            f"sha256={hashlib.sha256(raw).hexdigest()}",
            flush=True,
        )


def audit() -> None:
    source = (ROOT / "HXCNovel.lean").read_text(encoding="utf-8")
    patterns = (
        re.compile(r"\bsorry\b"),
        re.compile(r"\badmit\b"),
        re.compile(r"^\s*axiom\b", re.MULTILINE),
        re.compile(r"\bunsafe\b"),
    )
    violations = []
    for pattern in patterns:
        match = pattern.search(source)
        if match is not None:
            violations.append(match.group(0))

    if violations:
        raise RuntimeError(
            "Proof-placeholder audit failed: " + ", ".join(violations)
        )

    banner("PROOF-PLACEHOLDER AUDIT: PASSED")
    print(
        "No proof placeholders, local axioms, or unsafe declarations detected.",
        flush=True,
    )


# ---------------------------------------------------------------------------
# Lean installation and build
# ---------------------------------------------------------------------------

def lean_environment() -> dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = (
        str(Path.home() / ".elan" / "bin")
        + os.pathsep
        + env.get("PATH", "")
    )
    env["PYTHONUTF8"] = "1"
    return env


def install_or_reuse_lean() -> dict[str, str]:
    env = lean_environment()

    run(["apt-get", "update", "-qq"], env=env)
    run(
        [
            "apt-get",
            "install",
            "-y",
            "-qq",
            "ca-certificates",
            "curl",
            "git",
            "zstd",
        ],
        env=env,
    )

    if shutil.which("elan", path=env["PATH"]) is None:
        installer = Path("/tmp/elan-init.sh")
        run(
            [
                "curl",
                "-sSf",
                "https://elan.lean-lang.org/elan-init.sh",
                "-o",
                str(installer),
            ],
            env=env,
        )
        run(
            ["sh", str(installer), "-y", "--default-toolchain", "none"],
            env=env,
        )

    run(["elan", "--version"], env=env)
    run(
        ["elan", "toolchain", "install", TOOLCHAIN],
        env=env,
        accepted_failure_text=("already installed", "is already installed"),
    )

    env["ELAN_TOOLCHAIN"] = TOOLCHAIN
    run(["elan", "toolchain", "list"], env=env)
    run(["lean", "--version"], env=env)
    run(["lake", "--version"], env=env)
    return env


def build(env: dict[str, str]) -> None:
    stale = ROOT / ".lake"
    if stale.exists():
        shutil.rmtree(stale)

    run(["lean", "--run", "StdPreflight.lean"], cwd=ROOT, env=env)
    run(["lake", "env", "lean", "HXCNovel.lean"], cwd=ROOT, env=env)
    run(["lake", "build"], cwd=ROOT, env=env)


