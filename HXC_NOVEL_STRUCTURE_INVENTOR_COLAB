def lean_operation_definition(
    table: tuple[tuple[int, ...], ...],
) -> str:
    def row_expression(x: int) -> str:
        parts: list[str] = []
        for y in range(ORDER - 1):
            parts.append(
                f"if y.val = {y} then mkCarrier {table[x][y]} else "
            )
        parts.append(f"mkCarrier {table[x][ORDER - 1]}")
        return "".join(parts)

    lines = [
        "def alienLaw (x y : Carrier) : Carrier :=",
    ]
    for x in range(ORDER - 1):
        lines.append(
            f"  if x.val = {x} then {row_expression(x)}"
        )
        lines.append("  else")
    lines.append(f"    {row_expression(ORDER - 1)}")
    return "\n".join(lines)


def lean_symmetry_definition(
    automorphism: tuple[int, ...],
) -> str:
    lines = ["def alienSymmetry (x : Carrier) : Carrier :="]
    for x in range(ORDER - 1):
        lines.append(
            f"  if x.val = {x} then mkCarrier {automorphism[x]}"
        )
        lines.append("  else")
    lines.append(f"    mkCarrier {automorphism[ORDER - 1]}")
    return "\n".join(lines)


def lean_true_law_theorems(properties: dict[str, object]) -> str:
    theorem_templates = {
        "commutative": """theorem alien_commutative :
    ∀ x y : Carrier, alienLaw x y = alienLaw y x := by
  decide
""",
        "associative": """theorem alien_associative :
    ∀ x y z : Carrier,
      alienLaw (alienLaw x y) z = alienLaw x (alienLaw y z) := by
  decide
""",
        "idempotent": """theorem alien_idempotent :
    ∀ x : Carrier, alienLaw x x = x := by
  decide
""",
        "flexible": """theorem alien_flexible :
    ∀ x y : Carrier,
      alienLaw x (alienLaw y x) = alienLaw (alienLaw x y) x := by
  decide
""",
        "left_alternative": """theorem alien_left_alternative :
    ∀ x y : Carrier,
      alienLaw x (alienLaw x y) = alienLaw (alienLaw x x) y := by
  decide
""",
        "right_alternative": """theorem alien_right_alternative :
    ∀ x y : Carrier,
      alienLaw (alienLaw x y) y = alienLaw x (alienLaw y y) := by
  decide
""",
        "medial": """theorem alien_medial :
    ∀ x y z w : Carrier,
      alienLaw (alienLaw x y) (alienLaw z w) =
      alienLaw (alienLaw x z) (alienLaw y w) := by
  decide
""",
        "left_self_distributive": """theorem alien_left_self_distributive :
    ∀ x y z : Carrier,
      alienLaw x (alienLaw y z) =
      alienLaw (alienLaw x y) (alienLaw x z) := by
  decide
""",
        "right_self_distributive": """theorem alien_right_self_distributive :
    ∀ x y z : Carrier,
      alienLaw (alienLaw x y) z =
      alienLaw (alienLaw x z) (alienLaw y z) := by
  decide
""",
        "latin": """theorem alien_latin :
    (∀ x a : Carrier, ∃! y : Carrier, alienLaw x y = a) ∧
    (∀ y a : Carrier, ∃! x : Carrier, alienLaw x y = a) := by
  decide
""",
        "surjective": """theorem alien_surjective :
    ∀ target : Carrier, ∃ x y : Carrier, alienLaw x y = target := by
  decide
""",
    }

    selected = [
        theorem_templates[key]
        for key in LAW_KEYS
        if bool(properties[key])
    ]
    return "\n".join(selected)



def lean_nondegeneracy_theorems() -> str:
    return """theorem every_row_depends_on_right_argument :
    ∀ x : Carrier,
      ∃ y z : Carrier, alienLaw x y ≠ alienLaw x z := by
  decide

theorem every_column_depends_on_left_argument :
    ∀ y : Carrier,
      ∃ x z : Carrier, alienLaw x y ≠ alienLaw z y := by
  decide

theorem rows_are_pairwise_distinct :
    ∀ x z : Carrier,
      x ≠ z →
      ∃ y : Carrier, alienLaw x y ≠ alienLaw z y := by
  decide

theorem columns_are_pairwise_distinct :
    ∀ y w : Carrier,
      y ≠ w →
      ∃ x : Carrier, alienLaw x y ≠ alienLaw x w := by
  decide

theorem alien_not_left_projection :
    ∃ x y : Carrier, alienLaw x y ≠ x := by
  decide

theorem alien_not_right_projection :
    ∃ x y : Carrier, alienLaw x y ≠ y := by
  decide
"""


def lean_classification_predicates(
    table: tuple[tuple[int, ...], ...],
) -> str:
    """Generate class predicates and explicit finite exclusion proofs.

    We intentionally avoid `∃!` notation and avoid asking `decide` to infer
    decidability for large quantified function propositions.  Instead, Python
    supplies concrete counterexample indices and Lean kernel-checks the exact
    equalities and inequalities.
    """

    left_sd_witness: tuple[int, int, int] | None = None
    right_sd_witness: tuple[int, int, int] | None = None

    for x in range(ORDER):
        for y in range(ORDER):
            for z in range(ORDER):
                if (
                    table[x][table[y][z]]
                    != table[table[x][y]][table[x][z]]
                    and left_sd_witness is None
                ):
                    left_sd_witness = (x, y, z)

                if (
                    table[table[x][y]][z]
                    != table[table[x][z]][table[y][z]]
                    and right_sd_witness is None
                ):
                    right_sd_witness = (x, y, z)

    if left_sd_witness is None:
        raise RuntimeError(
            "Selected candidate unexpectedly satisfies the left-shelf law."
        )
    if right_sd_witness is None:
        raise RuntimeError(
            "Selected candidate unexpectedly satisfies the right-shelf law."
        )

    quasigroup_witness: tuple[str, int, int, int] | None = None

    # A finite translation is non-bijective exactly when two distinct inputs
    # collide.  Prefer a row collision, then fall back to a column collision.
    for x in range(ORDER):
        for y in range(ORDER):
            for z in range(y + 1, ORDER):
                if table[x][y] == table[x][z]:
                    quasigroup_witness = ("row", x, y, z)
                    break
            if quasigroup_witness is not None:
                break
        if quasigroup_witness is not None:
            break

    if quasigroup_witness is None:
        for y in range(ORDER):
            for x in range(ORDER):
                for z in range(x + 1, ORDER):
                    if table[x][y] == table[z][y]:
                        quasigroup_witness = ("column", y, x, z)
                        break
                if quasigroup_witness is not None:
                    break
            if quasigroup_witness is not None:
                break

    if quasigroup_witness is None:
        raise RuntimeError(
            "Selected candidate unexpectedly has bijective translations."
        )

    lx, ly, lz = left_sd_witness
    rx, ry, rz = right_sd_witness

    if quasigroup_witness[0] == "row":
        _, qx, qy, qz = quasigroup_witness
        quasigroup_proof = f"""theorem alien_not_quasigroup :
    ¬ IsQuasigroup alienLaw := by
  intro h
  have sameOutput :
      alienLaw (mkCarrier {qx}) (mkCarrier {qy}) =
      alienLaw (mkCarrier {qx}) (mkCarrier {qz}) := by
    decide
  have equalInputs :
      mkCarrier {qy} = mkCarrier {qz} :=
    h.1.1
      (mkCarrier {qx})
      (mkCarrier {qy})
      (mkCarrier {qz})
      sameOutput
  have differentInputs :
      mkCarrier {qy} ≠ mkCarrier {qz} := by
    decide
  exact differentInputs equalInputs
"""
    else:
        _, qy, qx, qz = quasigroup_witness
        quasigroup_proof = f"""theorem alien_not_quasigroup :
    ¬ IsQuasigroup alienLaw := by
  intro h
  have sameOutput :
      alienLaw (mkCarrier {qx}) (mkCarrier {qy}) =
      alienLaw (mkCarrier {qz}) (mkCarrier {qy}) := by
    decide
  have equalInputs :
      mkCarrier {qx} = mkCarrier {qz} :=
    h.2.1
      (mkCarrier {qy})
      (mkCarrier {qx})
      (mkCarrier {qz})
      sameOutput
  have differentInputs :
      mkCarrier {qx} ≠ mkCarrier {qz} := by
    decide
  exact differentInputs equalInputs
"""

    return f"""def IsLeftShelf
    (law : Carrier → Carrier → Carrier) : Prop :=
  ∀ x y z,
    law x (law y z) =
    law (law x y) (law x z)

def IsRightShelf
    (law : Carrier → Carrier → Carrier) : Prop :=
  ∀ x y z,
    law (law x y) z =
    law (law x z) (law y z)

def IsIdempotent
    (law : Carrier → Carrier → Carrier) : Prop :=
  ∀ x, law x x = x

def LeftTranslationsBijective
    (law : Carrier → Carrier → Carrier) : Prop :=
  (∀ x y z, law x y = law x z → y = z) ∧
  (∀ x target, ∃ y, law x y = target)

def RightTranslationsBijective
    (law : Carrier → Carrier → Carrier) : Prop :=
  (∀ y x z, law x y = law z y → x = z) ∧
  (∀ y target, ∃ x, law x y = target)

def IsLeftSpindle
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsLeftShelf law ∧ IsIdempotent law

def IsRightSpindle
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsRightShelf law ∧ IsIdempotent law

def IsLeftRack
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsLeftShelf law ∧ LeftTranslationsBijective law

def IsRightRack
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsRightShelf law ∧ RightTranslationsBijective law

def IsLeftQuandle
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsLeftRack law ∧ IsIdempotent law

def IsRightQuandle
    (law : Carrier → Carrier → Carrier) : Prop :=
  IsRightRack law ∧ IsIdempotent law

def IsQuasigroup
    (law : Carrier → Carrier → Carrier) : Prop :=
  LeftTranslationsBijective law ∧
  RightTranslationsBijective law

theorem alien_not_left_shelf :
    ¬ IsLeftShelf alienLaw := by
  intro h
  have claimed :=
    h
      (mkCarrier {lx})
      (mkCarrier {ly})
      (mkCarrier {lz})
  have counterexample :
      alienLaw
        (mkCarrier {lx})
        (alienLaw (mkCarrier {ly}) (mkCarrier {lz})) ≠
      alienLaw
        (alienLaw (mkCarrier {lx}) (mkCarrier {ly}))
        (alienLaw (mkCarrier {lx}) (mkCarrier {lz})) := by
    decide
  exact counterexample claimed

theorem alien_not_right_shelf :
    ¬ IsRightShelf alienLaw := by
  intro h
  have claimed :=
    h
      (mkCarrier {rx})
      (mkCarrier {ry})
      (mkCarrier {rz})
  have counterexample :
      alienLaw
        (alienLaw (mkCarrier {rx}) (mkCarrier {ry}))
        (mkCarrier {rz}) ≠
      alienLaw
        (alienLaw (mkCarrier {rx}) (mkCarrier {rz}))
        (alienLaw (mkCarrier {ry}) (mkCarrier {rz})) := by
    decide
  exact counterexample claimed

theorem alien_not_left_spindle :
    ¬ IsLeftSpindle alienLaw := by
  intro h
  exact alien_not_left_shelf h.1

theorem alien_not_right_spindle :
    ¬ IsRightSpindle alienLaw := by
  intro h
  exact alien_not_right_shelf h.1

theorem alien_not_left_rack :
