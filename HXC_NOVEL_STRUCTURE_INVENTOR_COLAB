def write_project(
    candidate: StructureCandidate,
    statistics: dict[str, int],
    unicode_pool: list[UnicodeGlyph],
    structure_glyph: UnicodeGlyph,
    operation_glyph: UnicodeGlyph,
    symmetry_glyph: UnicodeGlyph,
) -> None:
    if ROOT.exists():
        shutil.rmtree(ROOT)
    ROOT.mkdir(parents=True)

    lean = make_lean_source(
        candidate,
        structure_glyph,
        operation_glyph,
        symmetry_glyph,
    )
    report = build_report(
        candidate,
        statistics,
        structure_glyph,
        operation_glyph,
        symmetry_glyph,
    )

    lakefile = """name = "hxc-novel-structure-inventor"
version = "2.1.0"
defaultTargets = ["HXCNovel"]

[[lean_lib]]
name = "HXCNovel"
roots = ["HXCNovel"]
"""

    assigned = {
        structure_glyph.symbol: "structure",
        operation_glyph.symbol: "binary_operation",
        symmetry_glyph.symbol: "automorphism",
    }

    unicode_registry = {
        "unicode_database_version": unicodedata.unidata_version,
        "code_points_scanned": sys.maxunicode + 1,
        "accepted_symbols": len(unicode_pool),
        "glyphs": [
            {
                **asdict(glyph),
                "assigned": glyph.symbol in assigned,
                "role": assigned.get(glyph.symbol),
            }
            for glyph in unicode_pool
        ],
    }

    record = {
        "order": ORDER,
        "seed": SEED,
        "samples": SAMPLES,
        "glyphs": {
            "structure": asdict(structure_glyph),
            "operation": asdict(operation_glyph),
            "symmetry": asdict(symmetry_glyph),
        },
        "search_statistics": statistics,
        "candidate": {
            "table": candidate.table,
            "canonical_form": candidate.canonical,
            "properties": candidate.properties,
            "fingerprint": candidate.fingerprint,
            "entropy": candidate.entropy,
            "interesting_law_count": candidate.interesting_law_count,
            "sample_index": candidate.sample_index,
            "score": candidate.score,
            "fingerprint_frequency": candidate.fingerprint_frequency,
        },
        "reference_library": list(reference_library()),
    }

    files = {
        "HXCNovel.lean": lean,
        "StdPreflight.lean": (
            'import Std\n\n'
            'def main : IO Unit :=\n'
            '  IO.println "Std preflight: PASSED"\n'
        ),
        "lakefile.toml": lakefile,
        "lean-toolchain": TOOLCHAIN + "\n",
        "NOVEL_STRUCTURE_REPORT.md": report,
        "novel_structure.json": json.dumps(
            record,
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        "unicode_glyph_registry.json": json.dumps(
            unicode_registry,
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
    }

    banner("HXC NOVEL-STRUCTURE PROJECT")
    for relative, content in files.items():
        path = ROOT / relative
        path.write_text(content, encoding="utf-8")
        raw = content.encode("utf-8")
        print(
            f"{relative:<30} bytes={len(raw):>9} "
            f"lines={content.count(chr(10)):>5} "
            f"sha256={hashlib.sha256(raw).hexdigest()}",
            flush=True,
        )


def audit() -> None:
    source = (ROOT / "HXCNovel.lean").read_text(encoding="utf-8")
    patterns = (
        re.compile(r"\bsorry\b"),
        re.compile(r"\badmit\b"),
        re.compile(r"^\s*axiom\b", re.MULTILINE),
        re.compile(r"\bunsafe\b"),
    )
    violations = []
    for pattern in patterns:
        match = pattern.search(source)
        if match is not None:
            violations.append(match.group(0))

    if violations:
        raise RuntimeError(
            "Proof-placeholder audit failed: " + ", ".join(violations)
        )

    banner("PROOF-PLACEHOLDER AUDIT: PASSED")
    print(
        "No proof placeholders, local axioms, or unsafe declarations detected.",
        flush=True,
    )


